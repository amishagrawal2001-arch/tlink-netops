.mapper-overlay((click)='close()')
  .mapper-dialog((click)='$event.stopPropagation()')
    .mapper-header
      h3.mapper-title Device Mapper
      span.mapper-subtitle Map topology nodes to physical devices
      button.mapper-close(type='button', (click)='close()') ✕

    //- Tab bar
    .mapper-tabs
      button.mapper-tab(
        type='button',
        [class.active]='activeTab === "inventory"',
        (click)='activeTab = "inventory"; cdr.markForCheck()'
      ) Device Inventory ({{ discoveredDevices.length }})
      button.mapper-tab(
        type='button',
        [class.active]='activeTab === "mapping"',
        (click)='activeTab = "mapping"; cdr.markForCheck()'
      ) Mapping ({{ mappings.size }}/{{ topologyNodes.length }})

    .mapper-actions-bar
      button.mapper-btn.mapper-btn-discover(
        type='button',
        [disabled]='discovering',
        (click)='startDiscovery()'
      ) {{ discovering ? 'Discovering...' : '🔍 Discover Network' }}
      button.mapper-btn(
        type='button',
        (click)='fileInput.click()'
      ) 📁 Upload CSV/JSON
      input.mapper-file-input(
        #fileInput='',
        type='file',
        accept='.csv,.json,.txt',
        (change)='onFileUpload($event)',
        style='display:none'
      )
      button.mapper-btn(
        type='button',
        (click)='addManualDevice()'
      ) + Add Device
      button.mapper-btn.mapper-btn-auto(
        type='button',
        [disabled]='!discoveredDevices.length',
        (click)='autoMatch(); activeTab = "mapping"; cdr.markForCheck()'
      ) ⚡ Auto-Match
      span.mapper-status(*ngIf='discoveredDevices.length') {{ discoveredDevices.length }} devices

    //- ── Inventory Tab ──────────────────────────────────────────────
    .mapper-table-wrap(*ngIf='activeTab === "inventory"')
      .mapper-empty(*ngIf='!discoveredDevices.length')
        p No devices in inventory. Use the buttons above to:
        ul
          li 🔍 Discover Network — auto-discover via LLDP/SSH
          li 📁 Upload CSV/JSON — import from file
          li + Add Device — enter manually

      table.mapper-table(*ngIf='discoveredDevices.length')
        thead
          tr
            th #
            th Hostname
            th IP Address
            th Vendor
            th Model
            th Actions
        tbody
          tr.mapper-row(*ngFor='let dev of discoveredDevices; let i = index')
            td {{ i + 1 }}
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.hostname',
                (change)='saveDeviceEdit(i, "hostname", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.mgmtIp',
                (change)='saveDeviceEdit(i, "mgmtIp", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.vendor',
                (change)='saveDeviceEdit(i, "vendor", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.model',
                (change)='saveDeviceEdit(i, "model", $event)'
              )
            td
              button.mapper-remove-btn(type='button', title='Remove', (click)='removeDevice(i)') ✕

    //- ── Mapping Tab ────────────────────────────────────────────────
    .mapper-table-wrap(*ngIf='activeTab === "mapping"')
      table.mapper-table
        thead
          tr
            th Topology Node
            th Vendor / Model
            th Role
            th ➜
            th Physical Device
            th IP Address
            th Status
        tbody
          tr.mapper-row(
            *ngFor='let node of topologyNodes',
            [class.mapped]='mappings.has(node.id)'
          )
            td.mapper-cell-name {{ node.label }}
            td {{ node.vendor || '—' }} {{ node.model ? '/ ' + node.model : '' }}
            td {{ node.role || node.type }}
            td.mapper-cell-arrow {{ mappings.has(node.id) ? '✓' : '→' }}
            td
              select.mapper-select(
                [value]='mappings.get(node.id)?.hostname || ""',
                (change)='onMapChange(node.id, $event)'
              )
                option(value='') — Select device —
                option(
                  *ngFor='let dev of discoveredDevices',
                  [value]='dev.hostname'
                ) {{ dev.hostname }} ({{ dev.vendor }})
            td {{ mappings.get(node.id)?.mgmtIp || '—' }}
            td
              span.mapper-status-dot([class.mapped]='mappings.has(node.id)')
              | {{ mappings.has(node.id) ? 'Mapped' : 'Unmapped' }}

    .mapper-footer
      span.mapper-summary(*ngIf='activeTab === "inventory"') {{ discoveredDevices.length }} devices in inventory
      span.mapper-summary(*ngIf='activeTab === "mapping"') {{ mappings.size }}/{{ topologyNodes.length }} nodes mapped
      .mapper-footer-actions
        button.mapper-btn(*ngIf='activeTab === "inventory" && discoveredDevices.length', (click)='clearAllDevices()') Clear All
        button.mapper-btn(type='button', (click)='close()') Cancel
        button.mapper-btn.mapper-btn-apply(
          *ngIf='activeTab === "mapping"',
          type='button',
          [disabled]='!mappings.size',
          (click)='applyMapping()'
        ) Apply Mapping & Push Configs
