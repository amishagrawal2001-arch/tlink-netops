.mapper-overlay((click)='close()')
  .mapper-dialog((click)='$event.stopPropagation()')
    .mapper-header
      h3.mapper-title Device Mapper
      span.mapper-subtitle Map topology nodes to physical devices
      button.mapper-close(type='button', (click)='close()') ✕

    //- Tab bar
    .mapper-tabs
      button.mapper-tab(
        type='button',
        [class.active]='activeTab === "inventory"',
        (click)='activeTab = "inventory"; cdr.markForCheck()'
      ) Device Inventory ({{ discoveredDevices.length }})
      button.mapper-tab(
        type='button',
        [class.active]='activeTab === "mapping"',
        (click)='activeTab = "mapping"; cdr.markForCheck()'
      ) Mapping ({{ mappings.size }}/{{ topologyNodes.length }})

    .mapper-actions-bar
      button.mapper-btn.mapper-btn-discover(
        type='button',
        [disabled]='discovering',
        (click)='startDiscovery()'
      ) {{ discovering ? 'Discovering...' : '🔍 Discover' }}
      button.mapper-btn(
        type='button',
        (click)='fileInput.click()'
      ) 📁 Upload CSV/JSON
      input.mapper-file-input(
        #fileInput='',
        type='file',
        accept='.csv,.json,.txt',
        (change)='onFileUpload($event)',
        style='display:none'
      )
      button.mapper-btn(
        type='button',
        (click)='addManualDevice()'
      ) + Add Device
      button.mapper-btn.mapper-btn-auto(
        type='button',
        [disabled]='!discoveredDevices.length',
        (click)='autoMatch(); activeTab = "mapping"; cdr.markForCheck()'
      ) ⚡ Auto-Match
      span.mapper-status(*ngIf='discoveredDevices.length') {{ discoveredDevices.length }} devices

    //- Discovery form (inline)
    .mapper-inline-form(*ngIf='showDiscoveryForm')
      .mapper-form-row
        label.mapper-form-label Seed IP
        input.mapper-form-input(type='text', [(ngModel)]='discoveryForm.host', placeholder='e.g. 172.16.0.1')
      .mapper-form-row
        label.mapper-form-label Username
        input.mapper-form-input(type='text', [(ngModel)]='discoveryForm.username', placeholder='SSH username')
      .mapper-form-row
        label.mapper-form-label Password
        input.mapper-form-input(type='password', [(ngModel)]='discoveryForm.password', placeholder='SSH password')
      .mapper-form-row
        span.mapper-form-error(*ngIf='discoveryError') {{ discoveryError }}
        button.mapper-btn(type='button', (click)='showDiscoveryForm = false; cdr.markForCheck()') Cancel
        button.mapper-btn.mapper-btn-discover(type='button', (click)='startDiscovery()') Start Discovery

    //- Add device form (inline)
    .mapper-inline-form(*ngIf='showAddForm')
      .mapper-form-row
        label.mapper-form-label Hostname
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.hostname', placeholder='e.g. Spine-1')
      .mapper-form-row
        label.mapper-form-label Mgmt IP / Host
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.mgmtIp', placeholder='IPv4, IPv6, or hostname (e.g. 172.16.0.1, fd00::1, router-1.lab.local)')
      .mapper-form-row
        label.mapper-form-label Vendor
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.vendor', placeholder='e.g. Juniper, Cisco')
      .mapper-form-row
        label.mapper-form-label Model
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.model', placeholder='e.g. QFX5130 (optional)')
      .mapper-form-row
        label.mapper-form-label SSH User
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.sshUsername', placeholder='SSH username (optional)')
      .mapper-form-row
        label.mapper-form-label SSH Pass
        input.mapper-form-input(type='password', [(ngModel)]='newDevice.sshPassword', placeholder='SSH password (optional)')
      .mapper-form-row
        span.mapper-form-error(*ngIf='addError') {{ addError }}
        button.mapper-btn(type='button', (click)='showAddForm = false; cdr.markForCheck()') Cancel
        button.mapper-btn.mapper-btn-apply(type='button', [disabled]='!newDevice.hostname && !newDevice.mgmtIp', (click)='confirmAddDevice()') Add Device

    //- ── Inventory Tab ──────────────────────────────────────────────
    .mapper-table-wrap(*ngIf='activeTab === "inventory"')
      .mapper-empty(*ngIf='!discoveredDevices.length')
        p No devices in inventory. Use the buttons above to:
        ul
          li 🔍 Discover Network — auto-discover via LLDP/SSH
          li 📁 Upload CSV/JSON — import from file
          li + Add Device — enter manually
        p.mapper-sample-hint Or download a sample file to get started:
        .mapper-sample-btns
          button.mapper-btn(type='button', (click)='downloadSampleCsv()') 📄 Sample CSV
          button.mapper-btn(type='button', (click)='downloadSampleJson()') 📋 Sample JSON

      .mapper-search(*ngIf='discoveredDevices.length')
        input.mapper-form-input(
          type='text',
          placeholder='Search by hostname, IP, or vendor...',
          [(ngModel)]='searchQuery',
          (ngModelChange)='cdr.markForCheck()'
        )

      table.mapper-table(*ngIf='discoveredDevices.length')
        thead
          tr
            th #
            th Hostname
            th IP Address
            th Vendor
            th Model
            th SSH User
            th SSH Pass
            th Actions
        tbody
          tr.mapper-row(*ngFor='let dev of filteredDevices; let i = index')
            td {{ i + 1 }}
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.hostname',
                (change)='saveDeviceEdit(i, "hostname", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.mgmtIp',
                (change)='saveDeviceEdit(i, "mgmtIp", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.vendor',
                (change)='saveDeviceEdit(i, "vendor", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.model',
                (change)='saveDeviceEdit(i, "model", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.sshUsername || ""',
                (change)='saveDeviceEdit(i, "sshUsername", $event)'
              )
            td
              input.mapper-inline-edit(
                type='password',
                [value]='dev.sshPassword || ""',
                (change)='saveDeviceEdit(i, "sshPassword", $event)'
              )
            td
              button.mapper-remove-btn(type='button', title='Remove', (click)='removeDevice(i)') ✕

    //- ── Mapping Tab ────────────────────────────────────────────────
    .mapper-table-wrap(*ngIf='activeTab === "mapping"')
      table.mapper-table
        thead
          tr
            th Topology Node
            th Vendor / Model
            th Role
            th ➜
            th Physical Device
            th IP Address
            th Status
        tbody
          tr.mapper-row(
            *ngFor='let node of topologyNodes',
            [class.mapped]='mappings.has(node.id)'
          )
            td.mapper-cell-name {{ node.label }}
            td {{ node.vendor || '—' }} {{ node.model ? '/ ' + node.model : '' }}
            td {{ node.role || node.type }}
            td.mapper-cell-arrow {{ mappings.has(node.id) ? '✓' : '→' }}
            td
              select.mapper-select(
                [value]='mappings.get(node.id)?.hostname || ""',
                (change)='onMapChange(node.id, $event)'
              )
                option(value='') — Select device —
                option(
                  *ngFor='let dev of getAvailableDevices(node.id)',
                  [value]='dev.hostname'
                ) {{ dev.hostname }} ({{ dev.vendor }})
            td {{ mappings.get(node.id)?.mgmtIp || '—' }}
            td
              span.mapper-status-dot([class.mapped]='mappings.has(node.id)')
              | {{ mappings.has(node.id) ? 'Mapped' : 'Unmapped' }}

    .mapper-footer
      span.mapper-summary(*ngIf='activeTab === "inventory"') {{ discoveredDevices.length }} devices in inventory
      span.mapper-summary(*ngIf='activeTab === "mapping"') {{ mappings.size }}/{{ topologyNodes.length }} nodes mapped
      .mapper-footer-actions
        button.mapper-btn(*ngIf='activeTab === "inventory" && discoveredDevices.length', type='button', (click)='exportInventoryCsv()') 📥 Export CSV
        button.mapper-btn(*ngIf='activeTab === "inventory" && discoveredDevices.length && !showClearConfirm', (click)='clearAllDevices()') Clear All
        span.mapper-confirm(*ngIf='showClearConfirm')
          | Are you sure?
          button.mapper-btn(type='button', (click)='confirmClearAll()') Yes, clear
          button.mapper-btn(type='button', (click)='showClearConfirm = false; cdr.markForCheck()') No
        button.mapper-btn(type='button', (click)='close()') Cancel
        button.mapper-btn.mapper-btn-apply(
          *ngIf='activeTab === "mapping"',
          type='button',
          title='Save mappings to topology (SSH creds + mgmt IP + vendor). Does not push configs.',
          [disabled]='!mappings.size',
          (click)='applyMapping()'
        ) Apply Mapping
        button.mapper-btn.mapper-btn-push(
          *ngIf='activeTab === "mapping"',
          type='button',
          title='Apply mapping, then push startup configs to mapped devices via SSH.',
          [disabled]='!mappings.size',
          (click)='applyAndPush()'
        ) Apply &amp; Push Configs
