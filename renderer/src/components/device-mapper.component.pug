.mapper-overlay((click)='close()')
  .mapper-dialog((click)='$event.stopPropagation()')
    .mapper-header
      h3.mapper-title Device Mapper
      span.mapper-subtitle Map topology nodes to physical devices
      button.mapper-close(type='button', (click)='close()') ✕

    //- Tab bar
    .mapper-tabs
      button.mapper-tab(
        type='button',
        [class.active]='activeTab === "inventory"',
        (click)='activeTab = "inventory"; cdr.markForCheck()'
      ) Device Inventory ({{ discoveredDevices.length }})
      button.mapper-tab(
        type='button',
        [class.active]='activeTab === "mapping"',
        (click)='activeTab = "mapping"; cdr.markForCheck()'
      ) Mapping ({{ mappings.size }}/{{ topologyNodes.length }})

    .mapper-actions-bar
      button.mapper-btn.mapper-btn-discover(
        type='button',
        [disabled]='discovering',
        title='Opens a dialog where you pick the discovery mode: BFS from a seed, or closed-inventory (probe only current inventory).',
        (click)='startDiscovery()'
      ) {{ discovering ? 'Discovering...' : '🔍 Discover' }}
      button.mapper-btn(
        *ngIf='discovering',
        type='button',
        title='Stop the running discovery at the next wave boundary (within a few seconds).',
        style='border-color:#ef4444;color:#ef4444',
        (click)='cancelDiscovery()'
      ) ✕ Cancel
      button.mapper-btn(
        type='button',
        (click)='fileInput.click()'
      ) 📁 Upload CSV/JSON
      input.mapper-file-input(
        #fileInput='',
        type='file',
        accept='.csv,.json,.txt',
        (change)='onFileUpload($event)',
        style='display:none'
      )
      button.mapper-btn(
        type='button',
        (click)='addManualDevice()'
      ) + Add Device
      button.mapper-btn.mapper-btn-auto(
        type='button',
        [disabled]='!discoveredDevices.length',
        title='Match every node to its best inventory device. Confirms before overwriting any existing manual mappings.',
        (click)='autoMatch(); activeTab = "mapping"; cdr.markForCheck()'
      ) ⚡ Auto-Match
      button.mapper-btn(
        type='button',
        [disabled]='!discoveredDevices.length',
        title='Auto-match only nodes that are currently unmapped — preserves manually-set mappings.',
        (click)='autoMatchMerge(); activeTab = "mapping"; cdr.markForCheck()'
      ) ⚡+ Match (merge)
      span.mapper-status(*ngIf='discoveredDevices.length')
        | {{ discoveredDevices.length }} device{{ discoveredDevices.length === 1 ? '' : 's' }}
        span(*ngIf='discoveredLinks.length', style='margin-left:6px;color:#60a5fa')
          | · {{ discoveredLinks.length }} LLDP link{{ discoveredLinks.length === 1 ? '' : 's' }}
    //- Discovery summary — shown after a discovery completes.
    .mapper-discovery-summary(*ngIf='lastDiscoverySummary')
      | ✓ {{ lastDiscoverySummary }}
    //- Discovery error / probe-output details — shown if the seed returned
    //- nothing parseable. Sticky so users can copy the preview text.
    .mapper-discovery-error(*ngIf='discoveryError && !showDiscoveryForm')
      pre(style='margin:0;white-space:pre-wrap;font-family:SF Mono,Menlo,monospace;font-size:11px') ⚠ {{ discoveryError }}
      button.mapper-btn(type='button', style='margin-top:6px', (click)='discoveryError = ""; cdr.markForCheck()') Dismiss

    //- Discovery form (inline) — lets the user pick BFS vs inventory-only
    .mapper-inline-form(*ngIf='showDiscoveryForm')
      .mapper-form-row
        label.mapper-form-label Mode
        select.mapper-form-input(
          [(ngModel)]='discoveryMode',
          (ngModelChange)='discoveryError = ""; cdr.markForCheck()',
          title='BFS walks LLDP outward from the seed and discovers new devices. Inventory-only probes the current inventory list and keeps only links where both endpoints are in inventory.',
        )
          option(value='bfs') BFS from seed (expand inventory)
          option(value='inventory', [disabled]='!discoveredDevices.length')
            | Inventory only ({{ discoveredDevices.length }} device{{ discoveredDevices.length === 1 ? '' : 's' }})
      .mapper-form-row(*ngIf='discoveryMode === "bfs"')
        label.mapper-form-label Seed IP
        input.mapper-form-input(type='text', [(ngModel)]='discoveryForm.host', placeholder='e.g. 172.16.0.1')
      //- Credential fields are required for BFS, and for inventory mode only
      //- when some devices are missing per-device creds. When every inventory
      //- device already has SSH creds, we skip asking entirely.
      .mapper-form-row(*ngIf='discoveryMode === "bfs" || !allInventoryHasCreds')
        label.mapper-form-label Username
        input.mapper-form-input(
          type='text',
          [(ngModel)]='discoveryForm.username',
          [placeholder]='discoveryMode === "inventory" ? "Fallback SSH username (for devices without creds)" : "SSH username"',
        )
      .mapper-form-row(*ngIf='discoveryMode === "bfs" || !allInventoryHasCreds')
        label.mapper-form-label Password
        input.mapper-form-input(
          type='password',
          [(ngModel)]='discoveryForm.password',
          [placeholder]='discoveryMode === "inventory" ? "Fallback SSH password" : "SSH password"',
        )
      .mapper-form-row(*ngIf='discoveryMode === "inventory"')
        span(style='font-size:11px; color:var(--text-muted); flex:1')
          span(*ngIf='allInventoryHasCreds', style='color:#86efac')
            | ✓ All {{ discoveredDevices.length }} inventory device{{ discoveredDevices.length === 1 ? '' : 's' }} {{ discoveredDevices.length === 1 ? 'has' : 'have' }} SSH credentials — using them automatically.
          span(*ngIf='!allInventoryHasCreds')
            | {{ devicesWithCreds }}/{{ discoveredDevices.length }} device(s) have their own SSH credentials.
            |  The fallback above will be used for the remaining {{ discoveredDevices.length - devicesWithCreds }}.

      //- Scope indicator: shows whether the user has restricted the probe to a
      //- subset via the inventory-table checkboxes. Highlighted when in effect.
      .mapper-form-row(*ngIf='discoveryMode === "inventory"')
        span(
          *ngIf='selectedDeviceHosts.size > 0',
          style='font-size:11px; color:#3b82f6; flex:1; padding:6px 10px; background:rgba(59,130,246,0.08); border:1px solid rgba(59,130,246,0.3); border-radius:5px'
        )
          | 🎯 Selection scope active — will probe only the {{ selectedDeviceHosts.size }} checkbox-selected device(s),
          |  not the full inventory of {{ discoveredDevices.length }}. Uncheck rows or click the header checkbox to clear scope.
        span(
          *ngIf='selectedDeviceHosts.size === 0',
          style='font-size:11px; color:var(--text-muted); flex:1'
        )
          | Probes all {{ discoveredDevices.length }} device(s) in inventory. Tip: check specific rows in the table to scope the probe.
      .mapper-form-row(*ngIf='discoveryMode === "inventory"')
        span(style='font-size:11px; color:var(--text-muted); flex:1')
          | Keeps only LLDP links between probed devices. No BFS expansion.
      .mapper-form-row(*ngIf='discoveryMode === "bfs"')
        span(style='font-size:11px; color:var(--text-muted); flex:1')
          | Walks LLDP outward from the seed, up to 3 hops. Adds every reachable device to inventory.
      .mapper-form-row
        label.mapper-form-label Live build
        label(style='font-size:11px; color:var(--text-muted); flex:1; display:flex; align-items:center; gap:6px')
          input(type='checkbox', [(ngModel)]='liveBuildEnabled')
          | Stream nodes + links to the canvas as they're discovered (off = build only when you click 🔗 Build Topology)
      //- ── Regex exclusion list ─────────────────────────────────────────
      //- Hosts whose name OR mgmt IP matches any of these patterns are
      //- skipped during discovery — never visited, never added to inventory.
      //- One regex per line. # for comments. Persisted across sessions.
      .mapper-form-row(style='align-items:flex-start')
        label.mapper-form-label(style='padding-top:4px') Exclude
        textarea.mapper-form-input(
          rows='3',
          [(ngModel)]='excludePatternsText',
          (ngModelChange)='onExcludePatternsChanged()',
          style='font-family: SF Mono, Menlo, monospace; font-size:11px; resize:vertical; min-height:48px',
          placeholder='# regex per line — hosts matching are skipped\n# e.g. mgmt-net hosts, Linux servers\n^geoman-\nsrv\\d+\n\\.mgmt\\.'
        )
      //- ── Preset chips: click to append a common pattern ───────────────
      .mapper-form-row(style='align-items:flex-start; flex-wrap:wrap; gap:4px; padding-left:78px')
        span(style='font-size:11px; color:var(--text-muted); width:100%; margin-bottom:4px; display:flex; align-items:center; gap:8px')
          | Click a preset to add:
          a(href='javascript:void(0)', (click)='toggleExcludeHelp()',
            style='font-size:11px; color:var(--accent); margin-left:auto; cursor:pointer; text-decoration:underline')
            | {{ showExcludeHelp ? 'Hide' : 'Show' }} regex syntax
        button.mapper-preset-chip(
          *ngFor='let p of excludePresets',
          type='button',
          [title]='p.description + " — pattern: " + p.pattern',
          (click)='appendExcludePreset(p.pattern)'
        ) {{ p.label }}
      //- ── Inline regex syntax cheatsheet (toggle) ───────────────────────
      .mapper-form-row(*ngIf='showExcludeHelp', style='align-items:flex-start; padding-left:78px')
        .mapper-exclude-help
          .mapper-exclude-help-title Regex syntax (case-insensitive)
          ul
            li
              code ^geoman-
              |  — anchored prefix (matches names that START with geoman-)
            li
              code srv$
              |  — anchored suffix (ends with srv)
            li
              code (foo|bar)
              |  — alternation (matches foo OR bar)
            li
              code \.mgmt\.
              |  — literal dot in FQDN segment (escape dots)
            li
              code srv\d+
              |  — srv followed by one+ digits (srv1, srv42)
            li
              code [^a-z]
              |  — character class (any non-letter)
            li # comment line — ignored
          .mapper-exclude-help-foot
            | Each line is matched independently against the hostname AND mgmt IP.
            |  Invalid patterns are skipped (logged to console). Lines starting with
            |  #
            |  are comments.
      .mapper-form-row
        span(style='font-size:11px; color:var(--text-muted); flex:1; padding-left:78px')
          | Patterns are case-insensitive regex. Matched against hostname AND mgmt IP. Saved automatically.
      .mapper-form-row
        span.mapper-form-error(*ngIf='discoveryError') {{ discoveryError }}
        button.mapper-btn(type='button', (click)='showDiscoveryForm = false; cdr.markForCheck()') Cancel
        button.mapper-btn.mapper-btn-discover(type='button', (click)='startDiscovery()') Start Discovery

    //- Add device form (inline)
    .mapper-inline-form(*ngIf='showAddForm')
      .mapper-form-row
        label.mapper-form-label Hostname
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.hostname', placeholder='e.g. Spine-1')
      .mapper-form-row
        label.mapper-form-label Mgmt IP / Host
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.mgmtIp', placeholder='IPv4, IPv6, or hostname (e.g. 172.16.0.1, fd00::1, router-1.lab.local)')
      .mapper-form-row
        label.mapper-form-label Vendor
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.vendor', placeholder='e.g. Juniper, Cisco')
      .mapper-form-row
        label.mapper-form-label Model
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.model', placeholder='e.g. QFX5130 (optional)')
      .mapper-form-row
        label.mapper-form-label SSH User
        input.mapper-form-input(type='text', [(ngModel)]='newDevice.sshUsername', placeholder='SSH username (optional)')
      .mapper-form-row
        label.mapper-form-label SSH Pass
        input.mapper-form-input(type='password', [(ngModel)]='newDevice.sshPassword', placeholder='SSH password (optional)')
      .mapper-form-row
        span.mapper-form-error(*ngIf='addError') {{ addError }}
        button.mapper-btn(type='button', (click)='showAddForm = false; cdr.markForCheck()') Cancel
        button.mapper-btn.mapper-btn-apply(type='button', [disabled]='!newDevice.hostname && !newDevice.mgmtIp', (click)='confirmAddDevice()') Add Device

    //- ── Inventory Tab ──────────────────────────────────────────────
    .mapper-table-wrap(*ngIf='activeTab === "inventory"')
      .mapper-empty(*ngIf='!discoveredDevices.length')
        p No devices in inventory. Use the buttons above to:
        ul
          li 🔍 Discover Network — auto-discover via LLDP/SSH
          li 📁 Upload CSV/JSON — import from file
          li + Add Device — enter manually
        p.mapper-sample-hint Or download a sample file to get started:
        .mapper-sample-btns
          button.mapper-btn(type='button', (click)='downloadSampleCsv()') 📄 Sample CSV
          button.mapper-btn(type='button', (click)='downloadSampleJson()') 📋 Sample JSON

      //- Import summary banner (added/skipped counts)
      .mapper-import-summary(*ngIf='importSummary')
        span {{ importSummary }}
        button.mapper-summary-close(type='button', (click)='clearImportSummary()', title='Dismiss') ✕

      //- ── SSH-failure banner ─────────────────────────────────────────────
      //- Surfaced after a discovery run if any probed device failed. Shows
      //- a per-cause breakdown and a list of the failing hostnames so the
      //- user immediately sees WHICH devices are broken and WHY.
      .mapper-failure-banner(*ngIf='hasProbeFailures')
        .mapper-failure-header
          | ⚠ <strong>{{ probeFailedDevices.length }} device(s) failed SSH probe</strong>
          span.mapper-failure-spacer
          button.mapper-summary-close(
            type='button',
            (click)='clearFailureBanner()',
            title='Dismiss banner (preserves inventory; only clears the status pills)'
          ) ✕
        .mapper-failure-list
          .mapper-failure-row(*ngFor='let d of probeFailedDevices')
            span.ssh-pill.ssh-pill-fail([class]='"ssh-pill-" + (d.lastProbe?.cause || "other")')
              | {{ d.lastProbe?.cause === 'auth' ? '🔒' : d.lastProbe?.cause === 'unreachable' ? '🚫' : '✗' }}
            span.mapper-failure-name {{ d.hostname }}
            span.mapper-failure-ip(*ngIf='d.mgmtIp') {{ d.mgmtIp }}
            span.mapper-failure-cause
              | {{ d.lastProbe?.cause === 'auth' ? 'auth failed' : d.lastProbe?.cause === 'unreachable' ? 'unreachable / no SSH response' : 'connection failed' }}
            span.mapper-failure-detail(*ngIf='d.lastProbe?.detail') {{ d.lastProbe?.detail }}
        .mapper-failure-hint
          | Tip: edit the SSH user/pass inline, or use <strong>Devices → Set SSH Credentials</strong> for bulk updates, then re-run discovery.

      .mapper-search(*ngIf='discoveredDevices.length')
        input.mapper-form-input(
          type='text',
          placeholder='Search by hostname, IP, vendor, model, SSH user, or serial…',
          [(ngModel)]='searchQuery',
          (ngModelChange)='cdr.markForCheck()'
        )

      table.mapper-table(*ngIf='discoveredDevices.length')
        thead
          tr
            th(style='width:24px', title='Select for Build Topology')
              input(
                type='checkbox',
                [checked]='allFilteredSelected',
                (change)='toggleSelectAllFiltered()',
                title='Select all / clear selection'
              )
            th #
            th Hostname
            th IP Address
            th Vendor
            th Model
            th SSH User
            th SSH Pass
            th Actions
        tbody
          tr.mapper-row(
            *ngFor='let dev of filteredDevices; let i = index; trackBy: trackByHostname',
            [class.mapper-row-selected]='isDeviceSelected(dev)',
            [class.mapper-row-error]='inlineEditErrors.has(dev.hostname.toLowerCase())',
            [class.mapper-row-ssh-fail]='dev.lastProbe?.status === "fail"',
            [class.mapper-row-ssh-ok]='dev.lastProbe?.status === "ok"'
          )
            td(style='text-align:center')
              input(
                type='checkbox',
                [checked]='isDeviceSelected(dev)',
                (change)='toggleDeviceSelection(dev)'
              )
            td {{ i + 1 }}
            td.hostname-cell
              //- SSH status pill — shows the result of the most recent discovery probe.
              //- Renders even before a probe (status='unknown') so the column stays aligned.
              span.ssh-pill(
                *ngIf='dev.lastProbe',
                [class]='"ssh-pill-" + (dev.lastProbe?.status === "ok" ? "ok" : (dev.lastProbe?.cause || "other"))',
                [title]='probeTooltip(dev)'
              )
                | {{ dev.lastProbe?.status === 'ok' ? '✓' : dev.lastProbe?.cause === 'auth' ? '🔒' : dev.lastProbe?.cause === 'unreachable' ? '🚫' : '✗' }}
              input.mapper-inline-edit(
                type='text',
                [value]='dev.hostname',
                (blur)='saveDeviceEdit(dev, "hostname", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.mgmtIp',
                [class.mapper-input-invalid]='inlineEditErrors.has(dev.hostname.toLowerCase())',
                (blur)='saveDeviceEdit(dev, "mgmtIp", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.vendor',
                (blur)='saveDeviceEdit(dev, "vendor", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.model',
                (blur)='saveDeviceEdit(dev, "model", $event)'
              )
            td
              input.mapper-inline-edit(
                type='text',
                [value]='dev.sshUsername || ""',
                (blur)='saveDeviceEdit(dev, "sshUsername", $event)'
              )
            td
              input.mapper-inline-edit(
                type='password',
                [value]='dev.sshPassword || ""',
                (blur)='saveDeviceEdit(dev, "sshPassword", $event)'
              )
            td
              button.mapper-remove-btn(type='button', title='Remove', (click)='removeDevice(dev)') ✕

      //- Per-row inline-edit error pills (rendered below the table when any).
      .mapper-row-errors(*ngIf='inlineEditErrors.size > 0')
        .mapper-row-error-msg(*ngFor='let entry of inlineEditErrors | keyvalue')
          | ⚠ <strong>{{ entry.key }}</strong>: {{ entry.value }}

    //- ── Mapping Tab ────────────────────────────────────────────────
    .mapper-table-wrap(*ngIf='activeTab === "mapping"')
      .mapper-search(*ngIf='topologyNodes.length')
        input.mapper-form-input(
          type='text',
          placeholder='Search topology nodes by label, vendor, model, or role…',
          [(ngModel)]='mappingSearchQuery',
          (ngModelChange)='cdr.markForCheck()'
        )
      table.mapper-table
        thead
          tr
            th Topology Node
            th Vendor / Model
            th Role
            th ➜
            th Physical Device
            th IP Address
            th Status
        tbody
          tr.mapper-row(
            *ngFor='let node of filteredTopologyNodes; trackBy: trackByNodeId',
            [class.mapped]='mappings.has(node.id)'
          )
            td.mapper-cell-name {{ node.label }}
            td {{ node.vendor || '—' }} {{ node.model ? '/ ' + node.model : '' }}
            td
              select.mapper-select(
                [value]='node.role || ""',
                title='Change the topology role for this node. Affects tier-based layout, ASN/OSPF/IS-IS auto-config, and config-generation templates.',
                (change)='onRoleChange(node, $event)'
              )
                //- [selected] explicitly marks the matching option so the
                //- dropdown reflects the persisted role even after the
                //- topology re-emits (Angular's [value] on <select> doesn't
                //- always re-sync option selection on later change-detect).
                option(value='', [selected]='!node.role') — auto / {{ node.type }} —
                option(
                  *ngFor='let r of availableRoles',
                  [value]='r.value',
                  [selected]='node.role === r.value'
                ) {{ r.label }}
            td.mapper-cell-arrow {{ mappings.has(node.id) ? '✓' : '→' }}
            td
              select.mapper-select(
                [value]='mappings.get(node.id)?.hostname || ""',
                (change)='onMapChange(node.id, $event)'
              )
                option(value='') — Select device —
                option(
                  *ngFor='let dev of getAvailableDevices(node.id)',
                  [value]='dev.hostname'
                ) {{ dev.hostname }} ({{ dev.vendor }})
            td {{ mappings.get(node.id)?.mgmtIp || '—' }}
            td
              span.mapper-status-dot([class.mapped]='mappings.has(node.id)')
              | {{ mappings.has(node.id) ? 'Mapped' : 'Unmapped' }}

    .mapper-footer
      span.mapper-summary(*ngIf='activeTab === "inventory"') {{ discoveredDevices.length }} devices in inventory
      span.mapper-summary(*ngIf='activeTab === "mapping"') {{ mappings.size }}/{{ topologyNodes.length }} nodes mapped
      .mapper-footer-actions
        //- Selection-count chip — only shown while user has a checkbox selection
        span.mapper-selection-chip(
          *ngIf='activeTab === "inventory" && selectedDeviceHosts.size > 0',
          title='Click to clear selection',
          (click)='clearDeviceSelection()'
        )
          | {{ selectedDeviceHosts.size }} of {{ discoveredDevices.length }} selected ✕
        //- Bulk-delete the checkbox-selected devices (and their LLDP links).
        //- Tip: use the search filter + select-all to delete by pattern in one click.
        button.mapper-btn.mapper-btn-delete-sel(
          *ngIf='activeTab === "inventory" && selectedDeviceHosts.size > 0',
          type='button',
          title='Remove the selected device(s) and any LLDP link(s) touching them. Tip: use the search filter + select-all to bulk-delete by pattern.',
          (click)='deleteSelected()'
        ) 🗑 Delete Selected ({{ selectedDeviceHosts.size }})
        button.mapper-btn.mapper-btn-apply(
          *ngIf='activeTab === "inventory" && discoveredDevices.length',
          type='button',
          [title]='selectedDeviceHosts.size > 0 ? "Build topology from the " + selectedDeviceHosts.size + " selected device(s) and the LLDP links between them" : "Create a topology node for every discovered device and draw a link for every LLDP adjacency. Adds to the current canvas."',
          (click)='buildTopologyFromDiscovery(false)'
        ) 🔗 Build Topology{{ selectedDeviceHosts.size > 0 ? ' (' + selectedDeviceHosts.size + ')' : '' }}
        //- Clear the canvas without auto-populating from discovery. Distinct
        //- from "Build Topology" — this just resets, leaving the discovered
        //- inventory list intact so the user can pick what to add next.
        button.mapper-btn(
          *ngIf='activeTab === "inventory"',
          type='button',
          title='Wipe the current canvas (delete every node + link). Discovered inventory stays — use Build Topology to populate after.',
          (click)='clearCanvasRequested.emit()'
        ) 🧹 Clear Canvas
        button.mapper-btn(*ngIf='activeTab === "inventory" && discoveredDevices.length', type='button', (click)='exportInventoryCsv()') 📥 Export CSV
        button.mapper-btn(*ngIf='activeTab === "inventory" && discoveredDevices.length', type='button', title='Lossless export — preserves interfaces array and round-trips with import', (click)='exportInventoryJson()') 📥 Export JSON
        button.mapper-btn(*ngIf='activeTab === "inventory" && discoveredDevices.length && !showClearConfirm', (click)='clearAllDevices()') Clear All
        span.mapper-confirm(*ngIf='showClearConfirm')
          | Are you sure?
          button.mapper-btn(type='button', (click)='confirmClearAll()') Yes, clear
          button.mapper-btn(type='button', (click)='showClearConfirm = false; cdr.markForCheck()') No
        button.mapper-btn(type='button', (click)='close()') Cancel
        button.mapper-btn.mapper-btn-apply(
          *ngIf='activeTab === "mapping"',
          type='button',
          title='Save mappings to topology (SSH creds + mgmt IP + vendor). Does not push configs.',
          [disabled]='!mappings.size',
          (click)='applyMapping()'
        ) Apply Mapping
        button.mapper-btn.mapper-btn-push(
          *ngIf='activeTab === "mapping"',
          type='button',
          title='Apply mapping, then push startup configs to mapped devices via SSH.',
          [disabled]='!mappings.size',
          (click)='applyAndPush()'
        ) Apply &amp; Push Configs
