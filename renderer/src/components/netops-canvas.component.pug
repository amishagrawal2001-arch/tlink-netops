        input.auto-ip-input(type='text', [(ngModel)]='editingServer.name', placeholder='My Linux Server')
        label.auto-ip-label SSH Host
        input.auto-ip-input(type='text', [(ngModel)]='editingServer.host', placeholder='192.168.1.100')
        label.auto-ip-label SSH Username
        input.auto-ip-input(type='text', [(ngModel)]='editingServer.username', placeholder='admin')
        label.auto-ip-label SSH Password
        input.auto-ip-input(type='password', [(ngModel)]='editingServer.password', placeholder='Leave empty to use SSH key (ssh-agent)')
        label.auto-ip-label SSH Port
        input.auto-ip-input(type='number', [(ngModel)]='editingServer.port', placeholder='22')
        label.auto-ip-label Remote Lab Directory
        input.auto-ip-input(type='text', [(ngModel)]='editingServer.remoteLabDir', placeholder='/tmp/containerlab-labs')
