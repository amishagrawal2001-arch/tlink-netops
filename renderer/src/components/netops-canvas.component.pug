        button.btn-tool(type='button', (click)='closeVrnetlabBuilder()') Cancel

  //- ── VM Manager (libvirt/virsh) ────────────────────────────────────
  .front-dialog-overlay(*ngIf='showVmManager')
    .auto-ip-dialog.vm-mgr-dialog.front-dialog-panel
      .auto-ip-title VM Manager
      .auto-ip-subtitle Manage KVM virtual machines via libvirt/virsh on the selected server
      .clab-server-section
        .clab-server-row
          span.clab-server-label Server
          select.clab-server-select([ngModel]='clabActiveServerId', (ngModelChange)='switchVmManagerServer($event)')
            option(*ngFor='let s of clabServers', [value]='s.id') {{ s.name }}{{ s.type === 'ssh' && s.host && s.host !== s.name ? ' (' + s.host + ')' : '' }}
      .vm-mgr-toolbar
        button.clab-prereq-btn(type='button', (click)='refreshVmList()', [disabled]='vmManagerLoading') {{ vmManagerLoading ? 'Loading…' : 'Refresh' }}
        button.clab-prereq-btn(type='button', (click)='toggleVmCreateForm()') {{ showVmCreateForm ? 'Cancel' : '+ Create VM' }}
      //- Create VM form
      .vm-create-form(*ngIf='showVmCreateForm')
        .form-row
          label.form-label Name
          input.form-input(type='text', [(ngModel)]='vmCreateName', placeholder='my-router')
        .form-row
          label.form-label vCPUs
          input.form-input(type='number', [(ngModel)]='vmCreateCpu', min='1', max='64')
        .form-row
          label.form-label Memory (MB)
          input.form-input(type='number', [(ngModel)]='vmCreateMemory', min='256', step='256')
        .form-row
          label.form-label Disk Image
          .vrnetlab-file-row
            input.form-input([value]='vmCreateDiskPath', readonly, placeholder='Select or pick from library below')
            button.clab-prereq-btn(type='button', (click)='selectVmDiskImage()') Browse…
          //- Disk Image Library from /var/lib/libvirt/images
          .vm-image-library
            .vm-image-library-header
              span.vm-image-library-title Server Images
              span.vm-image-library-path /var/lib/libvirt/images
              button.form-btn-sm(type='button', (click)='refreshDiskImages()', [disabled]='vmDiskImagesLoading', title='Refresh image list') ↻
              button.form-btn-sm(type='button', (click)='uploadDiskImage()', [disabled]='vmUploadingImage', title='Upload a disk image to server') {{ vmUploadingImage ? 'Uploading…' : '⬆ Upload' }}
            .vm-image-library-list(*ngIf='vmDiskImages.length > 0')
              .vm-image-item(
                *ngFor='let img of vmDiskImages',
                [class.vm-image-selected]='vmCreateDiskPath === img.path',
                (click)='selectDiskImageFromLibrary(img)'
              )
                span.vm-image-name {{ img.name }}
                span.vm-image-size {{ img.size }}
            .vm-image-library-empty(*ngIf='vmDiskImagesLoaded && vmDiskImages.length === 0 && !vmDiskImagesLoading')
              span No images found. Use "Upload" to add a disk image to the server.
            .vm-image-library-loading(*ngIf='vmDiskImagesLoading')
              span Loading images…
            .vm-image-library-error(*ngIf='vmUploadError')
              span ⚠ {{ vmUploadError }}
        .form-row
          label.form-label Network Bridge
