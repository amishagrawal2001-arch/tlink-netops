            select.form-input([(ngModel)]='vmCreateBridge')
              option(value='virbr0') virbr0 (default)
              option(*ngFor='let br of bridgeList', [value]='br.name') {{ br.name }} ({{ br.type }})
            button.form-btn-sm(type='button', (click)='refreshBridgeList()', title='Refresh bridges') ↻
        .auto-ip-actions
          button.btn-tool(type='button', [disabled]='!vmCreateName || !vmCreateDiskPath || vmCreating', (click)='createVm()') {{ vmCreating ? 'Creating…' : 'Create & Start' }}
      //- Delete confirmation
      .vm-create-form(*ngIf='vmDeleteConfirm')
        .clab-prereq-msg.clab-fail Delete VM "{{ vmDeleteConfirm }}"?
        .form-row
          label.form-label
            input(type='checkbox', [(ngModel)]='vmDeleteStorage')
            |  Also delete disk image
        .auto-ip-actions
          button.clab-prereq-btn.clab-btn-danger(type='button', (click)='deleteVm()') Confirm Delete
          button.clab-prereq-btn(type='button', (click)='cancelDeleteVm()') Cancel
