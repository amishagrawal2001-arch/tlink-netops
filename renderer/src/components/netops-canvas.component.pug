  .auto-ip-overlay(*ngIf='showBulkCredDialog', (click)='showBulkCredDialog = false')
    .auto-ip-dialog.bulk-cred-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Set SSH Credentials ({{ selectedNodeIds.size }} nodes)
      .bulk-cred-form
        .bulk-cred-row
          span.bulk-cred-label Vendor
          input.bulk-cred-input(type='text', [(ngModel)]='bulkCredVendor', placeholder='e.g. arista, cisco, sonic')
        .bulk-cred-row
          span.bulk-cred-label SSH Username
          input.bulk-cred-input(type='text', [(ngModel)]='bulkCredUsername', placeholder='admin')
        .bulk-cred-row
          span.bulk-cred-label SSH Password
          input.bulk-cred-input(type='password', [(ngModel)]='bulkCredPassword')
        .bulk-cred-row
          span.bulk-cred-label Mgmt IP Prefix
          input.bulk-cred-input(type='text', [(ngModel)]='bulkCredMgmtPrefix', placeholder='e.g. 172.20.20.')
      .auto-ip-actions
        button.btn-tool(type='button', (click)='applyBulkCredentials()') Apply
        button.btn-tool(type='button', (click)='showBulkCredDialog = false') Cancel

