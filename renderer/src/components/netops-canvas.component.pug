.netops-shell(
  [class.is-link-mode]='linkModeActive'
)

  //- ── Top bar (brand + topology info) ──────────────────────────────────────
  .netops-topbar
    .topbar-divider
    .topbar-topo
      span.topo-name {{ topology?.name }}
      span.topo-stats  · {{ nodeCount }} nodes · {{ linkCount }} links
      span.topo-mapped(*ngIf='mappedCount > 0')  · {{ mappedCount }} mapped
      span.topo-running(*ngIf='runningCount > 0')  · {{ runningCount }} running
    .topbar-divider
    //- Topology description (click to edit)
    ng-container(*ngIf='!editingDescription')
      span.topo-desc(
        [class.placeholder]='!topology?.description',
        (click)='startEditDescription()',
        title='Click to edit description'
      ) {{ topology?.description || 'Add description…' }}
    ng-container(*ngIf='editingDescription')
      input.topo-desc-input(
        type='text',
        [(ngModel)]='editingDescriptionText',
        (blur)='commitDescription()',
        (keydown.enter)='commitDescription()',
        (keydown.escape)='cancelDescription()',
        (click)='$event.stopPropagation()',
        placeholder='Topology description…'
      )
    .topbar-spacer
    //- ── Quick-access toolbar buttons ────────────────────────────────────
    .topbar-actions
      button.qb(type='button', title='Save (Ctrl+S)', (click)='saveTopology()')
        span ↓
      button.qb(type='button', title='Undo (Ctrl+Z)', [disabled]='!canUndo', (click)='undo()')
        span ↺
      button.qb(type='button', title='Redo (Ctrl+Shift+Z)', [disabled]='!canRedo', (click)='redo()')
        span ↻
      .topbar-divider
      button.qb(type='button', title='Link Mode (L)', [class.qb-active]='linkModeActive', (click)='toggleLinkMode()')
        span ⤢
      button.qb(type='button', title='Fit / Reset View', (click)='resetView()')
        span ⊕
      button.qb(type='button', [title]='currentTheme === "dark" ? "Switch to light theme" : "Switch to dark theme"', (click)='toggleTheme()')
        span {{ currentTheme === 'dark' ? '☀' : '☾' }}
      button.qb(type='button', title='Export as SVG', (click)='exportSVG()')
        span ⤓
      button.qb(type='button', title='Export as PNG', (click)='exportPNG()')
        span 🖼
      button.qb(type='button', title='Keyboard Shortcuts (?)', (click)='showShortcutsOverlay = !showShortcutsOverlay')
        span ⌨
      .topbar-divider
      button.qb.qb-start(type='button', title='Start all', [disabled]='nodeCount === 0 || runningCount === nodeCount', (click)='startAll()')
        span.qb-dot.dot-running
      button.qb.qb-stop(type='button', title='Stop all', [disabled]='nodeCount === 0 || runningCount === 0', (click)='stopAll()')
        span.qb-dot.dot-stopped
    .topbar-divider
    //- Inline search input in top bar
    .topbar-search([class.active]='showSearch')
      span.tsearch-icon ⌕
      input.tsearch-input(
        type='text',
        placeholder='Search nodes… (Ctrl+F)',
        [(ngModel)]='searchQuery',
        (focus)='showSearch = true',
        (keydown.escape)='toggleSearch()',
        (click)='$event.stopPropagation()'
      )
      .search-results(*ngIf='showSearch && searchQuery.trim()')
        .search-empty(*ngIf='searchResults.length === 0') No matches
        button.search-result-item(
          type='button',
          *ngFor='let n of searchResults',
          (click)='jumpToNode(n)'
        )
          span.search-result-type {{ meta[n.type].label }}
          span.search-result-label {{ n.label }}
          span.search-result-ip(*ngIf='n.mgmtIp') {{ n.mgmtIp }}
    .topbar-server-indicator(
      (click)='openServerManager(); $event.stopPropagation()',
      [title]='"Server: " + activeClabServerName + (serverConnectionStatus === "connected" ? " — Connected" : serverConnectionStatus === "disconnected" ? " — Disconnected" : " — Local")'
    )
      span.server-indicator-dot(
        [class.dot-connected]='serverConnectionStatus === "connected"',
        [class.dot-disconnected]='serverConnectionStatus === "disconnected"',
        [class.dot-local]='serverConnectionStatus === "local"'
      )
      span.server-indicator-name {{ activeClabServerName }}
    .tlink-logo(title='Tlink NetOps')
      svg.tlink-logo-svg(width='80', height='24', viewBox='0 0 80 24')
        defs
          linearGradient#tlink-grad(x1='0%', y1='0%', x2='100%', y2='100%')
            stop(offset='0%', stop-color='#3b82f6')
            stop(offset='100%', stop-color='#8b5cf6')
        circle(cx='10', cy='12', r='8', fill='url(#tlink-grad)', opacity='0.9')
        path(d='M6,12 L10,8 L14,12 L10,16 Z', fill='#fff', opacity='0.9')
        text(x='22', y='16', font-size='13', font-weight='700', fill='url(#tlink-grad)', font-family='system-ui, sans-serif') Tlink

  //- ── License / Trial Banner ────────────────────────────────────────────────
  .license-trial-banner(*ngIf='licenseSvc.showTrialBanner')
    span.trial-banner-text Trial: {{ licenseSvc.trialDaysRemaining }} day{{ licenseSvc.trialDaysRemaining === 1 ? '' : 's' }} remaining
    button.trial-banner-upgrade(type='button', (click)='showLicenseDialog = true') Upgrade
  .license-tier-banner(*ngIf='licenseSvc.showLicenseBanner', [class.tier-pro]='licenseSvc.licenseTier === "pro"', [class.tier-enterprise]='licenseSvc.licenseTier === "enterprise"')
    span.tier-banner-text {{ licenseSvc.tierDisplayName }}
    span.tier-banner-expiry(*ngIf='licenseSvc.licenseExpiry') Expires: {{ licenseSvc.formattedExpiry }}

  //- ── Menu bar ────────────────────────────────────────────────────────────
  .netops-menubar((click)='$event.stopPropagation()')
    input#fileInput(type='file', accept='.json', hidden='', (change)='onFileInput($event)')
    input#deviceFileInput(type='file', accept='.csv,text/csv', hidden='', (change)='onDeviceFileInput($event)')
    input#ipMatrixFileInput(type='file', accept='.csv,text/csv', hidden='', (change)='onIpMatrixFileInput($event)')
    input#imageFileInput(type='file', accept='image/png,image/jpeg,image/svg+xml,image/gif', hidden='', (change)='onImageFileInput($event)')

    //- ── File ─────────────────────────────
    .menu-item-wrap
      button.menu-trigger(
        type='button',
        [class.active]='openMenu === "file"',
        (click)='toggleMenu("file")',
        (mouseenter)='onMenuEnter("file")'
      ) File
      .menu-dropdown(*ngIf='openMenu === "file"')
        button.menu-item(type='button', (click)='newTopology(); closeMenus()')
          span.mi-icon +
          span.mi-label New Topology
        button.menu-item(type='button', (click)='openTemplates(); closeMenus()')
          span.mi-icon ▤
          span.mi-label Templates…
        button.menu-item(type='button', (click)='openBuilder(); closeMenus()')
          span.mi-icon ⬡
          span.mi-label Build Custom…
        .menu-sep
        button.menu-item(type='button', (click)='saveTopology(); closeMenus()')
          span.mi-icon ↓
          span.mi-label Save
          span.mi-shortcut Ctrl+S
        button.menu-item(type='button', (click)='saveTopologyAs(); closeMenus()')
          span.mi-icon ↓
          span.mi-label Save As…
        button.menu-item(type='button', (click)='loadTopology(); closeMenus()')
          span.mi-icon ↑
          span.mi-label Open…
          span.mi-shortcut Ctrl+O
        .menu-sep
        button.menu-item(type='button', (click)='saveWorkspace(); closeMenus()')
          span.mi-icon ⇊
          span.mi-label Save Workspace
          span.mi-shortcut Ctrl+Shift+S
        button.menu-item(type='button', (click)='saveWorkspaceAs(); closeMenus()')
          span.mi-icon ⇊
          span.mi-label Save Workspace As…
        button.menu-item(type='button', (click)='loadWorkspace(); closeMenus()')
          span.mi-icon ⇈
          span.mi-label Open Workspace…
        .menu-sep
        button.menu-item(type='button', (click)='exportTopologyJson(); closeMenus()')
          span.mi-icon ⇣
          span.mi-label Export Topology JSON
        button.menu-item(type='button', (click)='importTopologyJson(); closeMenus()')
          span.mi-icon ⇡
          span.mi-label Import Topology JSON
        .menu-sep
        button.menu-item(type='button', (click)='insertImageFromMenu(); closeMenus()')
          span.mi-icon 🖼
          span.mi-label Insert Image…

    //- ── Edit ─────────────────────────────
    .menu-item-wrap
      button.menu-trigger(
        type='button',
        [class.active]='openMenu === "edit"',
        (click)='toggleMenu("edit")',
        (mouseenter)='onMenuEnter("edit")'
      ) Edit
      .menu-dropdown(*ngIf='openMenu === "edit"')
        button.menu-item(type='button', [disabled]='!canUndo', (click)='undo(); closeMenus()')
          span.mi-icon ↺
          span.mi-label Undo
          span.mi-shortcut Ctrl+Z
        button.menu-item(type='button', [disabled]='!canRedo', (click)='redo(); closeMenus()')
          span.mi-icon ↻
          span.mi-label Redo
          span.mi-shortcut Ctrl+Shift+Z
        .menu-sep
        button.menu-item(type='button', [disabled]='selectedNodeIds.size === 0', (click)='copyNodes(); closeMenus()')
          span.mi-icon ⎘
          span.mi-label Copy
          span.mi-shortcut Ctrl+C
        button.menu-item(type='button', [disabled]='!hasClipboard', (click)='pasteNodes(); closeMenus()')
          span.mi-icon ⎗
          span.mi-label Paste
          span.mi-shortcut Ctrl+V
        button.menu-item(type='button', [disabled]='nodeCount + linkCount === 0', (click)='selectAll(); closeMenus()')
          span.mi-icon □
          span.mi-label Select All
          span.mi-shortcut Ctrl+A
        .menu-sep
        button.menu-item(type='button', [class.menu-item-checked]='linkModeActive', (click)='toggleLinkMode(); closeMenus()')
          span.mi-check {{ linkModeActive ? '✓' : '' }}
          span.mi-label Link Mode
          span.mi-shortcut L

    //- ── View ─────────────────────────────
    .menu-item-wrap
      button.menu-trigger(
        type='button',
        [class.active]='openMenu === "view"',
        (click)='toggleMenu("view")',
        (mouseenter)='onMenuEnter("view")'
      ) View
      .menu-dropdown(*ngIf='openMenu === "view"')
        button.menu-item(type='button', [disabled]='vpScale >= maxScale', (click)='zoomIn(); closeMenus()')
          span.mi-icon +
          span.mi-label Zoom In
          span.mi-shortcut Ctrl+=
        button.menu-item(type='button', [disabled]='vpScale <= minScale', (click)='zoomOut(); closeMenus()')
          span.mi-icon −
          span.mi-label Zoom Out
          span.mi-shortcut Ctrl+-
        button.menu-item(type='button', (click)='resetView(); closeMenus()')
          span.mi-icon ⊕
          span.mi-label Fit / Reset View
        .menu-sep
        button.menu-item(type='button', [class.menu-item-checked]='showIpLabels', (click)='toggleIpVisibility(); closeMenus()')
          span.mi-check {{ showIpLabels ? '✓' : '' }}
          span.mi-label Show IP Labels
        button.menu-item(type='button', [class.menu-item-checked]='showInterfaceLabels', (click)='toggleInterfaceLabels(); closeMenus()')
          span.mi-check {{ showInterfaceLabels ? '✓' : '' }}
          span.mi-label Show Interface Labels
        button.menu-item(type='button', [class.menu-item-checked]='showVlanView', (click)='toggleVlanView(); closeMenus()')
          span.mi-check {{ showVlanView ? '✓' : '' }}
          span.mi-label VLAN View
        button.menu-item(type='button', [class.menu-item-checked]='showBgpView', (click)='toggleBgpView(); closeMenus()')
          span.mi-check {{ showBgpView ? '✓' : '' }}
          span.mi-label BGP View
        button.menu-item(type='button', [class.menu-item-checked]='showTrafficFlowView', (click)='toggleTrafficFlowView(); closeMenus()')
          span.mi-check {{ showTrafficFlowView ? '✓' : '' }}
          span.mi-label Traffic Flows
        .menu-sep
        button.menu-item(type='button', [class.menu-item-checked]='showTrafficFlowPanel', (click)='toggleTrafficFlowPanel(); closeMenus()')
          span.mi-check {{ showTrafficFlowPanel ? '✓' : '' }}
          span.mi-label Flow Panel
        button.menu-item(type='button', [class.menu-item-checked]='showRouteView', (click)='toggleRouteView(); closeMenus()')
          span.mi-check {{ showRouteView ? '✓' : '' }}
          span.mi-label Route Table View
        button.menu-item(type='button', [class.menu-item-checked]='showCounterView', (click)='toggleCounterView(); closeMenus()')
          span.mi-check {{ showCounterView ? '✓' : '' }}
          span.mi-label Interface Counters
        button.menu-item(type='button', [class.menu-item-checked]='showIpv6Labels', (click)='showIpv6Labels = !showIpv6Labels; closeMenus()')
          span.mi-check {{ showIpv6Labels ? '✓' : '' }}
          span.mi-label IPv6 Labels
        .menu-sep
        button.menu-item(type='button', [class.menu-item-checked]='showHealthWidget', (click)='showHealthWidget = !showHealthWidget; closeMenus()')
          span.mi-check {{ showHealthWidget ? '✓' : '' }}
          span.mi-label Health Widget
        button.menu-item(type='button', [class.menu-item-checked]='showAlarmOverlay', (click)='showAlarmOverlay = !showAlarmOverlay; closeMenus()')
          span.mi-check {{ showAlarmOverlay ? '✓' : '' }}
          span.mi-label Alarm Overlay
        button.menu-item(type='button', [class.menu-item-checked]='showMinimap', (click)='showMinimap = !showMinimap; closeMenus()')
          span.mi-check {{ showMinimap ? '✓' : '' }}
          span.mi-label Minimap
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='autoLayout("force"); closeMenus()')
          span.mi-icon ⊛
          span.mi-label Auto-Layout: Force
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='autoLayout("hierarchical"); closeMenus()')
          span.mi-icon ⊟
          span.mi-label Auto-Layout: Hierarchical
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='autoLayout("radial"); closeMenus()')
          span.mi-icon ◎
          span.mi-label Auto-Layout: Radial
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='autoLayout("grid"); closeMenus()')
          span.mi-icon ⊞
          span.mi-label Auto-Layout: Grid
        button.menu-item(type='button', (click)='toggleLinkStyle(); closeMenus()')
          span.mi-check {{ !linkStyleCurved ? '✓' : '' }}
          span.mi-label Straight Links
        .menu-sep
        button.menu-item(type='button', [class.menu-item-checked]='showIpam', (click)='toggleIpam(); closeMenus()')
          span.mi-check {{ showIpam ? '✓' : '' }}
          span.mi-label IPAM Panel
        button.menu-item(type='button', [class.menu-item-checked]='showSyslogPanel', (click)='toggleSyslogPanel(); closeMenus()')
          span.mi-check {{ showSyslogPanel ? '✓' : '' }}
          span.mi-label Syslog Feed
        .menu-sep
        button.menu-item(type='button', [class.menu-item-checked]='showGrid', (click)='toggleGrid(); closeMenus()')
          span.mi-check {{ showGrid ? '✓' : '' }}
          span.mi-label Show Grid
        button.menu-item(type='button', [class.menu-item-checked]='gridSize === "small"', (click)='setGridSize("small"); closeMenus()')
          span.mi-check {{ gridSize === 'small' ? '✓' : '' }}
          span.mi-label Grid: Small
        button.menu-item(type='button', [class.menu-item-checked]='gridSize === "medium"', (click)='setGridSize("medium"); closeMenus()')
          span.mi-check {{ gridSize === 'medium' ? '✓' : '' }}
          span.mi-label Grid: Medium
        button.menu-item(type='button', [class.menu-item-checked]='gridSize === "large"', (click)='setGridSize("large"); closeMenus()')
          span.mi-check {{ gridSize === 'large' ? '✓' : '' }}
          span.mi-label Grid: Large

    //- ── Devices ──────────────────────────
    .menu-item-wrap
      button.menu-trigger(
        type='button',
        [class.active]='openMenu === "devices"',
        (click)='toggleMenu("devices")',
        (mouseenter)='onMenuEnter("devices")'
      ) Devices
      .menu-dropdown(*ngIf='openMenu === "devices"')
        button.menu-item(type='button', (click)='openDeviceImport(); closeMenus()')
          span.mi-icon ⌁
          span.mi-label Import Device CSV…
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='exportDeviceCsv(); closeMenus()')
          span.mi-icon ⇣
          span.mi-label Export Device CSV
        .menu-sep
        button.menu-item(type='button', [disabled]='linkCount === 0', (click)='autoAddressTopology(); closeMenus()')
          span.mi-icon ◌
          span.mi-label Auto-Assign IPv4 /30 IPs
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='autoGenerateLoopbacks(); closeMenus()')
          span.mi-icon Lo
          span.mi-label Auto-Assign IPv4 Loopbacks
        .menu-sep
        button.menu-item(type='button', [disabled]='linkCount === 0', (click)='autoAddressV6(); closeMenus()')
          span.mi-icon v6
          span.mi-label Auto-Assign IPv6 /127 IPs
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='autoGenerateLoopbacksV6(); closeMenus()')
          span.mi-icon v6
          span.mi-label Auto-Assign IPv6 Loopbacks
        .menu-sep
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='openServiceDialog(); closeMenus()')
          span.mi-icon ⬡
          span.mi-label Apply Service Profile…

    //- ── Inventory ────────────────────────
    .menu-item-wrap
      button.menu-trigger(
        type='button',
        [class.active]='openMenu === "inventory"',
        (click)='toggleMenu("inventory")',
        (mouseenter)='onMenuEnter("inventory")'
      ) Inventory
        span.menu-alarm-badge(*ngIf='activeAlarmCount > 0') {{ activeAlarmCount }}
      .menu-dropdown(*ngIf='openMenu === "inventory"')
        button.menu-item(type='button', (click)='toggleInventoryPanel(); closeMenus()')
          span.mi-check {{ showInventoryPanel ? "✓" : "" }}
          span.mi-label Inventory Panel
        button.menu-item(type='button', (click)='toggleAlarmPanel(); closeMenus()')
          span.mi-check {{ showAlarmPanel ? "✓" : "" }}
          span.mi-label Alarm Panel
          span.mi-shortcut(*ngIf='activeAlarmCount') {{ activeAlarmCount }}
        .menu-sep
        button.menu-item(type='button', (click)='pollAllDevices(); closeMenus()')
          span.mi-icon ↻
          span.mi-label Poll All Devices
        button.menu-item(
          type='button',
          [disabled]='!isSelectedMapped',
          (click)='pollSelectedDevice(); closeMenus()'
        )
          span.mi-icon ↻
          span.mi-label Poll Selected Device
        button.menu-item(type='button', [class.menu-item-checked]='inventoryPollingEnabled', (click)='togglePolling(); closeMenus()')
          span.mi-check {{ inventoryPollingEnabled ? "✓" : "" }}
          span.mi-label Auto-Poll ({{ pollIntervalMinutes }}m)
        .menu-sub(*ngIf='inventoryPollingEnabled || true')
          button.menu-item.menu-item-sm(
            type='button',
            *ngFor='let m of pollIntervalOptions',
            [class.menu-item-checked]='pollIntervalMinutes === m',
            (click)='setPollInterval(m); closeMenus()'
          )
            span.mi-check {{ pollIntervalMinutes === m ? "✓" : "" }}
            span.mi-label {{ m }} min
        .menu-sep
        button.menu-item(type='button', (click)='backupAllConfigs(); closeMenus()')
          span.mi-icon ⎘
          span.mi-label Backup All Configs
        button.menu-item(
          type='button',
          [disabled]='!isSelectedMapped',
          (click)='backupSelectedConfig(); closeMenus()'
        )
          span.mi-icon ⎘
          span.mi-label Backup Selected Config
        .menu-sep
        button.menu-item(type='button', (click)='openConfigDiffViewer(); closeMenus()')
          span.mi-icon ≏
          span.mi-label Config Diff Viewer…
        button.menu-item(type='button', (click)='openEventRulesDialog(); closeMenus()')
          span.mi-icon ⚡
          span.mi-label Event Rules…
        button.menu-item(type='button', (click)='openUpgradesDialog(); closeMenus()')
          span.mi-icon ↑
          span.mi-label Upgrade Plans…
        .menu-sep
        button.menu-item(type='button', (click)='openDashboard(); closeMenus()')
          span.mi-icon ◫
          span.mi-label Dashboard
        .menu-sep
        button.menu-item(type='button', (click)='exportInventoryReport(); closeMenus()')
          span.mi-icon ⤓
          span.mi-label Export Inventory (JSON)
        button.menu-item(type='button', (click)='exportAllConfigs(); closeMenus()')
          span.mi-icon 📋
          span.mi-label Export All Configs (.cfg)
        button.menu-item(type='button', (click)='exportTelegrafConfig(); closeMenus()')
          span.mi-icon 📡
          span.mi-label Export Telegraf Config
        .menu-sep
        button.menu-item(type='button', [disabled]='!hasConfigs || configPushAllRunning', (click)='pushAllConfigs(); closeMenus()')
          span.mi-icon 🚀
          span.mi-label {{ configPushAllRunning ? 'Pushing...' : 'Push All Configs to Devices' }}
        button.menu-item(type='button', (click)='exportAlarmHistory(); closeMenus()')
          span.mi-icon ⤓
          span.mi-label Export Alarms (CSV)

    //- ── Simulate ─────────────────────────
    .menu-item-wrap
      button.menu-trigger(
        type='button',
        [class.active]='openMenu === "simulate"',
        (click)='toggleMenu("simulate")',
        (mouseenter)='onMenuEnter("simulate")'
      ) Simulate
      .menu-dropdown(*ngIf='openMenu === "simulate"')
        button.menu-item(type='button', [disabled]='nodeCount === 0 || runningCount === nodeCount', (click)='startAll(); closeMenus()')
          span.mi-dot.dot-running
          span.mi-label Start All Nodes
        button.menu-item(type='button', [disabled]='nodeCount === 0 || runningCount === 0', (click)='stopAll(); closeMenus()')
          span.mi-dot.dot-stopped
          span.mi-label Stop All Nodes
        .menu-sep
        button.menu-item(type='button', (click)='openServerManager(); closeMenus()')
          span.mi-icon 🖥
          span.mi-label Server Manager…
        button.menu-item(type='button', (click)='openImageManager(); closeMenus()')
          span.mi-icon 🐳
          span.mi-label Docker Image Manager…
        button.menu-item(type='button', (click)='openVmManager(); closeMenus()')
          span.mi-icon 💻
          span.mi-label VM Manager (KVM)…
        button.menu-item(type='button', (click)='openBridgeManager(); closeMenus()')
          span.mi-icon 🔀
          span.mi-label Bridge Manager…
        button.menu-item(type='button', (click)='openVxlanDialog(); closeMenus()')
          span.mi-icon 🔗
          span.mi-label VXLAN Tunnel…
        button.menu-item(type='button', (click)='openFileBrowser(); closeMenus()')
          span.mi-icon 📁
          span.mi-label File Browser…
        button.menu-item(type='button', [disabled]='!clabDeployed', (click)='openSnapshotDialog(); closeMenus()')
          span.mi-icon 📸
          span.mi-label Lab Snapshots…
        button.menu-item(type='button', (click)='openClabDialog(); closeMenus()')
          span.mi-icon ▶
          span.mi-label Deploy Containerlab…
        button.menu-item(type='button', [disabled]='!clabDeployed', (click)='destroyContainerlab(); closeMenus()')
          span.mi-icon ■
          span.mi-label Destroy Lab
        button.menu-item(type='button', [disabled]='!clabDeployed || clabInspecting', (click)='inspectContainerlab(); closeMenus()')
          span.mi-icon ↻
          span.mi-label Inspect Lab Status
        button.menu-item(type='button', [disabled]='clabDeployed', (click)='detectRunningLab(); closeMenus()')
          span.mi-icon 🔍
          span.mi-label Detect Running Lab
        .menu-sep
        button.menu-item(type='button', [disabled]='!clabDeployed', (click)='livePollingActive ? stopLivePolling() : startLivePolling(); closeMenus()')
          span.mi-icon {{ livePollingActive ? '⏹' : '📡' }}
          span.mi-label {{ livePollingActive ? 'Stop Live Monitor' : 'Start Live Monitor' }}
        .menu-sep
        button.menu-item(type='button', [disabled]='!hasSimulatedFailures', (click)='clearAllSimulatedFailures(); closeMenus()')
          span.mi-icon ✕
          span.mi-label Clear All Simulated Failures
        button.menu-item(type='button', [disabled]='!clabFilePath', (click)='compareTopologyWithSaved(); closeMenus()')
          span.mi-icon ⇋
          span.mi-label Compare with Saved

    //- ── Export ────────────────────────────
    .menu-item-wrap
      button.menu-trigger(
        type='button',
        [class.active]='openMenu === "export"',
        (click)='toggleMenu("export")',
        (mouseenter)='onMenuEnter("export")'
      ) Export
      .menu-dropdown(*ngIf='openMenu === "export"')
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='validateTopology(); closeMenus()')
          span.mi-icon ✓
          span.mi-label Validate Topology
        .menu-sep
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='exportAnsibleInventory(); closeMenus()')
          span.mi-label Ansible Inventory
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='exportGns3(); closeMenus()')
          span.mi-label GNS3 Project
        button.menu-item(type='button', (click)='openClabDialog(); closeMenus()')
          span.mi-label Containerlab Topology
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='exportIpMatrix(); closeMenus()')
          span.mi-label Export IP Matrix CSV
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='openIpMatrixImport(); closeMenus()')
          span.mi-icon ⌁
          span.mi-label Import IP Matrix CSV…
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='exportHtmlReport(); closeMenus()')
          span.mi-label HTML Report
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='exportTopologyPng(); closeMenus()')
          span.mi-label Export as PNG
        button.menu-item(type='button', [disabled]='nodeCount === 0', (click)='exportTopologySvg(); closeMenus()')
          span.mi-label Export as SVG
        .menu-sep
        button.menu-item(type='button', [disabled]='!hasConfigs', (click)='exportAllConfigs(); closeMenus()')
          span.mi-label Download All Configs

    //- ── License ─────────────────────────────
    .menu-item-wrap
      button.menu-trigger(
        type='button',
        [class.active]='openMenu === "license"',
        (click)='toggleMenu("license")',
        (mouseenter)='onMenuEnter("license")'
      ) License
      .menu-dropdown(*ngIf='openMenu === "license"')
        .menu-license-status
          span.menu-license-badge(
            [class.badge-trial]='licenseSvc.licenseStatus === "trial"',
            [class.badge-active]='licenseSvc.licenseStatus === "active"',
            [class.badge-expired]='licenseSvc.licenseStatus === "expired"'
          ) {{ licenseSvc.licenseStatus === 'active' ? licenseSvc.tierDisplayName : licenseSvc.licenseStatus === 'trial' ? 'Trial' : 'Expired' }}
          span.menu-license-detail(*ngIf='licenseSvc.licenseStatus === "trial"') {{ licenseSvc.trialDaysRemaining }} days remaining
          span.menu-license-detail(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.licenseExpiry') Expires: {{ licenseSvc.formattedExpiry }}
        .menu-sep
        button.menu-item(type='button', (click)='showLicenseDialog = true; closeMenus()')
          span.mi-icon 🔑
          span.mi-label Activate License
        button.menu-item(type='button', (click)='toggleAdminPanel(); closeMenus()')
          span.mi-icon ⚙
          span.mi-label License Details
          span.mi-shortcut ⌃⇧L
        .menu-sep
        button.menu-item(
          type='button',
          [disabled]='licenseSvc.licenseStatus !== "active"',
          (click)='onDeactivateLicense(); closeMenus()'
        )
          span.mi-icon ✕
          span.mi-label Deactivate License
        button.menu-item(type='button', (click)='showServerSettings = true; serverUrlInput = licenseSvc.licenseServerUrl; serverReachable = null; closeMenus()')
          span.mi-icon 🌐
          span.mi-label Server Settings
        .menu-sep
        button.menu-item(type='button', (click)='closeMenus()')
          a.menu-link(href='https://tlink.io/pricing', target='_blank')
            span.mi-icon 🛒
            span.mi-label Buy License

    //- ── Help ─────────────────────────────
    .menu-item-wrap
      button.menu-trigger(
        type='button',
        [class.active]='openMenu === "help"',
        (click)='toggleMenu("help")',
        (mouseenter)='onMenuEnter("help")'
      ) Help
      .menu-dropdown(*ngIf='openMenu === "help"')
        button.menu-item(type='button', (click)='toggleHelpPanel(); closeMenus()')
          span.mi-icon ?
          span.mi-label Help Panel
          span.mi-shortcut F1
        button.menu-item(type='button', (click)='startTour(); closeMenus()')
          span.mi-icon ◎
          span.mi-label Take a Tour
        button.menu-item(type='button', (click)='showShortcutsOverlay = !showShortcutsOverlay; closeMenus()')
          span.mi-icon ⌨
          span.mi-label Keyboard Shortcuts
          span.mi-shortcut ?
        .menu-sep
        button.menu-item(type='button', (click)='showWelcomeDialog = true; closeMenus()')
          span.mi-icon ⬡
          span.mi-label Welcome Screen

  .netops-workspace(
    (dragenter)='onShellDragEnter($event)',
    (dragleave)='onShellDragLeave($event)',
    (dragover)='$event.preventDefault()',
    (drop)='onShellDrop($event)'
  )
    //- ── File drag-and-drop overlay ──────────────────────────────────────────
    .file-drop-overlay(*ngIf='fileDragOver')
      .file-drop-content
        .file-drop-icon 📂
        .file-drop-text Drop file to load
        .file-drop-hint .json, .topo.json, or image (PNG, JPG, SVG, GIF)
    //- ── Palette ─────────────────────────────────────────────────────────
    .netops-palette(
      *ngIf='!paletteCollapsed',
      [style.width.px]='paletteWidth'
    )
      //- ── Search filter ──
      .palette-search
        input.palette-search-input(
          type='text',
          placeholder='Filter…',
          [(ngModel)]='paletteFilter',
          (click)='$event.stopPropagation()'
        )
      //- ── Devices section (collapsible) ──
      .palette-section(*ngIf='!paletteFilter || "devices".includes(paletteFilter.toLowerCase()) || filteredNodeTypes.length')
        .palette-section-header((click)='paletteDevicesOpen = !paletteDevicesOpen', title='Network device types')
          span.section-arrow {{ paletteDevicesOpen ? '▾' : '▸' }}
          span Devices
        .palette-section-body(*ngIf='paletteDevicesOpen')
          .palette-item(
            *ngFor='let type of filteredNodeTypes',
            draggable='true',
            [title]='"Drag to add a " + meta[type].label',
            (dragstart)='onPaletteDragStart($event, type)'
          )
            .palette-icon([style.background]='meta[type].color', [style.border-color]='meta[type].borderColor')
              span([style.color]='meta[type].textColor') {{ meta[type].label[0] }}
            .palette-label {{ meta[type].label }}

      //- ── Shapes section (collapsible) ──
      .palette-section(*ngIf='!paletteFilter || "shapes".includes(paletteFilter.toLowerCase()) || filteredShapes.length')
        .palette-section-header((click)='paletteShapesOpen = !paletteShapesOpen', title='Annotation shapes for diagrams')
          span.section-arrow {{ paletteShapesOpen ? '▾' : '▸' }}
          span Shapes
        .palette-section-body(*ngIf='paletteShapesOpen')
          .palette-item.palette-shape-item(
            *ngFor='let s of allShapes',
            [attr.draggable]='true',
            [title]='"Drag to add a " + s.label',
            (dragstart)='onShapeDragStart($event, s.type)'
          )
            .palette-icon.shape-icon
              span {{ s.icon }}
          .palette-item.palette-shape-item(
            title='Click to insert an image',
            (click)='insertImageFromPalette()'
          )
            .palette-icon.shape-icon
              span 🖼

      //- ── Templates section (collapsible) ──
      .palette-section(*ngIf='!paletteFilter || "templates".includes(paletteFilter.toLowerCase()) || filteredTemplates.length')
        .palette-section-header((click)='paletteTemplatesOpen = !paletteTemplatesOpen', title='Pre-built topology templates')
          span.section-arrow {{ paletteTemplatesOpen ? '▾' : '▸' }}
          span Templates
        .palette-section-body.compact-body(*ngIf='paletteTemplatesOpen')
          .palette-template(
            *ngFor='let tmpl of filteredTemplates',
            [attr.draggable]='true',
            (dragstart)='onTemplateDragStart($event, tmpl.id)',
            (click)='applyShapeTemplate(tmpl.id)',
            (mouseenter)='hoveredTemplate = tmpl.id',
            (mouseleave)='hoveredTemplate = null'
          )
            span.tmpl-icon {{ tmpl.icon }}
            span.tmpl-name {{ tmpl.name }}
            //- Hover preview tooltip
            .tmpl-preview(*ngIf='hoveredTemplate === tmpl.id')
              .tmpl-preview-title {{ tmpl.name }}
              .tmpl-preview-desc {{ tmpl.desc }}
    .palette-resize-handle(
      *ngIf='!paletteCollapsed',
      [class.dragging]='_paletteResizing',
      (mousedown)='onPaletteResizeStart($event)',
      title='Drag to resize palette'
    )
      .palette-width-badge(*ngIf='_paletteResizing') {{ paletteWidth }}px
    button.palette-toggle(type='button', (click)='paletteCollapsed = !paletteCollapsed', [title]='paletteCollapsed ? "Expand palette" : "Collapse palette"')
      | {{ paletteCollapsed ? '▸' : '◂' }}

    //- ── Canvas + Properties sidebar ────────────────────────────────────
    .netops-canvas-and-props
      .netops-canvas-wrap(
        style='position:relative',
        [class.is-panning]='isPanning',
        [class.is-link-mode]='linkModeActive',
        (dragover)='onCanvasDragOver($event)',
        (drop)='onCanvasDrop($event)',
        (click)='onBgClick()',
        (contextmenu)='onCanvasRightClick($event)',
        (mousedown)='onBgMouseDown($event)',
        (wheel)='onWheel($event)'
      )
        //- ── Link mode banner (absolute overlay) ───────────────────────
        .link-mode-banner(*ngIf='linkModeActive', (click)='$event.stopPropagation()')
          span.link-mode-banner-icon ⤢
          span.link-mode-banner-text  Link Mode
          span.link-mode-banner-hint  — drag between nodes, or click a node for port picker
          button.link-mode-banner-exit(type='button', (click)='toggleLinkMode()') ✕ Exit

        //- ── Canvas view toggle bar ──────────────────────────────────
        .canvas-view-bar(*ngIf='topology?.nodes?.length > 0')
          button.view-bar-btn(
            type='button',
            [class.active]='showIpLabels',
            (click)='toggleIpVisibility()',
            title='Show IP Labels'
          ) IP
          button.view-bar-btn(
            type='button',
            [class.active]='showInterfaceLabels',
            (click)='toggleInterfaceLabels()',
            title='Show Interface Labels'
          ) Intf
          button.view-bar-btn(
            type='button',
            [class.active]='showIpv6Labels',
            (click)='showIpv6Labels = !showIpv6Labels; cdr.markForCheck()',
            title='Show IPv6 Labels'
          ) IPv6
          .view-bar-sep
          button.view-bar-btn(
            type='button',
            [class.active]='showVlanView',
            (click)='toggleVlanView()',
            title='VLAN View'
          ) VLAN
          button.view-bar-btn(
            type='button',
            [class.active]='showBgpView',
            (click)='toggleBgpView()',
            title='BGP View'
          ) BGP
          button.view-bar-btn(
            type='button',
            [class.active]='showTrafficFlowView',
            (click)='toggleTrafficFlowView()',
            title='Traffic Flows'
          ) Flows
          .view-bar-sep
          button.view-bar-btn(
            type='button',
            [class.active]='showRouteView',
            (click)='toggleRouteView()',
            title='Route Table'
          ) Routes
          button.view-bar-btn(
            type='button',
            [class.active]='showCounterView',
            (click)='toggleCounterView()',
            title='Interface Counters'
          ) Counters
          .view-bar-sep
          button.view-bar-btn(
            type='button',
            [class.active]='showMinimap',
            (click)='showMinimap = !showMinimap; cdr.markForCheck()',
            title='Minimap'
          ) Map

        //- ── Minimap overlay ──────────────────────────────────────────
        svg.canvas-minimap(
          *ngIf='showMinimap && topology?.nodes?.length > 0',
          [attr.viewBox]='minimapViewBox',
          [attr.width]='MINIMAP_W',
          [attr.height]='MINIMAP_H',
          (click)='onMinimapClick($event)',
          (mousedown)='$event.stopPropagation()'
        )
          rect.minimap-bg(width='100%', height='100%')
          line.minimap-link(
            *ngFor='let link of topology?.links; trackBy: trackById',
            [attr.x1]='nodeCx(getNodeById(link.sourceNodeId))',
            [attr.y1]='nodeCy(getNodeById(link.sourceNodeId))',
            [attr.x2]='nodeCx(getNodeById(link.targetNodeId))',
            [attr.y2]='nodeCy(getNodeById(link.targetNodeId))'
          )
          rect.minimap-node(
            *ngFor='let n of topology?.nodes; trackBy: trackById',
            [attr.x]='n.x',
            [attr.y]='n.y',
            [attr.width]='nw',
            [attr.height]='nh',
            rx='4'
          )
          rect.minimap-viewport(
            [attr.x]='minimapViewport.x',
            [attr.y]='minimapViewport.y',
            [attr.width]='minimapViewport.w',
            [attr.height]='minimapViewport.h'
          )

        //- ── Zoom controls floating toolbar ──────────────────────────
        .zoom-controls(
          (mousedown)='$event.stopPropagation()',
          (click)='$event.stopPropagation()'
        )
          button.zoom-ctrl-btn(type='button', (click)='zoomIn()', title='Zoom In') +
          button.zoom-ctrl-btn(type='button', (click)='zoomOut()', title='Zoom Out') −
          .zoom-ctrl-pct {{ zoomPercent }}%
          button.zoom-ctrl-btn(type='button', (click)='resetView()', title='Reset to 100%') 1:1
          button.zoom-ctrl-btn(type='button', (click)='zoomFit()', title='Fit All') ⊞

        //- ── Align & distribute toolbar (multi-shape selection) ──────
        .align-toolbar(*ngIf='showAlignToolbar')
          button.align-btn(type='button', title='Align Left', (click)='alignShapes("left")') ⫍
          button.align-btn(type='button', title='Align Center', (click)='alignShapes("center")') ⫿
          button.align-btn(type='button', title='Align Right', (click)='alignShapes("right")') ⫎
          .align-sep
          button.align-btn(type='button', title='Align Top', (click)='alignShapes("top")') ⊤
          button.align-btn(type='button', title='Align Middle', (click)='alignShapes("middle")') ⊞
          button.align-btn(type='button', title='Align Bottom', (click)='alignShapes("bottom")') ⊥
          .align-sep
          button.align-btn(type='button', title='Distribute Horizontally', (click)='distributeShapes("horizontal")') ⇔
          button.align-btn(type='button', title='Distribute Vertically', (click)='distributeShapes("vertical")') ⇕

        svg#svgCanvas.netops-svg(#svgCanvas='')
          defs
            pattern([attr.id]='uid + "-grid"', [attr.width]='gridCellSize', [attr.height]='gridCellSize', patternUnits='userSpaceOnUse')
              path([attr.d]='"M " + gridCellSize + " 0 L 0 0 0 " + gridCellSize', fill='none', stroke='#1e2a3a', stroke-width='0.5')
            pattern([attr.id]='uid + "-bigGrid"', [attr.width]='gridMajorSize', [attr.height]='gridMajorSize', patternUnits='userSpaceOnUse')
              path([attr.d]='"M " + gridMajorSize + " 0 L 0 0 0 " + gridMajorSize', fill='none', stroke='#1e3048', stroke-width='1')
              rect([attr.width]='gridMajorSize', [attr.height]='gridMajorSize', [attr.fill]='"url(#" + uid + "-grid)"')
              path([attr.d]='"M " + gridMajorSize + " 0 L 0 0 0 " + gridMajorSize', fill='none', stroke='#1e3048', stroke-width='1')
            marker([attr.id]='uid + "-arrow"', markerWidth='8', markerHeight='8', refX='6', refY='3', orient='auto')
              path(d='M0,0 L0,6 L8,3 z', fill='#4a6fa5')
            marker([attr.id]='uid + "-shape-arrow"', markerWidth='4', markerHeight='4', refX='3.5', refY='2', orient='auto', markerUnits='strokeWidth')
              path(d='M0,0 L0,4 L4,2 z', fill='#3b82f6', opacity='0.8')
            marker([attr.id]='uid + "-shape-arrow-hover"', markerWidth='4', markerHeight='4', refX='3.5', refY='2', orient='auto', markerUnits='strokeWidth')
              path(d='M0,0 L0,4 L4,2 z', fill='#60a5fa', opacity='0.9')
            marker([attr.id]='uid + "-shape-arrow-start"', markerWidth='4', markerHeight='4', refX='0.5', refY='2', orient='auto', markerUnits='strokeWidth')
              path(d='M4,0 L4,4 L0,2 z', fill='#3b82f6', opacity='0.8')
            filter#sketched-filter
              feTurbulence(type='turbulence', baseFrequency='0.03', numOctaves='3', result='noise', seed='2')
              feDisplacementMap(in='SourceGraphic', in2='noise', scale='2', xChannelSelector='R', yChannelSelector='G')
            filter([attr.id]='uid + "-glow"')
              feGaussianBlur(stdDeviation='3', result='coloredBlur')
              feMerge
                feMergeNode(in='coloredBlur')
                feMergeNode(in='SourceGraphic')

          rect(width='100%', height='100%', [attr.fill]='showGrid ? "url(#" + uid + "-bigGrid)" : "#0a0f18"')

          g([attr.transform]='vpTransform')
            //- ── Links ────────────────────────────────────────────────────
            g.links-layer
              g.link-group(
                *ngFor='let link of visibleLinks; trackBy: trackById',
                [class.selected]='isLinkSelected(link.id)',
                [class.vlan-trunk]='showVlanView && linkVlanMode(link) === "trunk"',
                [class.vlan-access]='showVlanView && linkVlanMode(link) === "access"',
                [class.vlan-none]='showVlanView && linkVlanMode(link) === "none"',
                [class.bgp-ebgp]='showBgpView && linkBgpMode(link) === "ebgp"',
                [class.bgp-ibgp]='showBgpView && linkBgpMode(link) === "ibgp"',
                [class.bgp-none]='showBgpView && linkBgpMode(link) === "none"',
                (click)='onLinkClick($event, link)',
                (contextmenu)='onLinkRightClick($event, link)',
                (mouseenter)='hoveredLinkId = link.id',
                (mouseleave)='hoveredLinkId = null'
              )
                path.link-path(
                  [attr.d]='linkPath(link)',
                  [class.link-selected]='isLinkSelected(link.id)',
                  [class.link-down]='link.status === "down"',
                  [class.sim-failed]='isLinkSimFailed(link.id)',
                  [class.alarm-link-highlight]='showAlarmOverlay && linkAlarmOverlayColor(link)',
                  [style.stroke]='link.linkColor || (isLinkSelected(link.id) ? null : (showAlarmOverlay && linkAlarmOverlayColor(link) ? linkAlarmOverlayColor(link) : (livePollingActive && linkLiveColor(link) ? linkLiveColor(link) : (showTrafficFlowView && linkFlowColor(link) ? linkFlowColor(link) : (showBgpView ? linkBgpColor(link) : (showVlanView ? linkVlanColor(link) : linkQualityColor(link)))))))',
                  [style.stroke-width]='link.linkWidth || null',
                  [style.stroke-dasharray]='link.linkDash || null',
                  [class.sketched]='link.sketched',
                  [attr.marker-end]='link.showArrow ? "url(#" + uid + "-shape-arrow)" : null',
                  [attr.marker-start]='link.arrowStart ? "url(#" + uid + "-shape-arrow-start)" : null'
                )
                path.link-hit(
                  fill='none',
                  [attr.d]='linkPath(link)'
                )
                text.link-label(
                  *ngIf='showInterfaceLabels',
                  text-anchor='middle',
                  [attr.x]='linkMidpoint(link).x',
                  [attr.y]='linkMidpoint(link).y'
                ) {{ linkLabel(link) }}
                text.link-ip-label(
                  *ngIf='showIpLabels && (portIp(link.sourceNodeId, link.sourcePortId) || portIp(link.targetNodeId, link.targetPortId))',
                  text-anchor='middle',
                  [attr.x]='linkMidpoint(link).x',
                  [attr.y]='linkMidpoint(link).y + 10'
                ) {{ linkIpLabel(link) }}
                //- IPv6 address label on link
                text.link-ipv6-label(
                  *ngIf='showIpv6Labels && (portIpv6(link.sourceNodeId, link.sourcePortId) || portIpv6(link.targetNodeId, link.targetPortId))',
                  text-anchor='middle',
                  [attr.x]='linkMidpoint(link).x',
                  [attr.y]='linkMidpoint(link).y + (showIpLabels ? 22 : 10)'
                ) {{ linkIpv6Label(link) }}
                //- VLAN overlay label on link
                text.link-vlan-label(
                  *ngIf='showVlanView && linkVlanLabel(link)',
                  text-anchor='middle',
                  [attr.x]='linkMidpoint(link).x',
                  [attr.y]='linkMidpoint(link).y + (showIpLabels ? 22 : 12)'
                ) {{ linkVlanLabel(link) }}
                //- BGP overlay label on link
                text.link-bgp-label(
                  *ngIf='showBgpView && linkBgpLabel(link)',
                  text-anchor='middle',
                  [attr.x]='linkMidpoint(link).x',
                  [attr.y]='linkMidpoint(link).y + (showIpLabels ? 22 : 12)'
                ) {{ linkBgpLabel(link) }}
                //- Live BGP session state label on link
                text.link-bgp-live-label(
                  *ngIf='livePollingActive && linkBgpLiveLabel(link)',
                  text-anchor='middle',
                  [attr.x]='linkMidpoint(link).x',
                  [attr.y]='linkMidpoint(link).y + (showIpLabels ? 34 : (showBgpView ? 24 : 14))'
                ) {{ linkBgpLiveLabel(link) }}
                //- Traffic flow name label on link
                text.link-flow-label(
                  *ngIf='showTrafficFlowView && linkFlowLabel(link)',
                  text-anchor='middle',
                  [attr.x]='linkMidpoint(link).x',
                  [attr.y]='linkMidpoint(link).y + (showIpLabels ? 34 : 14)'
                ) {{ linkFlowLabel(link) }}
                //- Labels moved to overlay layer (above annotations)
                //- ── Bend handle (shown when link is selected) ────────────
                circle.link-bend-handle(
                  *ngIf='isLinkSelected(link.id)',
                  [attr.cx]='linkMidpoint(link).x',
                  [attr.cy]='linkMidpoint(link).y',
                  r='5',
                  (mousedown)='onLinkHandleMouseDown($event, link)'
                )
                //- Endpoint handles moved to overlay layer (below)

            //- ── Traffic flow path overlay (animated dashes) ──────────────
            g.flow-overlay-layer(*ngIf='showTrafficFlowView && computedFlowPaths.length')
              ng-container(*ngFor='let fp of computedFlowPaths; trackBy: trackFlowPath')
                ng-container(*ngIf='!fp.broken')
                  path.flow-path.flow-animated(
                    *ngFor='let linkId of fp.linkIds',
                    [attr.d]='linkPath(getLinkById(linkId))',
                    [style.stroke]='getFlowColor(fp.flowId)'
                  )

            //- ── Failure simulation X markers on links ──────────────────
            g.sim-fail-link-markers(*ngIf='hasSimulatedFailures')
              ng-container(*ngFor='let link of visibleLinks; trackBy: trackById')
                g.sim-fail-link-x(
                  *ngIf='isLinkSimFailed(link.id)',
                  [attr.transform]='"translate(" + linkMidpoint(link).x + "," + linkMidpoint(link).y + ")"'
                )
                  line(x1='-6', y1='-6', x2='6', y2='6', stroke='#ef4444', stroke-width='2.5')
                  line(x1='6', y1='-6', x2='-6', y2='6', stroke='#ef4444', stroke-width='2.5')

            //- ── Pending rubber-band link ─────────────────────────────────
            path.pending-link(
              *ngIf='hasPendingPath',
              [attr.d]='pendingPath()'
            )

            //- ── Nodes ────────────────────────────────────────────────────
            g.nodes-layer
              g.node-group(
                *ngFor='let node of visibleNodes; trackBy: trackById',
                [attr.transform]='"translate(" + node.x + "," + node.y + ")"',
                [class.selected]='isNodeSelected(node.id)',
                [class.link-mode-target]='linkModeActive',
                [class.sim-failed]='isNodeSimFailed(node.id)',
                [class.is-dragging]='_dragNode?.id === node.id',
                (mousedown)='onNodeMouseDown($event, node)',
                (mouseup)='onNodeMouseUp($event, node)',
                (click)='onNodeClick($event, node)',
                (contextmenu)='onNodeRightClick($event, node)'
              )
                rect.node-shadow(
                  rx='10', ry='10', x='4', y='4',
                  [attr.width]='nodeW(node)', [attr.height]='nodeH(node)'
                )
                rect.node-body(
                  rx='10', ry='10',
                  [attr.width]='nodeW(node)',
                  [attr.height]='nodeH(node)',
                  [style.fill]='meta[node.type].color',
                  [style.stroke]='meta[node.type].borderColor',
                  [class.node-selected]='isNodeSelected(node.id)',
                  [class.node-infra]='node.type === "host" || node.type === "bridge"',
                  [style.filter]='isNodeSelected(node.id) ? "url(#" + uid + "-glow)" : null'
                )
                circle.node-status(
                  [attr.cy]='10', r='5',
                  [attr.cx]='nodeW(node) - 10',
                  [class.status-running]='node.status === "running"',
                  [class.status-suspended]='node.status === "suspended"'
                )
                circle.node-mapped(
                  *ngIf='node.mapped',
                  cx='10', cy='10', r='5',
                  [attr.title]='"Mapped by " + (node.mappedBy ?? "inventory")'
                )
                text.node-mapped-label(
                  *ngIf='node.mapped',
                  x='10', y='13',
                  text-anchor='middle'
                ) M
                text.node-type-icon(
                  text-anchor='middle',
                  dominant-baseline='middle',
                  [attr.x]='nodeW(node) / 2',
                  [attr.y]='nodeH(node) / 2 - 8',
                  [style.fill]='meta[node.type].textColor',
                  [style.font-size]='nodeW(node) < 70 ? "20px" : null'
                ) {{ meta[node.type].label[0] }}
                ng-container(*ngIf='renamingId !== node.id')
                  text.node-label(
                    text-anchor='middle',
                    [attr.x]='nodeW(node) / 2',
                    [attr.y]='nodeH(node) / 2 + 12',
                    [style.fill]='meta[node.type].textColor',
                    [style.font-size]='nodeW(node) < 70 ? "9px" : null'
                  ) {{ node.label }}
                foreignObject(
                  x='4',
                  height='22',
                  *ngIf='renamingId === node.id',
                  [attr.y]='nodeH(node) / 2 + 4',
                  [attr.width]='nodeW(node) - 8'
                )
                  input.rename-input(
                    xmlns='http://www.w3.org/1999/xhtml',
                    [(ngModel)]='renamingLabel',
                    (blur)='commitRename()',
                    (keydown)='onRenameKey($event)',
                    (click)='$event.stopPropagation()'
                  )
                text.node-type-chip(
                  text-anchor='middle',
                  [attr.x]='nodeW(node) / 2',
                  [attr.y]='nodeH(node) - 6',
                  [style.font-size]='nodeW(node) < 70 ? "6px" : null'
                ) {{ meta[node.type].label }}
                //- Resize handles (visible on selected node, not in link mode)
                ng-container(*ngIf='isNodeSelected(node.id) && !linkModeActive')
                  circle.node-resize-handle(
                    cx='0', cy='0', r='4',
                    (mousedown)='onNodeResizeStart($event, node, "nw")'
                  )
                  circle.node-resize-handle(
                    [attr.cx]='nodeW(node)', cy='0', r='4',
                    (mousedown)='onNodeResizeStart($event, node, "ne")'
                  )
                  circle.node-resize-handle(
                    cx='0', [attr.cy]='nodeH(node)', r='4',
                    (mousedown)='onNodeResizeStart($event, node, "sw")'
                  )
                  circle.node-resize-handle(
                    [attr.cx]='nodeW(node)', [attr.cy]='nodeH(node)', r='4',
                    (mousedown)='onNodeResizeStart($event, node, "se")'
                  )
                //- VLAN count badge (shown when VLAN view is active and node has VLANs)
                svg:g.node-vlan-badge(*ngIf='showVlanView && nodeVlanCount(node) > 0')
                  svg:rect(
                    [attr.x]='nw - 18', y='-6',
                    width='24', height='14', rx='7',
                    fill='#3b82f6'
                  )
                  svg:text(
                    text-anchor='middle',
                    [attr.x]='nw - 6', y='5',
                    fill='#fff', font-size='9', font-weight='600'
                  ) V{{ nodeVlanCount(node) }}
                //- ASN badge (shown when BGP view is active and node has an ASN)
                svg:g.node-asn-badge(*ngIf='showBgpView && node.asn')
                  svg:rect(
                    x='-6', y='-6',
                    [attr.width]='nodeAsnLabel(node).length * 6 + 12',
                    height='14', rx='7',
                    fill='#10b981'
                  )
                  svg:text(
                    text-anchor='middle',
                    [attr.x]='(nodeAsnLabel(node).length * 6 + 12) / 2 - 6',
                    y='5',
                    fill='#fff', font-size='8', font-weight='600'
                  ) {{ nodeAsnLabel(node) }}
                //- Alarm overlay border (shown when alarm overlay is active)
                rect.node-alarm-border(
                  *ngIf='showAlarmOverlay && nodeHasAlarm(node.id)',
                  rx='12', ry='12',
                  x='-3', y='-3',
                  [attr.width]='nw + 6',
                  [attr.height]='nh + 6',
                  fill='none',
                  [attr.stroke]='nodeAlarmColor(node.id)',
                  stroke-width='3',
                  [class.alarm-pulse]='invSvc.nodeAlarmSeverity(node.id) === "critical"'
                )
                //- Alarm indicator dot (shown when node has active alarms)
                svg:g.node-alarm-dot(*ngIf='nodeHasAlarm(node.id)')
                  svg:circle(
                    [attr.cx]='nw + 2', cy='-2', r='6',
                    [attr.fill]='nodeAlarmColor(node.id)'
                  )
                  svg:text(
                    text-anchor='middle',
                    [attr.x]='nw + 2', y='1',
                    fill='#fff', font-size='7', font-weight='700'
                  ) !
                //- Service endpoint stub (free ports with configured VLAN mode)
                svg:g.node-endpoint-stub(*ngIf='nodeStubMap.has(node.id)')
                  svg:line(
                    [attr.x1]='nw / 2',
                    [attr.y1]='nh',
                    [attr.x2]='nw / 2',
                    [attr.y2]='nh + 30',
                    [class.endpoint-stub-access]='nodeStubMap.get(node.id).mode === "access"',
                    [class.endpoint-stub-trunk]='nodeStubMap.get(node.id).mode === "trunk"'
                  )
                  svg:rect.endpoint-box(
                    [attr.x]='nw / 2 - 12',
                    [attr.y]='nh + 30',
                    width='24', height='14', rx='3'
                  )
                  svg:text.endpoint-count(
                    text-anchor='middle',
                    [attr.x]='nw / 2',
                    [attr.y]='nh + 40'
                  ) {{ nodeStubMap.get(node.id).count }}
                  svg:text.endpoint-label(
                    text-anchor='middle',
                    [attr.x]='nw / 2',
                    [attr.y]='nh + 56'
                  ) {{ nodeStubMap.get(node.id).label }}
                //- Failure simulation X overlay
                svg:g.sim-fail-marker(*ngIf='isNodeSimFailed(node.id)')
                  svg:line(
                    [attr.x1]='nw / 2 - 12', [attr.y1]='nh / 2 - 12',
                    [attr.x2]='nw / 2 + 12', [attr.y2]='nh / 2 + 12',
                    stroke='#ef4444', stroke-width='3'
                  )
                  svg:line(
                    [attr.x1]='nw / 2 + 12', [attr.y1]='nh / 2 - 12',
                    [attr.x2]='nw / 2 - 12', [attr.y2]='nh / 2 + 12',
                    stroke='#ef4444', stroke-width='3'
                  )

            //- ── Annotations & Shapes layer ──────────────────────────────
            g.annotations-layer
              //- ── All shapes (rendered BELOW text annotations) ────
              ng-container(*ngFor='let ann of visibleAnnotations; trackBy: trackById')
                g.shape-group(
                  *ngIf='isShapeType(ann.type)',
                  [attr.transform]='shapeTransform(ann)',
                  [class.shape-selected]='isShapeSelected(ann.id)',
                  [class.shape-locked]='ann.locked',
                  (mouseenter)='onShapeMouseEnter(ann)',
                  (mouseleave)='onShapeMouseLeave(ann)'
                )
                  //- Rectangle
                  rect.shape-rect(
                    *ngIf='ann.type === "rectangle"',
                    x='0', y='0',
                    [attr.width]='ann.width',
                    [attr.height]='ann.height',
                    [attr.rx]='ann.cornerRadius ?? 10',
                    [attr.ry]='ann.cornerRadius ?? 10',
                    [style.fill]='ann.fillColor ?? "#0f2744"',
                    [style.stroke]='ann.strokeColor ?? "#3b82f6"',
                    [style.stroke-width]='ann.strokeWidth ?? 1.5',
                    [style.opacity]='ann.opacity ?? 0.85',
                    (mousedown)='onShapeMouseDown($event, ann)',
                    (click)='$event.stopPropagation()',
                    (dblclick)='onShapeDblClick($event, ann)',
                    (contextmenu)='onShapeRightClick($event, ann)'
                  )
                  //- Circle / Ellipse
                  ellipse.shape-rect(
                    *ngIf='ann.type === "circle"',
                    [attr.cx]='ann.width / 2',
                    [attr.cy]='ann.height / 2',
                    [attr.rx]='ann.width / 2',
                    [attr.ry]='ann.height / 2',
                    [style.fill]='ann.fillColor ?? "#0f2744"',
                    [style.stroke]='ann.strokeColor ?? "#3b82f6"',
                    [style.stroke-width]='ann.strokeWidth ?? 1.5',
                    [style.opacity]='ann.opacity ?? 0.85',
                    (mousedown)='onShapeMouseDown($event, ann)',
                    (click)='$event.stopPropagation()',
                    (dblclick)='onShapeDblClick($event, ann)',
                    (contextmenu)='onShapeRightClick($event, ann)'
                  )
                  //- Image
                  image.shape-rect(
                    *ngIf='ann.type === "image" && ann.imageData',
                    x='0', y='0',
                    [attr.width]='ann.width',
                    [attr.height]='ann.height',
                    [attr.href]='ann.imageData',
                    preserveAspectRatio='xMidYMid meet',
                    [style.opacity]='ann.opacity ?? 1',
                    (mousedown)='onShapeMouseDown($event, ann)',
                    (click)='$event.stopPropagation()',
                    (dblclick)='onShapeDblClick($event, ann)',
                    (contextmenu)='onShapeRightClick($event, ann)'
                  )
                  //- Generic path shapes (diamond, triangle, star, hexagon, parallelogram, cylinder, cloud, arrow, line)
                  path.shape-rect(
                    *ngIf='ann.type !== "rectangle" && ann.type !== "circle" && ann.type !== "image" && shapePathD(ann)',
                    [attr.d]='shapePathD(ann)',
                    [style.fill]='ann.fillColor ?? "#0f2744"',
                    [style.stroke]='ann.strokeColor ?? "#3b82f6"',
                    [style.stroke-width]='ann.strokeWidth ?? 1.5',
                    [style.opacity]='ann.opacity ?? 0.85',
                    (mousedown)='onShapeMouseDown($event, ann)',
                    (click)='$event.stopPropagation()',
                    (dblclick)='onShapeDblClick($event, ann)',
                    (contextmenu)='onShapeRightClick($event, ann)'
                  )
                  //- Cylinder top ellipse (extra visual)
                  path.shape-rect-extra(
                    *ngIf='ann.type === "cylinder"',
                    [attr.d]='cylinderTopD(ann)',
                    [style.fill]='ann.fillColor ?? "#0f2744"',
                    [style.stroke]='ann.strokeColor ?? "#3b82f6"',
                    [style.stroke-width]='ann.strokeWidth ?? 1.5',
                    [style.opacity]='ann.opacity ?? 0.85',
                    style='pointer-events:none'
                  )
                  //- Label inside rectangle
                  foreignObject.shape-label-fo(
                    *ngIf='(ann.label || ann.text) && editingShapeId !== ann.id',
                    x='4', y='4',
                    [attr.width]='ann.width - 8',
                    [attr.height]='ann.height - 8',
                    style='pointer-events:none; overflow:visible'
                  )
                    div.shape-label-wrap(
                      xmlns='http://www.w3.org/1999/xhtml',
                      [style.color]='shapeLabelColor(ann)'
                    ) {{ ann.label || ann.text }}
                  //- Inline label edit
                  foreignObject(
                    *ngIf='editingShapeId === ann.id',
                    x='4', y='4',
                    [attr.width]='ann.width - 8',
                    [attr.height]='ann.height - 8'
                  )
                    textarea.shape-label-input(
                      xmlns='http://www.w3.org/1999/xhtml',
                      [(ngModel)]='editingShapeLabel',
                      (blur)='commitShapeLabelEdit()',
                      (keydown.escape)='commitShapeLabelEdit()',
                      (click)='$event.stopPropagation()',
                      (mousedown)='$event.stopPropagation()'
                    )
                  //- Lock icon (shown on locked shapes)
                  g.shape-lock-icon(*ngIf='ann.locked', style='pointer-events:none')
                    circle(
                      [attr.cx]='ann.width - 8',
                      cy='8',
                      r='8',
                      fill='rgba(0,0,0,0.6)',
                      stroke='#f59e0b',
                      stroke-width='1'
                    )
                    text.lock-icon-text(
                      [attr.x]='ann.width - 8',
                      y='12',
                      text-anchor='middle',
                      fill='#f59e0b',
                      font-size='10'
                    ) 🔒
                  //- Edge hit zone: invisible bounding rect for drag-to-connect (works for all shapes)
                  rect.shape-edge-zone(
                    x='-8', y='-8',
                    [attr.width]='ann.width + 16',
                    [attr.height]='(ann.height < 20 ? 36 : ann.height + 16)',
                    (mousedown)='onEdgeZoneMouseDown($event, ann)',
                    (mousemove)='onEdgeZoneMouseMove($event, ann)',
                    (mouseleave)='clearEdgeHover()',
                    (click)='$event.stopPropagation()'
                  )
                  //- Follower dot: shows where on the edge the connection will start
                  circle.shape-edge-dot(
                    *ngIf='_edgeHoverAnnId === ann.id && _edgeHoverPos',
                    [attr.cx]='_edgeHoverPos.x - ann.x',
                    [attr.cy]='_edgeHoverPos.y - ann.y',
                    r='5',
                    style='pointer-events: none'
                  )
                  //- Resize handles (visible when selected and not locked, rendered AFTER edge zone so they sit on top)
                  ng-container(*ngIf='isShapeSelected(ann.id) && !ann.locked')
                    circle.shape-handle(
                      cx='0', cy='0', r='5',
                      (mousedown)='onShapeResizeStart($event, ann, "nw")',
                      (click)='$event.stopPropagation()'
                    )
                    circle.shape-handle(
                      [attr.cx]='ann.width', cy='0', r='5',
                      (mousedown)='onShapeResizeStart($event, ann, "ne")',
                      (click)='$event.stopPropagation()'
                    )
                    circle.shape-handle(
                      cx='0', [attr.cy]='ann.height', r='5',
                      (mousedown)='onShapeResizeStart($event, ann, "sw")',
                      (click)='$event.stopPropagation()'
                    )
                    circle.shape-handle(
                      [attr.cx]='ann.width', [attr.cy]='ann.height', r='5',
                      (mousedown)='onShapeResizeStart($event, ann, "se")',
                      (click)='$event.stopPropagation()'
                    )
                    //- Edge midpoint handles
                    circle.shape-handle.edge-handle(
                      [attr.cx]='ann.width / 2', cy='0', r='4',
                      (mousedown)='onShapeResizeStart($event, ann, "n")',
                      (click)='$event.stopPropagation()'
                    )
                    circle.shape-handle.edge-handle(
                      [attr.cx]='ann.width / 2', [attr.cy]='ann.height', r='4',
                      (mousedown)='onShapeResizeStart($event, ann, "s")',
                      (click)='$event.stopPropagation()'
                    )
                    circle.shape-handle.edge-handle(
                      cx='0', [attr.cy]='ann.height / 2', r='4',
                      (mousedown)='onShapeResizeStart($event, ann, "w")',
                      (click)='$event.stopPropagation()'
                    )
                    circle.shape-handle.edge-handle(
                      [attr.cx]='ann.width', [attr.cy]='ann.height / 2', r='4',
                      (mousedown)='onShapeResizeStart($event, ann, "e")',
                      (click)='$event.stopPropagation()'
                    )
                    //- Rotation handle
                    line.rotation-line(
                      [attr.x1]='ann.width / 2', y1='-4',
                      [attr.x2]='ann.width / 2', y2='-22'
                    )
                    circle.rotation-handle(
                      [attr.cx]='ann.width / 2', cy='-24', r='5',
                      (mousedown)='onRotationStart($event, ann)',
                      (click)='$event.stopPropagation()'
                    )

              //- ── Text annotations (original behavior) ──────────────────
              ng-container(*ngFor='let ann of visibleAnnotations; trackBy: trackById')
                g.annotation-group(
                  *ngIf='!isShapeType(ann.type)',
                  [attr.transform]='"translate(" + ann.x + "," + ann.y + ")"'
                )
                  foreignObject.annotation-fo(
                    x='0', y='0',
                    [attr.width]='ann.width',
                    [attr.height]='ann.height',
                    (mousedown)='onAnnotationMouseDown($event, ann)',
                    (dblclick)='onAnnotationDblClick($event, ann)'
                  )
                    div(xmlns='http://www.w3.org/1999/xhtml', style='width:100%;height:100%')
                      textarea.annotation-box(
                        *ngIf='editingAnnotationId === ann.id',
                        [class.is-editing]='true',
                        [(ngModel)]='editingAnnotationText',
                        (blur)='commitAnnotationEdit()',
                        (click)='$event.stopPropagation()'
                      )
                      div.annotation-box(
                        *ngIf='editingAnnotationId !== ann.id',
                        style='user-select:none'
                      ) {{ ann.text }}
                  text.annotation-delete(
                    [attr.x]='ann.width - 4',
                    y='-4',
                    text-anchor='end',
                    font-size='10',
                    fill='#4ade80',
                    style='cursor:pointer',
                    (click)='deleteAnnotation(ann.id); $event.stopPropagation()'
                  ) ✕

            //- ── Link endpoint handles overlay (above shapes so they are draggable) ──
            g.link-endpoint-overlay
              ng-container(*ngFor='let link of visibleLinks; trackBy: trackById')
                ng-container(*ngIf='(isLinkSelected(link.id) || hoveredLinkId === link.id) && (link.sourceAnnotationId || link.targetAnnotationId)')
                  circle.link-endpoint-handle(
                    *ngIf='link.sourceAnnotationId',
                    [attr.cx]='linkEndpointXY(link, "source").x',
                    [attr.cy]='linkEndpointXY(link, "source").y',
                    r='6',
                    (mousedown)='onLinkEndpointDragStart($event, link, "source")'
                  )
                  circle.link-endpoint-handle(
                    *ngIf='link.targetAnnotationId',
                    [attr.cx]='linkEndpointXY(link, "target").x',
                    [attr.cy]='linkEndpointXY(link, "target").y',
                    r='6',
                    (mousedown)='onLinkEndpointDragStart($event, link, "target")'
                  )

            //- ── Link interaction + labels overlay (above annotations) ──
            g.link-labels-overlay
              //- Hit areas for dblclick (add label) and click (select link) above annotations
              ng-container(*ngFor='let link of visibleLinks; trackBy: trackById')
                path.link-overlay-hit(
                  fill='none',
                  [attr.d]='linkPath(link)',
                  (click)='onLinkClick($event, link)',
                  (dblclick)='onLinkDblClick($event, link)',
                  (contextmenu)='onLinkRightClick($event, link)'
                )
              //- Labels
              ng-container(*ngFor='let link of visibleLinks; trackBy: trackById')
                ng-container(*ngFor='let lbl of getLinkLabels(link)')
                  g.link-label-drag-group(
                    *ngIf='editingLinkLabelId !== lbl.id',
                    (mousedown)='onLinkLabelDragStart($event, link, lbl)',
                    (contextmenu)='onLabelRightClick($event, link, lbl)',
                    style='cursor: grab'
                  )
                    rect.link-user-label-bg(
                      [attr.x]='labelPos(link, lbl).x - labelTextWidth(lbl) / 2 - 5',
                      [attr.y]='labelPos(link, lbl).y - (lbl.fontSize || 11) / 2 - 3',
                      [attr.width]='labelTextWidth(lbl) + 10',
                      [attr.height]='(lbl.fontSize || 11) + 6',
                      rx='4', ry='4'
                    )
                    text.link-user-label(
                      text-anchor='middle',
                      dominant-baseline='central',
                      [attr.x]='labelPos(link, lbl).x',
                      [attr.y]='labelPos(link, lbl).y',
                      [style.font-size.px]='lbl.fontSize || 11',
                      [style.font-weight]='lbl.fontWeight || "600"',
                      [attr.fill]='lbl.color || "#e2e8f0"',
                      style='pointer-events: none'
                    ) {{ lbl.text }}
                  foreignObject(
                    *ngIf='editingLinkLabelId === lbl.id',
                    [attr.x]='labelPos(link, lbl).x - 60',
                    [attr.y]='labelPos(link, lbl).y - 12',
                    width='120', height='24'
                  )
                    input.link-label-input(
                      xmlns='http://www.w3.org/1999/xhtml',
                      type='text',
                      [(ngModel)]='editingLinkLabelText',
                      (blur)='commitLinkLabelEdit()',
                      (keydown.enter)='commitLinkLabelEdit()',
                      (keydown.escape)='cancelLinkLabelEdit()',
                      (click)='$event.stopPropagation()',
                      (mousedown)='$event.stopPropagation()'
                    )

              //- Waypoint handles (visible when link selected/hovered)
              ng-container(*ngFor='let link of visibleLinks; trackBy: trackById')
                ng-container(*ngIf='(isLinkSelected(link.id) || hoveredLinkId === link.id) && link.waypoints?.length')
                  circle.waypoint-handle(
                    *ngFor='let wp of link.waypoints; let i = index',
                    [attr.cx]='wp.x',
                    [attr.cy]='wp.y',
                    r='5',
                    (mousedown)='onWaypointDragStart($event, link, i)',
                    (contextmenu)='onWaypointRightClick($event, link, i)'
                  )

            //- ── Tour demo pulsing green connectors ─────────────────────
            ng-container(*ngIf='tourDemoConnectors.length > 0')
              circle.tour-demo-dot(
                *ngFor='let dot of tourDemoConnectors',
                [attr.cx]='dot.x',
                [attr.cy]='dot.y',
                r='6'
              )

            //- ── Rubber band selection rectangle ─────────────────────────
            rect.rubber-band-rect(
              *ngIf='rubberBandRect',
              [attr.x]='rubberBandRect.x',
              [attr.y]='rubberBandRect.y',
              [attr.width]='rubberBandRect.w',
              [attr.height]='rubberBandRect.h'
            )

            //- ── Snap guides (Figma-style) ───────────────────────────────
            ng-container(*ngIf='snapGuides.length')
              line.snap-guide(
                *ngFor='let g of snapGuides',
                [attr.x1]='g.type === "v" ? g.pos : g.from',
                [attr.y1]='g.type === "h" ? g.pos : g.from',
                [attr.x2]='g.type === "v" ? g.pos : g.to',
                [attr.y2]='g.type === "h" ? g.pos : g.to'
              )
            ng-container(*ngIf='snapDistanceMarkers.length')
              g.snap-distance-marker(*ngFor='let dm of snapDistanceMarkers')
                rect.snap-dist-bg(
                  [attr.x]='dm.x - 14',
                  [attr.y]='dm.y - 7',
                  width='28', height='14',
                  rx='3'
                )
                text.snap-dist-text(
                  [attr.x]='dm.x',
                  [attr.y]='dm.y + 3',
                  text-anchor='middle'
                ) {{ dm.dist }}

            //- ── Drag ghost outline at original position ─────────────────
            rect.drag-ghost(
              *ngIf='dragGhostOrigin && _dragNode',
              [attr.x]='dragGhostOrigin.x',
              [attr.y]='dragGhostOrigin.y',
              [attr.width]='nodeW(_dragNode)',
              [attr.height]='nodeH(_dragNode)',
              rx='10', ry='10'
            )

            //- ── Drag position coordinates ───────────────────────────────
            g.drag-coords(*ngIf='dragCoords && _dragNode')
              rect.drag-coords-bg(
                [attr.x]='_dragNode.x + nodeW(_dragNode) + 8',
                [attr.y]='_dragNode.y - 4',
                width='80', height='18',
                rx='4'
              )
              text.drag-coords-text(
                [attr.x]='_dragNode.x + nodeW(_dragNode) + 12',
                [attr.y]='_dragNode.y + 9'
              ) {{ dragCoords.x }}, {{ dragCoords.y }}

        //- ── Undo/Redo toast notification ────────────────────────────────
        .undo-toast([class.toast-visible]='toastVisible')
          span.toast-icon {{ toastMessage === 'Undo' ? '↺' : '↻' }}
          span.toast-text {{ toastMessage }}

        //- ── Waypoint context menu ──────────────────────────────────────
        .ctx-menu(
          *ngIf='ctxWaypointLinkId',
          [style.left.px]='ctxLinkX',
          [style.top.px]='ctxLinkY',
          (mousedown)='$event.stopPropagation()',
          (click)='$event.stopPropagation()',
          (wheel)='$event.stopPropagation()'
        )
          button.ctx-item.ctx-danger(type='button', (click)='$event.stopPropagation(); deleteWaypoint()') Delete Waypoint
          button.ctx-item.ctx-close(type='button', (click)='$event.stopPropagation(); ctxWaypointLinkId = null') Cancel

        //- ── Link quality legend ────────────────────────────────────────
        .link-legend(*ngIf='linkCount > 0 && !showVlanView && !showBgpView')
          .legend-row
            .legend-line(style='background:#3a7aaa')
            span Good
          .legend-row
            .legend-line(style='background:#f59e0b')
            span Degraded
          .legend-row
            .legend-line(style='background:#ef4444')
            span Down / Loss

        //- ── VLAN view legend ─────────────────────────────────────────────
        .link-legend.vlan-legend(*ngIf='linkCount > 0 && showVlanView')
          .legend-title VLAN View
          .legend-row
            .legend-line(style='background:#3b82f6')
            span Trunk
          .legend-row
            .legend-line(style='background:#22c55e')
            span Access
          .legend-row
            .legend-line(style='background:#4b5563')
            span No VLAN Config
          .legend-row
            .legend-swatch(style='background:#3b82f6') V
            span VLAN Count

        //- ── BGP view legend ──────────────────────────────────────────────
        .link-legend.bgp-legend(*ngIf='linkCount > 0 && showBgpView')
          .legend-title BGP View
          .legend-row
            .legend-line(style='background:#f59e0b')
            span eBGP
          .legend-row
            .legend-line(style='background:#8b5cf6')
            span iBGP
          .legend-row
            .legend-line(style='background:#4b5563')
            span No BGP
          .legend-row
            .legend-swatch(style='background:#10b981') A
            span ASN

        //- ── Health summary widget ──────────────────────────────────────
        .health-widget(*ngIf='showHealthWidget && nodeCount > 0')
          .hw-row(*ngIf='livePollingActive')
            span.hw-dot
            span {{ healthSummary.nodesUp }}/{{ healthSummary.total }} nodes up
          .hw-row(*ngIf='!livePollingActive')
            span.hw-dot(style='background:#666')
            span {{ healthSummary.total }} nodes (polling off)
          .hw-row(*ngIf='healthSummary.bgpTotal > 0')
            span.hw-icon BGP
            span {{ healthSummary.bgpUp }}/{{ healthSummary.bgpTotal }}
          .hw-row(*ngIf='healthSummary.alarms > 0')
            span.hw-icon.alarm ⚠
            span {{ healthSummary.alarms }} alarm(s)

        //- ── Route Table side panel ────────────────────────────────────
        .route-table-panel(*ngIf='showRouteView')
          .route-table-header
            span Route Tables {{ routeFetching ? '(fetching…)' : '' }}
            button.route-table-close(type='button', (click)='showRouteView = false') ✕
          .route-table-body
            .route-table-empty(*ngIf='!liveRouteTable.size && !routeFetching') No route data — ensure devices have SSH credentials configured.
            ng-container(*ngFor='let node of topology.nodes')
              .route-node-section(*ngIf='nodeRouteCount(node.id) > 0')
                .route-node-header {{ node.label }} ({{ nodeRouteCount(node.id) }} routes)
                table.route-entries
                  thead
                    tr
                      th Destination
                      th Next Hop
                      th Proto
                      th Interface
                  tbody
                    tr(*ngFor='let r of liveRouteTable.get(node.id)')
                      td {{ r.destination }}
                      td {{ r.nextHop }}
                      td {{ r.protocol }}
                      td {{ r.interface || '—' }}
            button.btn-secondary(
              type='button',
              [disabled]='routeFetching',
              (click)='fetchRouteTables()',
              style='margin-top: 8px'
            ) {{ routeFetching ? 'Fetching…' : 'Refresh' }}

        //- ── Interface Counters side panel ────────────────────────────────
        .counter-panel(*ngIf='showCounterView')
          .route-table-header
            span Interface Counters {{ counterFetching ? '(fetching…)' : '' }}
            button.route-table-close(type='button', (click)='showCounterView = false') ✕
          .route-table-body
            .route-table-empty(*ngIf='!liveInterfaceCounters.size && !counterFetching') No counter data — ensure devices have SSH credentials.
            ng-container(*ngFor='let node of topology.nodes')
              .route-node-section(*ngIf='liveInterfaceCounters.has(node.id)')
                .route-node-header {{ node.label }} {{ nodeErrorCount(node.id) > 0 ? '⚠ ' + nodeErrorCount(node.id) + ' errors' : '' }}
                table.route-entries
                  thead
                    tr
                      th Interface
                      th RX Pkts
                      th TX Pkts
                      th RX Err
                      th TX Err
                  tbody
                    ng-container(*ngFor='let entry of liveInterfaceCounters.get(node.id) | keyvalue')
                      tr
                        td {{ entry.key }}
                        td {{ entry.value.rxPackets }}
                        td {{ entry.value.txPackets }}
                        td.counter-err {{ entry.value.rxErrors }}
                        td.counter-err {{ entry.value.txErrors }}
            button.btn-secondary(
              type='button',
              [disabled]='counterFetching',
              (click)='fetchInterfaceCounters()',
              style='margin-top: 8px'
            ) {{ counterFetching ? 'Fetching…' : 'Refresh' }}

        //- ── Keyboard shortcuts overlay ──────────────────────────────
        .shortcuts-overlay(*ngIf='showShortcutsOverlay', (click)='showShortcutsOverlay = false')
          .shortcuts-panel((click)='$event.stopPropagation()')
            .shortcuts-header
              span Keyboard Shortcuts
              button.shortcuts-close(type='button', (click)='showShortcutsOverlay = false') ✕
            .shortcuts-grid
              .shortcut-item
                kbd Ctrl+S
                span Save topology
              .shortcut-item
                kbd Ctrl+O
                span Open topology
              .shortcut-item
                kbd Ctrl+Z
                span Undo
              .shortcut-item
                kbd Ctrl+Shift+Z
                span Redo
              .shortcut-item
                kbd Ctrl+C
                span Copy selected
              .shortcut-item
                kbd Ctrl+V
                span Paste
              .shortcut-item
                kbd Ctrl+A
                span Select all
              .shortcut-item
                kbd Ctrl+F
                span Search nodes
              .shortcut-item
                kbd Delete
                span Delete selected
              .shortcut-item
                kbd L
                span Toggle link mode
              .shortcut-item
                kbd Escape
                span Cancel / Deselect
              .shortcut-item
                kbd ?
                span This panel
              .shortcut-item
                kbd F1
                span Help
              .shortcut-item
                kbd Dbl-click line
                span Add label
              .shortcut-item
                kbd Click label
                span Edit label
              .shortcut-item
                kbd Drag label
                span Move label
              .shortcut-item
                kbd Right-click
                span Context menu

        //- ── Canvas context menu ──────────────────────────────────────
        .ctx-menu(
          *ngIf='ctxCanvasOpen',
          [style.left.px]='ctxCanvasX',
          [style.top.px]='ctxCanvasY',
          (mousedown)='$event.stopPropagation()',
          (click)='$event.stopPropagation()',
          (wheel)='$event.stopPropagation()'
        )
          button.ctx-item(type='button', (click)='$event.stopPropagation(); addTextAnnotationAt()') Add Note
          button.ctx-item(
            *ngFor='let s of allShapes',
            type='button',
            (click)='$event.stopPropagation(); addShapeAt(s.type)'
          ) {{ s.icon }} {{ s.label }}
          button.ctx-item(type='button', (click)='$event.stopPropagation(); insertImageAt()') 🖼 Insert Image…
          .ctx-sep
          button.ctx-item(type='button', (click)='$event.stopPropagation(); selectAll()') Select All
          button.ctx-item(type='button', (click)='$event.stopPropagation(); resetView(); closeCanvasCtx()') Fit View
          .ctx-sep
          button.ctx-item.ctx-danger(type='button', (click)='$event.stopPropagation(); clearCanvas()') Clear Canvas
          button.ctx-item.ctx-close(type='button', (click)='$event.stopPropagation(); closeCanvasCtx()') Cancel

        //- ── Context menu ───────────────────────────────────────────────
        .ctx-menu(
          *ngIf='ctxNodeId',
          [style.left.px]='ctxX',
          [style.top.px]='ctxY',
          (mousedown)='$event.stopPropagation()',
          (click)='$event.stopPropagation()',
          (wheel)='$event.stopPropagation()'
        )
          button.ctx-item.ctx-start(
            type='button',
            [disabled]='ctxNodeStatus === "running"',
            (click)='$event.stopPropagation(); ctxStart(ctxNodeId!)'
          )
            span.ctx-dot.dot-running
            | Start
          button.ctx-item.ctx-suspend(
            type='button',
            [disabled]='ctxNodeStatus !== "running"',
            (click)='$event.stopPropagation(); ctxSuspend(ctxNodeId!)'
          )
            span.ctx-dot.dot-suspended
            | Suspend
          button.ctx-item.ctx-stop(
            type='button',
            [disabled]='ctxNodeStatus === "stopped"',
            (click)='$event.stopPropagation(); ctxStop(ctxNodeId!)'
          )
            span.ctx-dot.dot-stopped
            | Stop
          .ctx-sep
          button.ctx-item(type='button', (click)='ctxStartLink($event, ctxNodeId!)') Add Link
          button.ctx-item(
            type='button',
            [disabled]='!ctxNodeCanOpenSsh',
            (click)='$event.stopPropagation(); ctxOpenSshTerminal(ctxNodeId!)'
          ) Open SSH Terminal
          button.ctx-item(
            type='button',
            [disabled]='!ctxNodeCanOpenConsole',
            (click)='$event.stopPropagation(); ctxOpenConsole(ctxNodeId!)'
          ) Open Console
          button.ctx-item(
            type='button',
            [disabled]='!ctxNodeCanOpenConsole',
            (click)='$event.stopPropagation(); ctxOpenInlineTerminal(ctxNodeId!)'
          ) Open Terminal (Inline)
          button.ctx-item(
            type='button',
            [disabled]='!ctxNodeHasConfig',
            (click)='$event.stopPropagation(); ctxViewConfig(ctxNodeId!)'
          ) View Config
          button.ctx-item(
            type='button',
            [disabled]='!ctxNodeHasConfig',
            (click)='$event.stopPropagation(); ctxCompareConfig(ctxNodeId!)'
          ) Compare Config
          button.ctx-item(
            type='button',
            [disabled]='!ctxNodeHasConfig',
            (click)='$event.stopPropagation(); ctxShowTroubleshoot(ctxNodeId!)'
          ) Troubleshoot
          button.ctx-item(
            type='button',
            [disabled]='!ctxNodeCanFetchDiff',
            (click)='$event.stopPropagation(); ctxFetchAndCompare(ctxNodeId!)'
          ) Fetch &amp; Compare Config
          button.ctx-item(
            type='button',
            (click)='$event.stopPropagation(); ctxOpenConsole(ctxNodeId!)'
          ) Console (SSH)
          button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxRename(ctxNodeId!)') Rename
          button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxSimulateFailure(ctxNodeId!)')
            | {{ isNodeSimFailed(ctxNodeId!) ? 'Remove Failure' : 'Simulate Failure' }}
          button.ctx-item(
            *ngIf='selectedNodeIds.size > 1',
            type='button',
            (click)='$event.stopPropagation(); openBulkCredDialog()'
          ) Set SSH Credentials ({{ selectedNodeIds.size }})
          button.ctx-item(
            *ngIf='selectedNodeIds.size >= 2',
            type='button',
            (click)='$event.stopPropagation(); groupSelectedNodes(); closeCtxMenu()'
          ) Group Selected ({{ selectedNodeIds.size }})
          .ctx-sep
          //- Align tools (when multiple nodes selected)
          ng-container(*ngIf='selectedNodeIds.size > 1')
            .ctx-sep
            .ctx-sub-header Align
            .ctx-style-row((mousedown)='$event.stopPropagation()')
              button.ctx-dash-btn(title='Align Left', (click)='$event.stopPropagation(); alignNodes("left")') ⫷
              button.ctx-dash-btn(title='Align Center', (click)='$event.stopPropagation(); alignNodes("center")') ⫿
              button.ctx-dash-btn(title='Align Right', (click)='$event.stopPropagation(); alignNodes("right")') ⫸
              button.ctx-dash-btn(title='Align Top', (click)='$event.stopPropagation(); alignNodes("top")') ⊤
              button.ctx-dash-btn(title='Align Middle', (click)='$event.stopPropagation(); alignNodes("middle")') ⊟
              button.ctx-dash-btn(title='Align Bottom', (click)='$event.stopPropagation(); alignNodes("bottom")') ⊥
            .ctx-style-row((mousedown)='$event.stopPropagation()')
              button.ctx-dash-btn(title='Distribute Horizontally', (click)='$event.stopPropagation(); distributeNodes("h")') ⫴H
              button.ctx-dash-btn(title='Distribute Vertically', (click)='$event.stopPropagation(); distributeNodes("v")') ⫴V
          .ctx-sep
          button.ctx-item.ctx-danger(type='button', (click)='$event.stopPropagation(); ctxDelete(ctxNodeId!)') Delete Node
          button.ctx-item.ctx-close(type='button', (click)='$event.stopPropagation(); closeCtxMenu()') Cancel

        //- ── Link context menu ──────────────────────────────────────────
        .ctx-menu(
          *ngIf='ctxLinkId',
          [style.left.px]='ctxLinkX',
          [style.top.px]='ctxLinkY',
          (mousedown)='$event.stopPropagation()',
          (click)='$event.stopPropagation()',
          (wheel)='$event.stopPropagation()'
        )
          button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxLinkToggleDown()')
            | {{ ctxLinkStatus === "down" ? "Restore Link (Up)" : "Mark Link Down" }}
          button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxLinkProperties()') Properties
          button.ctx-item(
            type='button',
            [disabled]='!ctxLinkHasBend',
            (click)='$event.stopPropagation(); ctxLinkResetBend()'
          ) Reset Bend
          button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxLinkAddWaypoint()') Add Waypoint
          button.ctx-item(
            type='button',
            [disabled]='!getCtxLink()?.waypoints?.length',
            (click)='$event.stopPropagation(); ctxLinkClearWaypoints()'
          ) Clear Waypoints
          button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxLinkSimulateFailure()')
            | {{ isLinkSimFailed(ctxLinkId!) ? 'Remove Failure' : 'Simulate Failure' }}
          button.ctx-item(type='button', (click)='$event.stopPropagation(); startPacketCapture(ctxLinkId!); closeCtxLinkMenu()') Start Capture
          .ctx-sep
          //- Style submenu for shape links
          ng-container(*ngIf='isShapeLink(getCtxLink())')
            .ctx-sub-header Arrows
            .ctx-style-row((mousedown)='$event.stopPropagation()')
              button.ctx-dash-btn([class.active]='!getCtxLink()?.showArrow && !getCtxLink()?.arrowStart', (click)='$event.stopPropagation(); ctxLinkSetArrows(false, false)') None
              button.ctx-dash-btn([class.active]='getCtxLink()?.showArrow && !getCtxLink()?.arrowStart', (click)='$event.stopPropagation(); ctxLinkSetArrows(false, true)') →
              button.ctx-dash-btn([class.active]='!getCtxLink()?.showArrow && getCtxLink()?.arrowStart', (click)='$event.stopPropagation(); ctxLinkSetArrows(true, false)') ←
              button.ctx-dash-btn([class.active]='getCtxLink()?.showArrow && getCtxLink()?.arrowStart', (click)='$event.stopPropagation(); ctxLinkSetArrows(true, true)') ↔
            .ctx-sub-header Weight
            .ctx-style-row((mousedown)='$event.stopPropagation()')
              button.ctx-dash-btn([class.active]='(getCtxLink()?.linkWidth || 2) === 1', (click)='$event.stopPropagation(); ctxLinkSetWidth(1)') 1px
              button.ctx-dash-btn([class.active]='(getCtxLink()?.linkWidth || 2) === 2', (click)='$event.stopPropagation(); ctxLinkSetWidth(2)') 2px
              button.ctx-dash-btn([class.active]='(getCtxLink()?.linkWidth || 2) === 3', (click)='$event.stopPropagation(); ctxLinkSetWidth(3)') 3px
              button.ctx-dash-btn([class.active]='(getCtxLink()?.linkWidth || 2) === 5', (click)='$event.stopPropagation(); ctxLinkSetWidth(5)') 5px
            .ctx-sub-header Dashes
            .ctx-style-row((mousedown)='$event.stopPropagation()')
              button.ctx-dash-btn([class.active]='!getCtxLink()?.linkDash', (click)='$event.stopPropagation(); ctxLinkSetDash("")') ——
              button.ctx-dash-btn([class.active]='getCtxLink()?.linkDash === "6,4"', (click)='$event.stopPropagation(); ctxLinkSetDash("6,4")') - - -
              button.ctx-dash-btn([class.active]='getCtxLink()?.linkDash === "2,3"', (click)='$event.stopPropagation(); ctxLinkSetDash("2,3")') · · ·
              button.ctx-dash-btn([class.active]='getCtxLink()?.linkDash === "8,3,2,3"', (click)='$event.stopPropagation(); ctxLinkSetDash("8,3,2,3")') -·-·
            .ctx-sub-header Sketched
            button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxLinkToggleSketched()')
              | {{ getCtxLink()?.sketched ? '✓ Hand-drawn' : '  Hand-drawn' }}
            button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxLinkToggleRouting()')
              | {{ getCtxLink()?.routing === 'orthogonal' ? '✓ Orthogonal' : '  Orthogonal' }}
            .ctx-sub-header Color
            .ctx-style-row((mousedown)='$event.stopPropagation()')
              button.ctx-color-btn(*ngFor='let c of shapeLinkColors', [style.background]='c', (click)='$event.stopPropagation(); ctxLinkSetColor(c)')
            .ctx-sep
          button.ctx-item.ctx-danger(type='button', (click)='$event.stopPropagation(); ctxLinkDelete()') Delete Link
          button.ctx-item.ctx-close(type='button', (click)='$event.stopPropagation(); closeCtxLinkMenu()') Cancel

        //- ── Label context menu (right-click on individual label) ──────
        .ctx-menu(
          *ngIf='ctxLabelLinkId && ctxLabelId',
          [style.left.px]='ctxLinkX',
          [style.top.px]='ctxLinkY',
          (mousedown)='$event.stopPropagation()',
          (click)='$event.stopPropagation()',
          (wheel)='$event.stopPropagation()'
        )
          button.ctx-item(type='button', (click)='$event.stopPropagation(); editCtxLabel()') Edit Label
          .ctx-sep
          button.ctx-item.ctx-danger(type='button', (click)='$event.stopPropagation(); deleteLinkLabel()') Delete Label
          button.ctx-item.ctx-close(type='button', (click)='$event.stopPropagation(); closeLabelCtxMenu()') Cancel

        //- ── Shape context menu ─────────────────────────────────────────
        .ctx-menu(
          *ngIf='ctxShapeId',
          [style.left.px]='ctxShapeX',
          [style.top.px]='ctxShapeY',
          (mousedown)='$event.stopPropagation()',
          (click)='$event.stopPropagation()',
          (wheel)='$event.stopPropagation()'
        )
          button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxShapeStartLink(ctxShapeId!)') Add Link
          button.ctx-item(type='button', (click)='$event.stopPropagation(); ctxShapeEditLabel()') Edit Label
          button.ctx-item(type='button', (click)='$event.stopPropagation(); copyShape(); ctxShapeId = null') Copy
          button.ctx-item(type='button', (click)='$event.stopPropagation(); toggleShapeLock(ctxShapeId!)') {{ isShapeLocked(ctxShapeId!) ? '🔓 Unlock' : '🔒 Lock' }}
          .ctx-sep
          button.ctx-item.ctx-danger(type='button', [disabled]='isShapeLocked(ctxShapeId!)', (click)='$event.stopPropagation(); deleteAnnotation(ctxShapeId!); ctxShapeId = null') Delete Shape
          button.ctx-item.ctx-close(type='button', (click)='$event.stopPropagation(); ctxShapeId = null') Cancel

        //- ── Troubleshoot dialog (moved inline, rendered via CDK overlay or top-level) ──

        //- ── Port picker ────────────────────────────────────────────────
        .port-picker(
          *ngIf='portPickerCtx',
          [style.left.px]='portPickerX',
          [style.top.px]='portPickerY',
          (mousedown)='$event.stopPropagation()',
          (click)='$event.stopPropagation()',
          (wheel)='$event.stopPropagation()'
        )
          .port-picker-title {{ portPickerNodeType === 'host' ? 'Select host interface' : portPickerNodeType === 'bridge' ? 'Select bridge' : (portPickerCtx?.startsWith('src:') ? 'Select source port' : 'Select target port') }}
          .port-picker-loading(*ngIf='portPickerLoading') Loading…
          button.port-item(
            type='button',
            *ngFor='let p of portPickerPorts',
            [disabled]='!p.available',
            [class.port-item-used]='!p.available',
            (click)='onPortPick(p)'
          ) {{ p.displayLabel || p.port.label }}{{ p.available ? '' : ' (in use)' }}
          button.port-cancel(type='button', (click)='closePortPicker()') Cancel

      //- ── Properties sidebar ─────────────────────────────────────────────
      .props-sidebar([class.open]='selectedNodeId || selectedLinkId || selectedShapeId', [class.shape-only]='selectedShapeId && !selectedNodeId && !selectedLinkId')
        node-properties(
          *ngIf='selectedNodeId',
          [nodeId]='selectedNodeId',
          [activeServerId]='clabActiveServerId',
          [clabContainers]='clabContainers',
          [clabDeployed]='clabDeployed',
          [clabServers]='clabServers',
          [localDockerImages]='localDockerImageNames',
          (closed)='clearSelection()',
          (nodeSelected)='selectedNodeId = $event'
        )
        link-properties(
          *ngIf='selectedLinkId',
          [linkId]='selectedLinkId',
          (closed)='clearSelection()'
        )

        //- ── Shape properties ──────────────────────────────────────────
        .shape-props(*ngIf='selectedShapeId && getSelectedShape()')
          .shape-props-header
            span {{ (getSelectedShape()?.type || 'rectangle') | titlecase }} Properties
            button.shape-props-close(type='button', (click)='selectedShapeId = null') ✕
          .shape-props-body
            //- Color preset grid
            .shape-color-grid
              .shape-color-swatch(
                *ngFor='let p of SHAPE_PRESETS',
                [title]='p.label',
                [style.background]='p.fill',
                [style.border-color]='p.stroke',
                (click)='applyShapePreset(p)'
              )
            label.shape-prop-row
              span Label
              input.shape-prop-input(
                type='text',
                [value]='getSelectedShape()?.label || getSelectedShape()?.text || ""',
                (input)='onShapePropChange("label", $event)'
              )
            label.shape-prop-row
              span Fill Color
              .color-input-wrap
                input.shape-prop-color(
                  type='color',
                  [value]='shapeFillHex()',
                  (input)='onShapePropChange("fillColor", $event)'
                )
                span.color-label {{ getSelectedShape()?.fillColor || 'rgba(30,58,95,0.35)' }}
            label.shape-prop-row
              span Border Color
              .color-input-wrap
                input.shape-prop-color(
                  type='color',
                  [value]='getSelectedShape()?.strokeColor || "#3b82f6"',
                  (input)='onShapePropChange("strokeColor", $event)'
                )
                span.color-label {{ getSelectedShape()?.strokeColor || '#3b82f6' }}
            label.shape-prop-row
              span Border Width
              input.shape-prop-input.narrow(
                type='number',
                min='0',
                max='10',
                step='1',
                [value]='getSelectedShape()?.strokeWidth ?? 2',
                (input)='onShapePropChange("strokeWidth", $event)'
              )
            label.shape-prop-row
              span Opacity
              input.shape-prop-range(
                type='range',
                min='0.1',
                max='1',
                step='0.05',
                [value]='getSelectedShape()?.opacity ?? 1',
                (input)='onShapePropChange("opacity", $event)'
              )
            label.shape-prop-row(*ngIf='getSelectedShape()?.type === "rectangle"')
              span Corner Radius
              input.shape-prop-input.narrow(
                type='number',
                min='0',
                max='40',
                step='2',
                [value]='getSelectedShape()?.cornerRadius ?? 8',
                (input)='onShapePropChange("cornerRadius", $event)'
              )
            label.shape-prop-row
              span Rotation
              input.shape-prop-range(
                type='range',
                min='0',
                max='360',
                step='15',
                [value]='getSelectedShape()?.rotation ?? 0',
                (input)='onShapePropChange("rotation", $event)'
              )

      //- ── IPAM panel ─────────────────────────────────────────────────────
      .ipam-panel([class.open]='showIpam')
        .ipam-header
          span.ipam-title IP Address Map
          button.ipam-close(type='button', (click)='toggleIpam()') ✕
        .ipam-table-wrap
          table.ipam-table
            thead
              tr
                th Node
                th Port
                th IP / CIDR
            tbody
              tr(*ngIf='ipamEntries.length === 0')
                td.ipam-empty(colspan='3') No IP addresses configured
              tr(*ngFor='let e of ipamEntries')
                td {{ e.nodeLabel }}
                td {{ e.portLabel }}
                td {{ e.ip }}{{ e.cidr }}

    //- ── Syslog Feed panel ──────────────────────────────────────────────
    .syslog-panel(*ngIf='showSyslogPanel')
      .syslog-header
        span.syslog-title Syslog Feed
        .syslog-controls
          select.syslog-filter([(ngModel)]='syslogSeverityFilter')
            option(value='all') All
            option(value='emergency') Emergency
            option(value='alert') Alert
            option(value='critical') Critical
            option(value='error') Error
            option(value='warning') Warning
            option(value='notice') Notice
            option(value='informational') Info
            option(value='debug') Debug
          span.syslog-count {{ filteredSyslogMessages.length }} msgs
          button.syslog-ctrl-btn(type='button', (click)='clearSyslogMessages()', title='Clear messages') ✕
          button.syslog-ctrl-btn.syslog-start-btn(type='button', *ngIf='!syslogRunning', (click)='startSyslogServer()', title='Start syslog server (UDP :1514)') ▶
          button.syslog-ctrl-btn.syslog-stop-btn(type='button', *ngIf='syslogRunning', (click)='stopSyslogServer()', title='Stop syslog server') ⏹
          span.syslog-status-dot([class.running]='syslogRunning', [title]='syslogRunning ? "Listening on UDP :1514" : "Server stopped"')
          button.syslog-ctrl-btn.syslog-help-btn(type='button', (click)='showSyslogVendorHints = !showSyslogVendorHints', [class.active]='showSyslogVendorHints', title='Vendor syslog config examples') ?
        button.syslog-close(type='button', (click)='showSyslogPanel = false') ✕
      //- Vendor configuration hints — toggled via ? button, always accessible
      .syslog-hint-panel(*ngIf='showSyslogVendorHints')
        .syslog-hint-title Point your devices to this host on UDP port 1514
        .syslog-vendor-hints
          .syslog-vendor
            span.syslog-vendor-name Cisco IOS / IOS-XE
            code.syslog-vendor-cmd logging host {{ syslogTargetIp }}
            code.syslog-vendor-cmd logging trap informational
            code.syslog-vendor-cmd logging source-interface Loopback0
            code.syslog-vendor-cmd logging transport udp port 1514
          .syslog-vendor
            span.syslog-vendor-name Cisco NX-OS
            code.syslog-vendor-cmd logging server {{ syslogTargetIp }} 6 port 1514
            code.syslog-vendor-cmd logging source-interface loopback0
          .syslog-vendor
            span.syslog-vendor-name Arista EOS
            code.syslog-vendor-cmd logging host {{ syslogTargetIp }} 1514 protocol udp
            code.syslog-vendor-cmd logging trap informational
            code.syslog-vendor-cmd logging source-interface Loopback0
          .syslog-vendor
            span.syslog-vendor-name Juniper Junos
            code.syslog-vendor-cmd set system syslog host {{ syslogTargetIp }} port 1514
            code.syslog-vendor-cmd set system syslog host {{ syslogTargetIp }} any info
            code.syslog-vendor-cmd set system syslog host {{ syslogTargetIp }} source-address &lt;lo0-ip&gt;
          .syslog-vendor
            span.syslog-vendor-name Palo Alto PAN-OS
            code.syslog-vendor-cmd set shared syslog-server-profile tlink server {{ syslogTargetIp }} transport UDP port 1514
            code.syslog-vendor-cmd set shared syslog-server-profile tlink format BSD
          .syslog-vendor
            span.syslog-vendor-name MikroTik RouterOS
            code.syslog-vendor-cmd /system logging action set remote remote={{ syslogTargetIp }}:1514
            code.syslog-vendor-cmd /system logging add topics=info action=remote
          .syslog-vendor
            span.syslog-vendor-name Linux / rsyslog
            code.syslog-vendor-cmd # /etc/rsyslog.d/50-tlink.conf
            code.syslog-vendor-cmd *.info @{{ syslogTargetIp }}:1514
      .syslog-messages(*ngIf='!showSyslogVendorHints')
        .syslog-empty(*ngIf='filteredSyslogMessages.length === 0 && !syslogRunning') No syslog messages — click ▶ to start the server
        .syslog-empty(*ngIf='filteredSyslogMessages.length === 0 && syslogRunning') Listening on UDP :1514 — waiting for syslog messages…
        .syslog-msg(*ngFor='let m of filteredSyslogMessages', [class]='syslogSeverityClass(m.severity)')
          span.syslog-ts {{ m.timestamp | slice:11:19 }}
          span.syslog-host {{ m.hostname }}
          span.syslog-sev {{ m.severity | slice:0:4 }}
          span.syslog-text {{ m.message }}

    //- ── Traffic Flow panel ──────────────────────────────────────────────
    .traffic-flow-panel([class.open]='showTrafficFlowPanel')
      .tf-header
        span.tf-title Traffic Flows
        button.tf-close(type='button', (click)='toggleTrafficFlowPanel()') ✕
      .tf-body
        .tf-flow-list
          .tf-flow-item(
            *ngFor='let flow of trafficFlows',
            [class.tf-disabled]='!flow.enabled'
          )
            .tf-flow-color([style.background]='flow.color')
            .tf-flow-info
              .tf-flow-name {{ flow.name }}
              .tf-flow-detail {{ nodeLabel(flow.sourceNodeId) }} → {{ nodeLabel(flow.destNodeId) }}
              .tf-flow-proto(*ngIf='flow.protocol')
                | {{ flow.protocol }}{{ flow.port ? ':' + flow.port : '' }}
            .tf-flow-status
              span.tf-status-dot(
                [class.tf-status-ok]='isFlowReachable(flow.id) && !isFlowRerouted(flow.id)',
                [class.tf-status-rerouted]='isFlowReachable(flow.id) && isFlowRerouted(flow.id)',
                [class.tf-status-broken]='!isFlowReachable(flow.id)'
              )
            .tf-flow-actions
              button.tf-btn(type='button', title='Toggle', (click)='toggleFlowEnabled(flow.id)')
                | {{ flow.enabled ? '👁' : '🚫' }}
              button.tf-btn(type='button', title='Edit', (click)='editFlow(flow.id)') ✎
              button.tf-btn.tf-btn-danger(type='button', title='Remove', (click)='removeFlow(flow.id)') ✕
        .tf-form
          .tf-form-title {{ flowEditingId ? 'Edit Flow' : 'Add Flow' }}
          .tf-form-row
            label Name
            input.tf-input(type='text', [(ngModel)]='flowFormName', placeholder='Flow name')
          .tf-form-row
            label Source
            select.tf-select([(ngModel)]='flowFormSource')
              option(value='') -- Select --
              option(*ngFor='let n of topology?.nodes', [value]='n.id') {{ n.label }}
          .tf-form-row
            label Dest
            select.tf-select([(ngModel)]='flowFormDest')
              option(value='') -- Select --
              option(*ngFor='let n of topology?.nodes', [value]='n.id') {{ n.label }}
          .tf-form-row
            label Proto
            select.tf-select([(ngModel)]='flowFormProtocol')
              option(value='Any') Any
              option(value='TCP') TCP
              option(value='UDP') UDP
              option(value='ICMP') ICMP
          .tf-form-row
            label Port
            input.tf-input(type='number', [(ngModel)]='flowFormPort', placeholder='Optional')
          .tf-form-row
            label Color
            input.tf-color(type='color', [(ngModel)]='flowFormColor')
          .tf-form-actions
            button.tf-btn-primary(type='button', (click)='flowEditingId ? saveFlowEdit() : addFlow()')
              | {{ flowEditingId ? 'Save' : 'Add Flow' }}
            button.tf-btn-cancel(*ngIf='flowEditingId', type='button', (click)='cancelFlowEdit()') Cancel

    //- ── Inventory panel ──────────────────────────────────────────────────
    .inventory-panel([class.open]='showInventoryPanel')
      .inv-header
        span.inv-title Inventory
        .inv-header-actions
          button.inv-btn(type='button', title='Poll all', (click)='pollAllDevices()') ↻
          button.inv-btn(
            type='button', title='Toggle auto-poll',
            [class.inv-btn-active]='inventoryPollingEnabled',
            (click)='togglePolling()'
          ) ⟳
        button.inv-close(type='button', (click)='toggleInventoryPanel()') ✕
      .inv-table-wrap
        table.inv-table
          thead
            tr
              th Device
              th OS Version
              th Model
              th CPU
              th Mem
              th Uptime
              th Last Polled
              th
          tbody
            tr(*ngIf='inventoryEntries.length === 0')
              td.inv-empty(colspan='8') No devices in topology
            tr(
              *ngFor='let e of inventoryEntries',
              [class.inv-row-alarm]='e.hasActiveAlarm'
            )
              td
                span.inv-alarm-dot(*ngIf='e.hasActiveAlarm') ●
                | {{ e.nodeLabel }}
              td([title]='e.pollError || ""')
                span(*ngIf='e.osVersion') {{ e.osVersion }}
                span.inv-cell-error(*ngIf='!e.osVersion && e.pollError') Error
                span(*ngIf='!e.osVersion && !e.pollError') —
              td {{ e.model || '—' }}
              td([class.inv-cell-warn]='e.cpuHigh') {{ e.cpu }}
              td([class.inv-cell-warn]='e.memHigh') {{ e.mem }}
              td.inv-cell-uptime([title]='e.uptime') {{ e.uptime || '—' }}
              td {{ e.lastPolled }}
              td
                button.inv-row-action(type='button', title='Poll device', (click)='pollSelectedDevice()') ↻

    //- ── Alarm panel ────────────────────────────────────────────────────────
    .alarm-panel([class.open]='showAlarmPanel')
      .alarm-header
        span.alarm-title Alarms
        span.alarm-badge(*ngIf='activeAlarmCount > 0') {{ activeAlarmCount }}
        button.alarm-close(type='button', (click)='toggleAlarmPanel()') ✕
      //- Severity summary
      .alarm-severity-summary(*ngIf='activeAlarmCount > 0')
        span.alarm-sev-chip.sev-critical(*ngIf='alarmSeveritySummary["critical"]') C: {{ alarmSeveritySummary["critical"] }}
        span.alarm-sev-chip.sev-major(*ngIf='alarmSeveritySummary["major"]') M: {{ alarmSeveritySummary["major"] }}
        span.alarm-sev-chip.sev-minor(*ngIf='alarmSeveritySummary["minor"]') m: {{ alarmSeveritySummary["minor"] }}
        span.alarm-sev-chip.sev-warning(*ngIf='alarmSeveritySummary["warning"]') W: {{ alarmSeveritySummary["warning"] }}
        span.alarm-sev-chip.sev-info(*ngIf='alarmSeveritySummary["info"]') I: {{ alarmSeveritySummary["info"] }}
      //- Filters
      .alarm-filters
        select.alarm-filter-select([(ngModel)]='alarmFilterSeverity', (ngModelChange)='cdr.markForCheck()')
          option(value='all') All severities
          option(value='critical') Critical
          option(value='major') Major
          option(value='minor') Minor
          option(value='warning') Warning
          option(value='info') Info
        select.alarm-filter-select([(ngModel)]='alarmFilterCategory', (ngModelChange)='cdr.markForCheck()')
          option(value='all') All categories
          option(value='interface_down') Interface Down
          option(value='high_cpu') High CPU
          option(value='high_memory') High Memory
          option(value='config_drift') Config Drift
          option(value='reachability') Reachability
          option(value='version_mismatch') Version Mismatch
          option(value='custom') Custom
      //- Bulk actions
      .alarm-bulk-actions(*ngIf='filteredAlarms.length > 0')
        button.alarm-bulk-btn(type='button', (click)='acknowledgeAllAlarms()') Ack All
        button.alarm-bulk-btn.alarm-bulk-clear(type='button', (click)='clearAllAlarms()') Clear All
      .alarm-list-wrap
        .alarm-empty(*ngIf='filteredAlarms.length === 0') No active alarms
        .alarm-card(
          *ngFor='let a of filteredAlarms',
          [class.alarm-critical]='a.severity === "critical"',
          [class.alarm-major]='a.severity === "major"',
          [class.alarm-minor]='a.severity === "minor" || a.severity === "warning"'
        )
          .alarm-card-top
            span.alarm-sev {{ a.severity }}
            span.alarm-cat {{ a.category }}
            span.alarm-time {{ relativeTime(a.raisedAt) }}
          .alarm-card-device {{ getNodeLabel(a.nodeId) }}
          .alarm-card-msg {{ a.message }}
          .alarm-card-detail(*ngIf='a.detail') {{ a.detail }}
          .alarm-card-actions
            button.alarm-action(
              type='button',
              [disabled]='a.acknowledged',
              (click)='acknowledgeAlarm(a.id)'
            ) {{ a.acknowledged ? 'Ack\'d' : 'Acknowledge' }}
            button.alarm-action.alarm-action-clear(type='button', (click)='clearAlarm(a.id)') Clear

  //- ── Event Rules dialog overlay ─────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showEventRulesDialog', (click)='closeEventRulesDialog()')
    .auto-ip-dialog.event-rules-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Event Rules
      .auto-ip-subtitle Automate actions based on inventory events.

      //- Existing rules list
      .event-rules-list
        .event-rule-empty(*ngIf='eventRules.length === 0') No event rules defined.
        .event-rule-card(*ngFor='let r of eventRules')
          .event-rule-top
            label.event-rule-toggle
              input(type='checkbox', [checked]='r.enabled', (change)='toggleEventRule(r.id)')
              span {{ r.name }}
            button.event-rule-remove(type='button', (click)='removeEventRule(r.id)') ✕
          .event-rule-detail
            span.event-rule-tag {{ r.trigger }}
            span.event-rule-arrow →
            span.event-rule-tag {{ r.action }}
            span.event-rule-filter(*ngIf='r.nodeFilter && r.nodeFilter !== "*"') node: {{ r.nodeFilter }}
            span.event-rule-filter(*ngIf='r.vendorFilter && r.vendorFilter !== "*"') vendor: {{ r.vendorFilter }}
          .event-rule-detail(*ngIf='r.trigger === "command_check" && r.actionConfig.checkCommand')
            span.event-rule-filter cmd: {{ r.actionConfig.checkCommand }}
            span.event-rule-filter(*ngIf='r.actionConfig.checkPattern') match: {{ r.actionConfig.checkPattern }}

      .event-rules-sep
      .event-rules-add-title Add Rule
      .event-rules-form
        input.er-input(type='text', placeholder='Rule name', [(ngModel)]='newRuleName')
        .er-row
          label.er-label Trigger
          select.er-select([(ngModel)]='newRuleTrigger')
            option(value='command_check') Command Check
            option(value='alarm_raised') Alarm Raised
            option(value='alarm_cleared') Alarm Cleared
            option(value='config_change') Config Change
            option(value='link_down') Link Down
            option(value='link_up') Link Up
            option(value='poll_complete') Poll Complete
            option(value='version_change') Version Change
        .er-row(*ngIf='newRuleTrigger === "command_check"')
          label.er-label Check Command
          input.er-input(type='text', placeholder='show system alarms', [(ngModel)]='newRuleCheckCommand')
        .er-row(*ngIf='newRuleTrigger === "command_check"')
          label.er-label Match Pattern
          input.er-input(type='text', placeholder='Fan.*Degraded|Not Present', [(ngModel)]='newRuleCheckPattern')
        .er-row
          label.er-label Action
          select.er-select([(ngModel)]='newRuleAction')
            option(value='notify') Notify
            option(value='backup_config') Backup Config
            option(value='run_command') Run Command
            option(value='log') Log
        .er-row
          label.er-label Node Filter
          input.er-input(type='text', placeholder='* (all)', [(ngModel)]='newRuleNodeFilter')
        .er-row
          label.er-label Vendor
          select.er-select([(ngModel)]='newRuleVendorFilter')
            option(*ngFor='let v of vendorOptions', [value]='v') {{ v === '*' ? 'All vendors' : v }}
        .er-row(*ngIf='newRuleAction === "notify"')
          label.er-label Message
          input.er-input(type='text', placeholder='Alert message…', [(ngModel)]='newRuleMessage')
        .er-row(*ngIf='newRuleAction === "run_command"')
          label.er-label Command
          input.er-input(type='text', placeholder='show version', [(ngModel)]='newRuleCommand')

      //- Event log
      .event-rules-sep
      .event-rules-add-title
        | Recent Events
        button.er-log-toggle(type='button', (click)='showEventLog = !showEventLog') {{ showEventLog ? '▾' : '▸' }}
      .event-log-list(*ngIf='showEventLog')
        .event-log-empty(*ngIf='recentEventLog.length === 0') No events yet.
        .event-log-item(*ngFor='let ev of recentEventLog')
          span.event-log-type {{ ev.type }}
          span.event-log-device {{ getNodeLabel(ev.nodeId) }}
          span.event-log-time {{ relativeTime(ev.timestamp) }}

      .auto-ip-actions
        button.btn-tool(type='button', [disabled]='!newRuleName.trim()', (click)='addEventRule()') Add Rule
        button.btn-ghost(type='button', (click)='closeEventRulesDialog()') Close

  //- ── Upgrades dialog overlay ────────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showUpgradesDialog', (click)='closeUpgradesDialog()')
    .auto-ip-dialog.upgrades-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Firmware Upgrade Plans
      .auto-ip-subtitle Track and manage device firmware upgrades.
      .upgrade-empty(*ngIf='allUpgradePlans.length === 0') No upgrade plans created yet.

      //- Existing plans
      .upgrade-card(*ngFor='let u of allUpgradePlans')
        .upgrade-card-top
          span.upgrade-device {{ getNodeLabel(u.nodeId) }}
          span.upgrade-stage-badge([attr.data-stage]='u.stage') {{ u.stage }}
          button.upgrade-remove(type='button', title='Remove plan', (click)='removeUpgradePlan(u.id)') ✕
        .upgrade-card-detail
          | {{ u.currentVersion || '?' }} → {{ u.targetVersion }}
        .upgrade-card-detail(*ngIf='u.notes')
          span.upgrade-notes {{ u.notes }}
        .upgrade-card-detail
          span.upgrade-time Created: {{ relativeTime(u.createdAt) }}
          span.upgrade-time(style='margin-left: 8px') Updated: {{ relativeTime(u.updatedAt) }}

        //- Actions
        .upgrade-card-actions
          button.upgrade-action(
            type='button',
            [disabled]='upgradeRunning[u.id]',
            (click)='runUpgradePreCheck(u.id)'
          ) {{ upgradeRunning[u.id] ? '…' : 'Pre-Check' }}
          button.upgrade-action(
            type='button',
            *ngIf='nextUpgradeStage(u.stage)',
            (click)='advanceUpgradeStage(u.id, nextUpgradeStage(u.stage)!)'
          ) → {{ nextUpgradeStage(u.stage) }}
          button.upgrade-action(
            type='button',
            [disabled]='upgradeRunning[u.id]',
            (click)='runUpgradePostCheck(u.id)'
          ) {{ upgradeRunning[u.id] ? '…' : 'Post-Check' }}
          button.upgrade-action.upgrade-output-toggle(
            type='button',
            *ngIf='u.preCheckOutput || u.postCheckOutput',
            (click)='toggleUpgradeOutput(u.id)'
          ) {{ upgradeShowOutput[u.id] ? '▾ Output' : '▸ Output' }}

        //- Output display
        .upgrade-output(*ngIf='upgradeShowOutput[u.id]')
          .upgrade-output-section(*ngIf='u.preCheckOutput')
            .upgrade-output-title Pre-Check
            pre.upgrade-output-content {{ u.preCheckOutput }}
          .upgrade-output-section(*ngIf='u.postCheckOutput')
            .upgrade-output-title Post-Check
            pre.upgrade-output-content {{ u.postCheckOutput }}

      //- Create plan form
      .event-rules-sep
      .event-rules-add-title Create Upgrade Plan
      .event-rules-form
        .er-row
          label.er-label Device
          select.er-select([(ngModel)]='newUpgradeNodeId')
            option(value='') Select device…
            option(*ngFor='let n of upgradeNodeOptions', [value]='n.id') {{ n.label }} ({{ n.currentVersion }})
        .er-row
          label.er-label Target
          input.er-input(type='text', placeholder='Target version…', [(ngModel)]='newUpgradeTarget')
      .auto-ip-actions
        button.btn-tool(
          type='button',
          [disabled]='!newUpgradeNodeId || !newUpgradeTarget.trim()',
          (click)='createUpgradePlan()'
        ) Create Plan
        button.btn-ghost(type='button', (click)='closeUpgradesDialog()') Close

  //- ── Config Diff Viewer overlay ─────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showConfigViewer', (click)='closeConfigViewer()')
    .auto-ip-dialog.config-viewer-dialog((click)='$event.stopPropagation()')
      //- Simple raw viewer mode (legacy)
      ng-container(*ngIf='configViewerContent')
        .auto-ip-title {{ configViewerTitle }}
        pre.config-viewer-content {{ configViewerContent }}
      //- Full diff viewer mode
      ng-container(*ngIf='!configViewerContent')
        .auto-ip-title Config Diff Viewer
        .auto-ip-subtitle Compare configuration backups across devices.
        //- Node selector
        .cv-row
          label.cv-label Device
          select.cv-select((ngModel)='configViewerNodeId', (ngModelChange)='setConfigViewerNode($event)')
            option([ngValue]='null') All devices
            option(*ngFor='let n of configViewerNodes', [ngValue]='n.id') {{ n.label }}
        .cv-hint(*ngIf='configViewerBackups.length === 0') No backups available. Run a config backup first.
        //- Backup selectors
        ng-container(*ngIf='configViewerBackups.length > 0')
          .cv-row
            label.cv-label Version A
            select.cv-select((change)='selectConfigDiffA(configViewerBackups[$event.target.selectedIndex - 1])')
              option(selected) Select backup…
              option(*ngFor='let b of configViewerBackups', [value]='b.id') {{ getNodeLabel(b.nodeId) }} — {{ b.configType }} ({{ relativeTime(b.timestamp) }})
          .cv-row
            label.cv-label Version B
            select.cv-select((change)='selectConfigDiffB(configViewerBackups[$event.target.selectedIndex - 1])')
              option(selected) Select backup…
              option(*ngFor='let b of configViewerBackups', [value]='b.id') {{ getNodeLabel(b.nodeId) }} — {{ b.configType }} ({{ relativeTime(b.timestamp) }})
        //- Diff result
        .cv-diff-result(*ngIf='configViewerDiffResult')
          .cv-diff-header Diff Result
          pre.cv-diff-content
            ng-container(*ngFor='let line of configViewerDiffResult.split("\\n")')
              span.diff-add(*ngIf='line.startsWith("+")') {{ line }}\n
              span.diff-remove(*ngIf='line.startsWith("-")') {{ line }}\n
              span.diff-context(*ngIf='!line.startsWith("+") && !line.startsWith("-")') {{ line }}\n
        //- Raw config view
        .cv-raw-section(*ngIf='configViewerSelectedA')
          button.cv-raw-toggle(type='button', (click)='viewConfigRaw(configViewerSelectedA!)') {{ configViewerShowRaw?.id === configViewerSelectedA?.id ? '▾ Hide' : '▸ View' }} Version A
          pre.config-viewer-content(*ngIf='configViewerShowRaw?.id === configViewerSelectedA?.id') {{ configViewerSelectedA!.content }}
          button.cv-load-btn(
            *ngIf='configViewerSelectedA',
            type='button',
            [disabled]='configLoadRunning',
            (click)='confirmConfigLoad(configViewerSelectedA!)'
          ) {{ configLoadRunning ? 'Loading…' : '⟳ Load to Device' }}
        //- Config load confirmation
        .cv-load-confirm(*ngIf='configLoadTarget')
          .cv-load-msg Load this {{ configLoadTarget.configType }} config onto the device? This will overwrite the running configuration.
          .cv-load-actions
            button.btn-ghost(type='button', (click)='cancelConfigLoad()') Cancel
            button.cv-load-confirm-btn(type='button', [disabled]='configLoadRunning', (click)='executeConfigLoad()') {{ configLoadRunning ? 'Loading…' : 'Confirm Load' }}
        //- Config load output
        .cv-load-output(*ngIf='configLoadOutput')
          .cv-load-output-header
            span Session Output
            button.cv-load-output-close(type='button', (click)='closeConfigLoadOutput()') ✕
          pre.cv-load-output-content {{ configLoadOutput }}
      .auto-ip-actions
        button.btn-ghost(type='button', (click)='closeConfigViewer()') Close

  //- ── Poll Sync Review overlay ───────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showPollSyncDialog', (click)='dismissPollSync()')
    .auto-ip-dialog.poll-sync-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Poll Sync — Review Changes
      .auto-ip-subtitle {{ pollSyncProposals.length }} device{{ pollSyncProposals.length === 1 ? '' : 's' }} with topology changes ({{ checkedPollSyncChanges }}/{{ totalPollSyncChanges }} selected)

      .poll-sync-toolbar
        button.poll-sync-toolbar-btn(type='button', (click)='selectAllPollSync(true)') Select All
        button.poll-sync-toolbar-btn(type='button', (click)='selectAllPollSync(false)') Select None

      .poll-sync-devices
        .poll-sync-device(*ngFor='let p of pollSyncProposals')
          .poll-sync-device-header((click)='togglePollSyncExpand(p.nodeId)')
            span.poll-sync-expand-icon {{ pollSyncExpanded[p.nodeId] ? '▾' : '▸' }}
            span.poll-sync-device-label {{ p.nodeLabel }}
            span.poll-sync-device-count
              | {{ (p.modelChange ? 1 : 0) + p.portChanges.length }} change{{ ((p.modelChange ? 1 : 0) + p.portChanges.length) === 1 ? '' : 's' }}

          .poll-sync-device-body(*ngIf='pollSyncExpanded[p.nodeId]')
            //- Info fields
            .poll-sync-info-row(*ngFor='let f of p.infoFields')
              span.poll-sync-info-label {{ f.label }}
              span.poll-sync-info-value {{ f.value }}

            //- Model change
            .poll-sync-change-row(*ngIf='p.modelChange')
              label.poll-sync-check-label
                input(
                  type='checkbox',
                  [checked]='pollSyncChecked[p.nodeId]?.["model"]',
                  (change)='togglePollSyncCheck(p.nodeId, "model")'
                )
                span Model
              span.poll-sync-val-from {{ p.modelChange.from }}
              span.poll-sync-val-arrow →
              span.poll-sync-val-to {{ p.modelChange.to }}

            //- Port changes
            .poll-sync-change-row(*ngFor='let pc of p.portChanges')
              label.poll-sync-check-label
                input(
                  type='checkbox',
                  [checked]='pollSyncChecked[p.nodeId]?.["port:" + pc.portId]',
                  (change)='togglePollSyncCheck(p.nodeId, "port:" + pc.portId)'
                )
                span {{ pc.portLabel }}
              span.poll-sync-val-from {{ pc.from }}
              span.poll-sync-val-arrow →
              span.poll-sync-val-to {{ pc.to }}

      .auto-ip-actions
        button.btn-secondary(
          type='button',
          [disabled]='checkedPollSyncChanges === 0',
          (click)='applyAllPollSync()'
        ) Apply {{ checkedPollSyncChanges }} Change{{ checkedPollSyncChanges === 1 ? '' : 's' }}
        button.btn-ghost(type='button', (click)='dismissPollSync()') Dismiss

  //- ── Templates overlay ──────────────────────────────────────────────────
  topology-templates(*ngIf='showTemplates', (closed)='closeTemplates()', (switchToBuilder)='closeTemplates(); openBuilder()', (deployRequested)='deployAfterTemplateLoad()')

  //- ── Topology Builder overlay ─────────────────────────────────────────
  topology-builder(*ngIf='showBuilder', (closed)='closeBuilder()')

  //- ── Auto IP overlay ────────────────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showAutoIpDialog', (click)='cancelAutoIpDialog()')
    .auto-ip-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Auto-address links
      .auto-ip-subtitle Assign /30 interface pairs across all links from a base CIDR.
      label.auto-ip-label(for='autoIpSubnet') Base subnet (CIDR)
      input#autoIpSubnet.auto-ip-input(
        type='text',
        [(ngModel)]='autoIpInput',
        placeholder='10.20.0.0/16',
        (keydown.enter)='applyAutoIpDialog()'
      )
      label.auto-ip-check(*ngIf='autoIpHasExisting')
        input(type='checkbox', [(ngModel)]='autoIpOverwriteExisting')
        span Overwrite existing linked interface IPs
      .auto-ip-hint(*ngIf='autoIpHasExisting && !autoIpOverwriteExisting')
        | Existing interface IPs stay unchanged; only unaddressed links are filled.
      .auto-ip-error(*ngIf='autoIpDialogError') ⚠ {{ autoIpDialogError }}
      .auto-ip-actions
        button.btn-tool(type='button', (click)='cancelAutoIpDialog()')
          span Cancel
        button.btn-tool(type='button', (click)='applyAutoIpDialog()')
          span Apply

  //- ── IPv6 auto-address dialog ─────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showAutoIpv6Dialog', (click)='cancelAutoIpv6Dialog()')
    .auto-ip-dialog((click)='$event.stopPropagation()')
      .auto-ip-title {{ autoIpv6Mode === 'links' ? 'Auto-assign IPv6 link addresses' : 'Auto-assign IPv6 loopbacks' }}
      .auto-ip-subtitle {{ autoIpv6Mode === 'links' ? 'Assign /127 interface pairs across all links from a base IPv6 prefix.' : 'Assign /128 loopback IPs to eligible nodes from a base IPv6 prefix.' }}
      label.auto-ip-label(for='autoIpv6Subnet') Base prefix (IPv6 CIDR)
      input#autoIpv6Subnet.auto-ip-input(
        type='text',
        [(ngModel)]='autoIpv6Input',
        [placeholder]='autoIpv6Mode === "links" ? "2001:db8::/32" : "fd00::/64"',
        (keydown.enter)='applyAutoIpv6Dialog()'
      )
      label.auto-ip-check(*ngIf='autoIpv6HasExisting')
        input(type='checkbox', [(ngModel)]='autoIpv6OverwriteExisting')
        span {{ autoIpv6Mode === 'links' ? 'Overwrite existing linked interface IPv6 IPs' : 'Overwrite existing IPv6 loopback IPs' }}
      .auto-ip-hint(*ngIf='autoIpv6HasExisting && !autoIpv6OverwriteExisting')
        | Existing IPv6 addresses stay unchanged; only unaddressed {{ autoIpv6Mode === 'links' ? 'links' : 'nodes' }} are filled.
      .auto-ip-error(*ngIf='autoIpv6DialogError') ⚠ {{ autoIpv6DialogError }}
      .auto-ip-actions
        button.btn-tool(type='button', (click)='cancelAutoIpv6Dialog()')
          span Cancel
        button.btn-tool(type='button', (click)='applyAutoIpv6Dialog()')
          span Apply

  //- ── Service Profile overlay ────────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showServiceDialog', (click)='cancelServiceDialog()')
    .auto-ip-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Apply Service Profile
      .auto-ip-subtitle Configure VLANs and port modes across all nodes based on their roles.
      label.auto-ip-label Service Profile
      select.auto-ip-input([(ngModel)]='serviceProfileId')
        option(value='') — Select —
        option(*ngFor='let sp of serviceProfiles', [value]='sp.id') {{ sp.icon }} {{ sp.name }}
      .auto-ip-hint(*ngIf='serviceProfileId') {{ getServiceDescription(serviceProfileId) }}
      label.auto-ip-check
        input(type='checkbox', [(ngModel)]='serviceOverwrite')
        span Overwrite existing VLAN/port configs
      label.auto-ip-check
        input(type='checkbox', [(ngModel)]='serviceRegenConfigs')
        span Regenerate startup configs
      .auto-ip-actions
        button.btn-tool(type='button', (click)='cancelServiceDialog()')
          span Cancel
        button.btn-tool(type='button', [disabled]='!serviceProfileId', (click)='applyServiceDialog()')
          span Apply

  //- ── Containerlab overlay ──────────────────────────────────────
  .auto-ip-overlay(*ngIf='showClabDialog')
    .auto-ip-dialog
      .auto-ip-title Containerlab Topology
      .auto-ip-subtitle Generate a .clab.yml for {{ clabVendorInfo?.vendorSummary || 'virtual' }} lab, or deploy directly.

      //- ── Server selector ─────────────────────────────────────
      .clab-server-section
        .clab-server-row
          span.clab-server-label Compute Host
          select.clab-server-select([ngModel]='clabActiveServerId', (ngModelChange)='switchClabServer($event)')
            option(*ngFor='let s of clabServers', [value]='s.id') {{ s.name }}{{ s.type === 'ssh' && s.host && s.host !== s.name ? ' (' + s.host + ')' : '' }}
          button.clab-prereq-btn(type='button', (click)='openClabServerSettings()') Manage

      //- ── Prerequisites status ──────────────────────────────────
      .clab-prereq-section
        .clab-prereq-row
          span.clab-prereq-icon(*ngIf='!clabPrereqChecked') ⟳
          span.clab-prereq-icon.clab-ok(*ngIf='clabPrereqChecked && clabDockerOk') ✓
          span.clab-prereq-icon.clab-fail(*ngIf='clabPrereqChecked && !clabDockerOk') ✗
          span.clab-prereq-label Docker
          span.clab-prereq-msg(*ngIf='!clabPrereqChecked')  checking…
          span.clab-prereq-msg(*ngIf='clabPrereqChecked') &nbsp;{{ clabDockerMsg }}
          button.clab-prereq-btn(*ngIf='clabPrereqChecked && !clabDockerOk && clabDockerInstalled', [disabled]='clabStartingDocker', (click)='startDockerFromDialog()')
            | {{ clabStartingDocker ? 'Starting…' : 'Start Docker' }}
          a.clab-prereq-link(*ngIf='clabPrereqChecked && !clabDockerOk && !clabDockerInstalled', href='https://docs.docker.com/get-docker/', target='_blank') Install Docker ↗
        .clab-prereq-row
          span.clab-prereq-icon(*ngIf='!clabPrereqChecked') ⟳
          span.clab-prereq-icon.clab-ok(*ngIf='clabPrereqChecked && clabClabOk') ✓
          span.clab-prereq-icon.clab-fail(*ngIf='clabPrereqChecked && !clabClabOk && !clabInstallingClab') ✗
          span.clab-prereq-icon(*ngIf='clabInstallingClab') ⟳
          span.clab-prereq-label Containerlab
          span.clab-prereq-msg(*ngIf='!clabPrereqChecked')  checking…
          span.clab-prereq-msg(*ngIf='clabPrereqChecked') &nbsp;{{ clabClabMsg }}
          button.clab-prereq-btn(*ngIf='clabPrereqChecked && !clabClabOk && !clabInstallingClab', (click)='autoInstallClab()') Install
        .clab-prereq-row(*ngIf='clabPrereqChecked && (!clabDockerOk || !clabClabOk) && !clabInstallingClab')
          button.clab-prereq-btn((click)='recheckClabPrereqs()') Re-check

      //- ── Docker Images status ──────────────────────────────────
      .clab-prereq-section(*ngIf='clabDockerOk && clabImagesChecked')
        .clab-prereq-row
          span.clab-prereq-label(style='min-width:auto; font-size:11px; text-transform:uppercase; letter-spacing:0.04em') Docker Images
        .clab-image-row(*ngFor='let img of clabImages; let i = index')
          span.clab-prereq-icon.clab-ok(*ngIf='img.available && !img.pulling && !img.archMismatch') ✓
          span.clab-prereq-icon.clab-warn(*ngIf='img.available && !img.pulling && img.archMismatch') ⚠
          span.clab-prereq-icon.clab-fail(*ngIf='!img.available && !img.pulling && !img.error') ✗
          span.clab-prereq-icon(*ngIf='img.pulling') ⟳
          span.clab-prereq-icon.clab-fail(*ngIf='!img.available && !img.pulling && img.error') ✗
          span.clab-image-name {{ img.name }}
          span.clab-prereq-msg(*ngIf='img.available && !img.archMismatch') &nbsp;{{ img.size ? img.size : 'available' }}{{ img.arch ? ' · ' + img.arch : '' }}
          span.clab-prereq-msg.clab-arch-warn(*ngIf='img.available && img.archMismatch') &nbsp;{{ img.arch }} — wrong architecture!
          span.clab-prereq-msg(*ngIf='!img.available && !img.pulling && !img.error') &nbsp;not found locally
          span.clab-prereq-msg(*ngIf='img.pulling') &nbsp;pulling…
          span.clab-prereq-msg.clab-image-error(*ngIf='!img.available && !img.pulling && img.error') &nbsp;{{ img.error }}
          select.clab-tag-select(*ngIf='img.alternativeTags?.length', [ngModel]='img.name', (ngModelChange)='selectAlternativeTag(i, $event)', title='Select image tag')
            option(*ngFor='let tag of img.alternativeTags', [value]='tag') {{ tag }}
          button.clab-prereq-btn(*ngIf='!img.available && !img.pulling', (click)='pullClabImage(img.name)') Pull
          button.clab-prereq-btn(*ngIf='!img.available && !img.pulling', (click)='importDockerImage()') Import
        //- Architecture mismatch warning banner
        .clab-arch-mismatch-banner(*ngIf='hasClabArchMismatch')
          span.clab-warning-icon ⚠
          span.clab-warning-text
            strong Architecture mismatch detected!
            |  Your host is
            strong  {{ clabHostArch }}
            |  but some images are built for a different architecture. This will cause Docker to crash or containers to fail.
            |  Download the correct image for your platform (e.g. arm64 for Apple Silicon, amd64 for Intel/Linux).
        .clab-prereq-row
          button.clab-prereq-btn(*ngIf='clabImages.length > 0', (click)='recheckClabImages()')
            | Re-check Images
          button.clab-prereq-btn([disabled]='clabLoadingImage', (click)='importDockerImage()')
            | {{ clabLoadingImage ? 'Loading…' : 'Import Image File' }}
          button.clab-prereq-btn((click)='openVrnetlabBuilder()')
            | Build vrnetlab Image
        .clab-image-loading(*ngIf='clabLoadingImage')
          span.clab-prereq-icon ⟳
          span.clab-prereq-msg {{ dockerProgressMsg || clabLoadingImageMsg }}
        .clab-prereq-msg(*ngIf='!clabLoadingImage', style='font-size:10px; padding:4px 0 0; color:#6b7280')
          | Use Pull to download from Docker Hub, or Import to load a local .tgz/.tar/.gz file.
      .clab-prereq-section(*ngIf='clabDockerOk && !clabImagesChecked')
        .clab-prereq-row
          span.clab-prereq-icon ⟳
          span.clab-prereq-label Docker Images
          span.clab-prereq-msg  checking…

      label.auto-ip-label(*ngIf='clabVendorInfo?.hasSonic', for='clabImage') Docker image for SONiC-VS nodes
      select#clabImage.auto-ip-input(*ngIf='clabVendorInfo?.hasSonic',
        [(ngModel)]='clabImageInput',
        (ngModelChange)='recheckClabImages()'
      )
        option(value='') docker-sonic-vs:latest (default)
        option(*ngFor='let img of availableDockerImages', [value]='img') {{ img }}
      label.auto-ip-label(for='clabMgmt') Management subnet (optional)
      input#clabMgmt.auto-ip-input(
        type='text',
        [(ngModel)]='clabMgmtSubnet',
        placeholder='172.20.20.0/24',
        (keydown.enter)='exportContainerlab()'
      )
      .auto-ip-hint Leave empty to use containerlab's default management network.
      label.auto-ip-label(for='clabLabDir') Lab directory (optional, for deploy)
      input#clabLabDir.auto-ip-input(
        type='text',
        [(ngModel)]='clabLabDir',
        placeholder='~/containerlab-labs/'
      )
      .auto-ip-hint Directory where the .clab.yml and lab files will be saved for deployment.
      .clab-multi-server-info(*ngIf='hasMultiServerNodes')
        span.clab-ms-icon 🖧
        span.clab-ms-text Multi-server deploy: nodes are assigned to different servers. Cross-server links will require manual VXLAN tunnel configuration.
      .clab-warnings(*ngIf='clabWarnings.length > 0')
        .clab-warning(*ngFor='let w of clabWarnings')
          span.clab-warning-icon ⚠
          span.clab-warning-text {{ w }}
      //- ── Pre-deploy Validation Results ─────────────────────────
      .clab-validation-section
        .clab-validation-header
          span.clab-validation-title Pre-deploy Validation
          button.form-btn-sm(type='button', (click)='runPreDeployValidation()', [disabled]='clabValidating')
            span {{ clabValidating ? 'Validating…' : 'Re-validate' }}
        .clab-validation-spinner(*ngIf='clabValidating')
          span Checking host interfaces and bridges on server…
        .clab-validation-summary(*ngIf='clabValidationDone && !clabValidating')
          .clab-validation-ok(*ngIf='clabValidationErrors.length === 0 && clabValidationWarnings.length === 0')
            span.clab-val-icon ✔
            span.clab-val-text All host interfaces and bridges validated successfully.
          .clab-validation-summary-row(*ngIf='clabValidationErrors.length > 0 || clabValidationWarnings.length > 0')
            span.clab-val-summary-text
              span.clab-val-icon-err(*ngIf='clabValidationErrors.length > 0') ✖
              span(*ngIf='clabValidationErrors.length > 0')  {{ clabValidationErrors.length }} error{{ clabValidationErrors.length > 1 ? 's' : '' }}
              span(*ngIf='clabValidationErrors.length > 0 && clabValidationWarnings.length > 0') ,&nbsp;
              span.clab-val-icon-warn(*ngIf='clabValidationWarnings.length > 0') ⚠
              span(*ngIf='clabValidationWarnings.length > 0')  {{ clabValidationWarnings.length }} warning{{ clabValidationWarnings.length > 1 ? 's' : '' }}
            button.clab-val-details-btn(type='button', (click)='showValidationDetails = true') View Details

      //- ── Validation Details Dialog ─────────────────────────────
      .clab-overlay(*ngIf='showValidationDetails', (click)='showValidationDetails = false')
      .clab-validation-dialog(*ngIf='showValidationDetails')
        .clab-validation-dialog-header
          span.clab-validation-dialog-title Pre-deploy Validation Details
          button.clab-validation-dialog-close(type='button', (click)='showValidationDetails = false') ✕
        .clab-validation-dialog-body
          .clab-validation-errors(*ngIf='clabValidationErrors.length > 0')
            .clab-validation-error(*ngFor='let e of clabValidationErrors')
              span.clab-val-icon ✖
              span.clab-val-text {{ e }}
          .clab-validation-warnings(*ngIf='clabValidationWarnings.length > 0')
            .clab-validation-warn(*ngFor='let w of clabValidationWarnings')
              span.clab-val-icon ⚠
              span.clab-val-text {{ w }}
      //- ── YAML Preview ──────────────────────────────────────────
      .clab-yaml-preview-section
        button.clab-prereq-btn(type='button', (click)='toggleClabYamlPreview()') {{ showClabYamlPreview ? 'Hide YAML Preview' : 'Preview YAML' }}
        pre.clab-yaml-preview(*ngIf='showClabYamlPreview') {{ clabYamlPreviewContent }}

      .auto-ip-error(*ngIf='clabDialogError') ⚠ {{ clabDialogError }}
      .auto-ip-actions
        button.btn-tool(type='button', (click)='cancelClabDialog()')
          span Cancel
        button.btn-tool(type='button', (click)='exportContainerlab()')
          span Export
        button.btn-tool.btn-deploy(type='button', [disabled]='clabDeploying || !clabPrereqChecked || !clabDockerOk || !clabClabOk || clabValidating || clabValidationErrors.length > 0', (click)='deployContainerlab()')
          span {{ clabDeploying ? 'Deploying…' : 'Deploy' }}
        button.btn-tool.btn-destroy(type='button', *ngIf='clabDeployed && clabFilePath', (click)='destroyContainerlab()')
          span Destroy

  //- ── Containerlab Status overlay ──────────────────────────────────
  .auto-ip-overlay(*ngIf='showClabStatusDialog', (click)='closeClabStatusDialog()')
    .auto-ip-dialog.clab-status-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Lab Status
      .auto-ip-subtitle {{ clabContainers.length }} container(s) in deployed lab
      .clab-container-list
        .clab-container-row.clab-container-header
          span Name
          span State
          span IPv4
          span Kind
          span Actions
        .clab-container-row(*ngFor='let c of clabContainers')
          span {{ c.name }}
          span([class.clab-running]='c.state === "running"', [class.clab-stopped]='c.state !== "running"') {{ c.state }}
          span {{ c.ipv4Address }}
          span {{ c.kind }}
          span.clab-container-actions
            button.clab-prereq-btn(type='button', (click)='viewContainerLogs(c.name)', title='View container logs') Logs
      .auto-ip-actions
        button.btn-tool(type='button', [disabled]='clabInspecting', (click)='inspectContainerlab()')
          span {{ clabInspecting ? 'Refreshing…' : 'Refresh' }}
        button.btn-tool(type='button', (click)='closeClabStatusDialog()')
          span Close

  //- ── Detect Running Lab overlay ──────────────────────────────────────
  .auto-ip-overlay(*ngIf='showDetectLabDialog', (click)='closeDetectLabDialog()')
    .auto-ip-dialog.detect-lab-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Detect Running Labs
      .auto-ip-subtitle(*ngIf='detectLabScanning') Scanning Docker for containerlab containers…
      .auto-ip-subtitle(*ngIf='!detectLabScanning && detectedLabs.length === 0') No running containerlab labs found.
      .auto-ip-subtitle(*ngIf='!detectLabScanning && detectedLabs.length > 0')
        | {{ detectedLabs.length }} lab(s) found
        span.detect-lab-server-badge(*ngIf='detectedLabsServer') on {{ detectedLabsServer.name }}{{ detectedLabsServer.host ? ' (' + detectedLabsServer.host + ')' : '' }}
        |  — reconnect to manage or destroy to clean up.
      .detect-lab-list(*ngIf='detectedLabs.length > 0')
        .detect-lab-card(*ngFor='let lab of detectedLabs')
          .detect-lab-header
            .detect-lab-name {{ lab.labName }}
            .detect-lab-info {{ lab.containers.length }} container(s)
            span.detect-lab-server-tag(*ngIf='detectedLabsServer?.type === "ssh"') {{ detectedLabsServer.name }}
          .detect-lab-file(*ngIf='lab.topoFile') {{ lab.topoFile }}
          .detect-lab-containers
            span.detect-lab-ctn(*ngFor='let c of lab.containers')
              span.detect-lab-dot([class.clab-running]='c.state === "running"', [class.clab-stopped]='c.state !== "running"')
              | {{ c.name }}
          .detect-lab-actions
            button.btn-tool.detect-btn-reconnect(type='button', (click)='reconnectLab(lab)')
              span Reconnect
            button.btn-tool.detect-btn-import(type='button', (click)='importFromRunningLab(lab)')
              span Import as New
            button.btn-tool.detect-btn-destroy(type='button', (click)='destroyDetectedLab(lab)')
              span Destroy
      .auto-ip-actions
        button.btn-tool(type='button', [disabled]='detectLabScanning', (click)='detectRunningLab()')
          span {{ detectLabScanning ? 'Scanning…' : 'Re-scan' }}
        button.btn-tool(type='button', (click)='closeDetectLabDialog()')
          span Close

  //- ── Containerlab Server Settings overlay ──────────────────────────
  //- ── Server Manager overlay ─────────────────────────────────
  .auto-ip-overlay(*ngIf='showServerManager', (click)='closeServerManager()')
    .auto-ip-dialog.server-manager-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Server Manager
      .auto-ip-subtitle Manage containerlab compute servers

      //- Server table
      .server-mgr-table(*ngIf='!editingServer')
        .server-mgr-row.server-mgr-header
          span.server-mgr-cell.smgr-name Name
          span.server-mgr-cell.smgr-host Host
          span.server-mgr-cell.smgr-status Status
          span.server-mgr-cell.smgr-cpu CPU
          span.server-mgr-cell.smgr-mem Memory
          span.server-mgr-cell.smgr-disk Disk
          span.server-mgr-cell.smgr-kvm KVM
          span.server-mgr-cell.smgr-containers Containers
          span.server-mgr-cell.smgr-vms VMs
          span.server-mgr-cell.smgr-actions Actions

        .server-mgr-row(*ngFor='let s of clabServers')
          span.server-mgr-cell.smgr-name
            span.server-mgr-status-dot(
              [class.dot-connected]='s.type === "local" || serverManagerResources[s.id]?.status === "connected"',
              [class.dot-disconnected]='s.type !== "local" && serverManagerResources[s.id]?.status === "disconnected"',
              [class.dot-checking]='serverManagerResources[s.id]?.status === "checking"'
            )
            | {{ s.name }}
          span.server-mgr-cell.smgr-host {{ s.type === 'ssh' ? s.host : 'localhost' }}
          span.server-mgr-cell.smgr-status
            span {{ s.type === 'local' ? 'Local' : (serverManagerResources[s.id]?.status || '—') }}
          span.server-mgr-cell.smgr-cpu
            | {{ serverManagerResources[s.id]?.cpu || '—' }}
            svg.sparkline(*ngIf='serverResourceHistory[s.id]?.length > 1', width='80', height='20', viewBox='0 0 80 20')
              path([attr.d]='sparklinePath(s.id)', fill='none', stroke='var(--accent)', stroke-width='1.5')
          span.server-mgr-cell.smgr-mem {{ serverManagerResources[s.id]?.mem || '—' }}
          span.server-mgr-cell.smgr-disk {{ serverManagerResources[s.id]?.disk || '—' }}
          span.server-mgr-cell.smgr-kvm
            span.clab-prereq-icon([class.clab-ok]='serverManagerResources[s.id]?.kvm', [class.clab-fail]='serverManagerResources[s.id]?.kvm === false') {{ serverManagerResources[s.id]?.kvm === true ? '✓' : serverManagerResources[s.id]?.kvm === false ? '✗' : '—' }}
          span.server-mgr-cell.smgr-containers {{ serverManagerResources[s.id]?.containers ?? '—' }}
          span.server-mgr-cell.smgr-vms {{ serverManagerResources[s.id]?.vms ?? '—' }}
          span.server-mgr-cell.smgr-actions
            button.clab-prereq-btn(type='button', *ngIf='s.type !== "local"', (click)='editServer(s)') Edit
            button.clab-prereq-btn(type='button', (click)='testServer(s.id)', [disabled]='clabServerTesting') Test
            button.clab-prereq-btn.clab-btn-danger(type='button', *ngIf='s.type !== "local"', (click)='deleteServer(s.id)') Delete

      .clab-server-test-result(*ngIf='clabServerTestResult && !editingServer')
        .server-test-checks
          span.server-test-check([class.clab-ok]='clabServerTestResult.ssh', [class.clab-fail]='!clabServerTestResult.ssh')
            | SSH {{ clabServerTestResult.ssh ? '✓' : '✗' }}
          span.server-test-check([class.clab-ok]='clabServerTestResult.docker', [class.clab-fail]='!clabServerTestResult.docker')
            | Docker {{ clabServerTestResult.docker ? '✓' : '✗' }}
          span.server-test-check([class.clab-ok]='clabServerTestResult.clab', [class.clab-fail]='!clabServerTestResult.clab')
            | Containerlab {{ clabServerTestResult.clab ? '✓' : '✗' }}
          span.server-test-check([class.clab-ok]='clabServerTestResult.kvm', [class.clab-fail]='!clabServerTestResult.kvm')
            | KVM {{ clabServerTestResult.kvm ? '✓' : '✗' }}
        .server-test-summary
          span.clab-prereq-icon([class.clab-ok]='clabServerTestResult.ok', [class.clab-fail]='!clabServerTestResult.ok') {{ clabServerTestResult.ok ? '✓' : '✗' }}
