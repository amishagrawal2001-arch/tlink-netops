          span.vm-mgr-cell Name
          span.vm-mgr-cell State
          span.vm-mgr-cell Actions
        .vm-mgr-row(*ngFor='let vm of vmList')
          span.vm-mgr-cell {{ vm.name }}
          span.vm-mgr-cell
            span.vm-state-dot([class]='vmStateClass(vm.state)')
            | {{ vm.state }}
          span.vm-mgr-cell.vm-mgr-actions
            button.clab-prereq-btn(type='button', *ngIf='vm.state.includes("shut")', (click)='vmAction(vm.name, "start")') Start
            button.clab-prereq-btn(type='button', *ngIf='vm.state.includes("running")', (click)='vmAction(vm.name, "shutdown")') Stop
            button.clab-prereq-btn(type='button', *ngIf='vm.state.includes("running")', (click)='openVmConsole(vm.name)') Console
            button.clab-prereq-btn(type='button', (click)='loadVmSnapshots(vm.name)') Snapshots
            button.clab-prereq-btn(type='button', (click)='toggleVmAutostart(vm.name, !vm.autostart)', [title]='vm.autostart ? "Disable autostart" : "Enable autostart"', [style.opacity]='vm.autostart ? 1 : 0.5') ⚡
            button.clab-prereq-btn.clab-btn-danger(type='button', *ngIf='vm.state.includes("running")', (click)='vmAction(vm.name, "destroy")') Force Stop
            button.clab-prereq-btn.clab-btn-danger(type='button', *ngIf='vm.state.includes("shut")', (click)='confirmDeleteVm(vm.name)') Delete
          //- Inline snapshot list
          .vm-snapshot-list(*ngIf='vmSnapshotTarget === vm.name')
            .vm-snapshot-header
              span Snapshots for {{ vm.name }}
              button.clab-prereq-btn(type='button', (click)='createVmSnapshot(vm.name)') + New Snapshot
            .vm-snapshot-row(*ngFor='let snap of vmSnapshots')
              span.vm-snap-name {{ snap.name }}
              span.vm-snap-date {{ snap.created }}
              .vm-snap-actions
                button.clab-prereq-btn.vm-snap-restore(type='button', (click)='revertVmSnapshot(vm.name, snap.name)') Restore
                button.clab-prereq-btn.clab-btn-danger.vm-snap-restore(type='button', (click)='deleteVmSnapshot(vm.name, snap.name)') 🗑
            .vm-snapshot-empty(*ngIf='vmSnapshots.length === 0') No snapshots
      .vm-mgr-empty(*ngIf='!vmManagerLoading && vmList.length === 0 && !vmManagerError') No VMs found on this server
      .auto-ip-actions
        button.btn-tool(type='button', (click)='closeVmManager()') Close

  //- ── Bridge Manager ─────────────────────────────────────────────────
  .front-dialog-overlay(*ngIf='showBridgeManager')
    .auto-ip-dialog.vm-mgr-dialog.front-dialog-panel
      .auto-ip-title Bridge Manager
      .auto-ip-subtitle Discover and manage bridges on the selected server
      .clab-server-section
        .clab-server-row
          span.clab-server-label Server
          select.clab-server-select([ngModel]='clabActiveServerId', (ngModelChange)='switchBridgeManagerServer($event)')
            option(*ngFor='let s of clabServers', [value]='s.id') {{ s.name }}{{ s.type === 'ssh' && s.host && s.host !== s.name ? ' (' + s.host + ')' : '' }}
      .vm-mgr-toolbar
        button.clab-prereq-btn(type='button', (click)='refreshBridgeList()', [disabled]='bridgeManagerLoading') {{ bridgeManagerLoading ? 'Loading…' : 'Refresh' }}
        button.clab-prereq-btn(type='button', (click)='toggleBridgeCreateForm()') {{ showBridgeCreateForm ? 'Cancel' : '+ Create Bridge' }}
      //- Create bridge form
      .vm-create-form(*ngIf='showBridgeCreateForm')
        .form-row
          label.form-label Type
          select.form-input([(ngModel)]='bridgeCreateType')
            option(value='libvirt') Libvirt Network
            option(value='linux') Linux Bridge
            option(value='ovs') OVS Bridge
        .form-row
          label.form-label Name
          input.form-input(type='text', [(ngModel)]='bridgeCreateName', placeholder='br-fabric')
        //- Libvirt-specific fields
        .form-row(*ngIf='bridgeCreateType === "libvirt"')
          label.form-label Mode
          select.form-input([(ngModel)]='bridgeCreateMode')
            option(value='nat') NAT
            option(value='route') Routed
            option(value='isolated') Isolated
            option(value='bridge') Bridge
        .form-row(*ngIf='bridgeCreateType === "libvirt"')
          label.form-label Subnet (optional)
          input.form-input(type='text', [(ngModel)]='bridgeCreateSubnet', placeholder='192.168.100.1/24')
        .form-row(*ngIf='bridgeCreateType === "libvirt" && bridgeCreateSubnet')
          label.form-label
            input(type='checkbox', [(ngModel)]='bridgeCreateDhcp')
            |  Enable DHCP
        .form-row(*ngIf='bridgeCreateType === "libvirt" && bridgeCreateDhcp && bridgeCreateSubnet')
          label.form-label DHCP Range
          .host-iface-row
            input.form-input(type='text', [(ngModel)]='bridgeCreateDhcpStart', placeholder='Start IP', style='flex:1')
            input.form-input(type='text', [(ngModel)]='bridgeCreateDhcpEnd', placeholder='End IP', style='flex:1')
        //- Linux bridge fields
        .form-row(*ngIf='bridgeCreateType === "linux"')
          label.form-label IP Address (optional)
          input.form-input(type='text', [(ngModel)]='bridgeCreateIpAddress', placeholder='10.0.0.1/24')
        //- OVS fields
        .form-row(*ngIf='bridgeCreateType === "ovs"')
          label.form-label VXLAN Remote IP (optional)
          input.form-input(type='text', [(ngModel)]='bridgeCreateVxlanRemote', placeholder='10.0.0.2')
        .form-row(*ngIf='bridgeCreateType === "ovs" && bridgeCreateVxlanRemote')
          label.form-label VNI
          input.form-input(type='number', [(ngModel)]='bridgeCreateVni', min='1', max='16777215')
        .auto-ip-actions
          button.btn-tool(type='button', [disabled]='!bridgeCreateName || bridgeCreating', (click)='createBridge()') {{ bridgeCreating ? 'Creating…' : 'Create' }}
      //- Error
      .clab-prereq-msg.clab-fail(*ngIf='bridgeManagerError') {{ bridgeManagerError }}
      //- Bridge table
      .vm-mgr-table(*ngIf='bridgeList.length')
        .vm-mgr-row.vm-mgr-header.bridge-row
          span.vm-mgr-cell Name
          span.vm-mgr-cell Type
          span.vm-mgr-cell Info
          span.vm-mgr-cell Actions
        .vm-mgr-row.bridge-row(*ngFor='let br of bridgeList')
          span.vm-mgr-cell {{ br.name }}
          span.vm-mgr-cell
            span.bridge-type-badge([class]='"bridge-" + br.type') {{ br.type }}
          span.vm-mgr-cell.bridge-info-cell
            span(*ngIf='br.subnet') {{ br.subnet }}
            span(*ngIf='br.mode')  ({{ br.mode }})
            span(*ngIf='br.interfaces.length')  [{{ br.interfaces.join(", ") }}]
          span.vm-mgr-cell.vm-mgr-actions
            span.vm-state-dot([class]='bridgeStateClass(br.state)')
            button.clab-prereq-btn(type='button', *ngIf='br.type === "libvirt" && br.state.includes("inactive")', (click)='bridgeAction(br.name, "start")') Start
            button.clab-prereq-btn(type='button', *ngIf='br.type === "libvirt" && br.state.includes("active")', (click)='bridgeAction(br.name, "destroy")') Stop
            button.clab-prereq-btn.clab-btn-danger(type='button', (click)='deleteBridge(br)') Delete
      .vm-mgr-empty(*ngIf='!bridgeManagerLoading && bridgeList.length === 0 && !bridgeManagerError') No bridges found on this server
      .auto-ip-actions
        button.btn-tool(type='button', (click)='closeBridgeManager()') Close

  //- ── VXLAN Tunnel Setup ─────────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showVxlanDialog', (click)='closeVxlanDialog()')
    .auto-ip-dialog((click)='$event.stopPropagation()')
      .auto-ip-title VXLAN Tunnel Setup
      .auto-ip-subtitle Create a VXLAN tunnel between two servers for cross-server lab links
      .vm-create-form
        .form-row
          label.form-label Bridge Name
          input.form-input(type='text', [(ngModel)]='vxlanBridgeName', placeholder='cross-br-1')
        .form-row
          label.form-label Remote Server IP
          input.form-input(type='text', [(ngModel)]='vxlanRemoteIp', placeholder='10.0.0.2')
        .form-row
          label.form-label VNI
          input.form-input(type='number', [(ngModel)]='vxlanVni', min='1', max='16777215')
        .form-row
          label.form-label Method
          select.form-input([(ngModel)]='vxlanMethod')
            option(value='linux') Linux VXLAN
            option(value='ovs') OVS VXLAN
        .clab-prereq-msg.clab-fail(*ngIf='vxlanError') {{ vxlanError }}
        .auto-ip-actions
          button.btn-tool(type='button', [disabled]='!vxlanBridgeName || !vxlanRemoteIp || vxlanCreating', (click)='createVxlanTunnel()') {{ vxlanCreating ? 'Creating…' : 'Create Tunnel' }}
          button.btn-tool(type='button', (click)='closeVxlanDialog()') Cancel

  //- ── Live Status Panel ──────────────────────────────────────────────
  .live-status-panel(*ngIf='showLivePanel && livePollingActive')
    .live-status-header
      span.live-dot ●
      span Live
      button.live-close(type='button', (click)='stopLivePolling()') ✕
    .live-status-body
      .live-stat
        span.live-label Nodes
        span.live-value([class.all-good]='liveSummary.nodesUp === liveSummary.nodesTotal')
          | {{ liveSummary.nodesUp }}/{{ liveSummary.nodesTotal }}
      .live-stat
        span.live-label BGP
        span.live-value([class.all-good]='liveSummary.bgpUp === liveSummary.bgpTotal && liveSummary.bgpTotal > 0')
          | {{ liveSummary.bgpUp }}/{{ liveSummary.bgpTotal }}
    .live-status-footer
      span Polling every {{ livePollingInterval / 1000 }}s

  //- ── Device Import Report overlay ─────────────────────────────────────
  .auto-ip-overlay(*ngIf='showDeviceImportReport', (click)='closeDeviceImportReport()')
    .auto-ip-dialog.import-report-dialog((click)='$event.stopPropagation()')
      .auto-ip-title {{ deviceImportPreview ? 'Import Preview (Dry Run)' : 'Device Import Report' }}
      .import-report-summary(*ngIf='deviceImportResult')
        .import-stat
          span.import-stat-num {{ deviceImportResult.matched }}
          span  {{ deviceImportPreview ? 'will match' : 'matched' }} of {{ deviceImportResult.total }} records
        .import-stat
          span.import-stat-detail {{ deviceImportResult.hostnameMatches }} by hostname, {{ deviceImportResult.mgmtIpMatches }} by mgmt IP
        .import-stat(*ngIf='deviceImportResult.unmatched > 0')
          span.import-stat-warn {{ deviceImportResult.unmatched }} record{{ deviceImportResult.unmatched === 1 ? '' : 's' }} will not match any topology node
      .import-report-section(*ngIf='deviceImportResult && deviceImportResult.matchedDetails.length > 0')
        .import-report-subtitle ✓ {{ deviceImportPreview ? 'Will Match' : 'Matched' }} ({{ deviceImportResult.matchedDetails.length }})
        .import-report-table.cols-3
          .import-report-row.import-report-header
            span CSV Record
            span → Topology Node
            span Match Type
          .import-report-row(*ngFor='let m of deviceImportResult.matchedDetails')
            span {{ m.record.hostname || m.record.mgmtIp || '—' }}
            span {{ m.nodeLabel }}
            span {{ m.matchedBy }}
      .import-report-section(*ngIf='deviceImportResult && deviceImportResult.unmatchedRecords.length > 0')
        .import-report-subtitle ⚠ Unmatched Records ({{ deviceImportResult.unmatchedRecords.length }})
        .import-report-table
          .import-report-row.import-report-header
            span Hostname
            span Mgmt IP
            span Vendor
            span Model
          .import-report-row(*ngFor='let rec of deviceImportResult.unmatchedRecords')
            span {{ rec.hostname || '—' }}
            span {{ rec.mgmtIp || '—' }}
            span {{ rec.vendor || '—' }}
            span {{ rec.model || '—' }}
      .auto-ip-actions
        button.btn-secondary(
          *ngIf='deviceImportPreview',
          type='button',
          [disabled]='!deviceImportResult || deviceImportResult.matched === 0',
          (click)='applyDeviceImport()'
        ) Apply {{ deviceImportResult?.matched }} Match{{ deviceImportResult?.matched === 1 ? '' : 'es' }}
        button.btn-ghost(type='button', (click)='closeDeviceImportReport()') {{ deviceImportPreview ? 'Cancel' : 'Close' }}

  //- ── Monitoring Dashboard overlay ─────────────────────────────────────
  .dashboard-fullscreen(*ngIf='showDashboard')
    .dashboard-header
      span.dashboard-title Monitoring Dashboard
      button.dashboard-close(type='button', (click)='closeDashboard()') ✕
    .dashboard-body
      //- Summary cards
      .dashboard-cards
        .dashboard-card.card-up
          .card-value {{ dashboardSummary.up }}
          .card-label Devices Up
        .dashboard-card.card-down
          .card-value {{ dashboardSummary.down }}
          .card-label Devices Down
        .dashboard-card.card-unknown
          .card-value {{ dashboardSummary.unknown }}
          .card-label Unknown
        .dashboard-card.card-critical(*ngIf='dashboardSummary.critical > 0')
          .card-value {{ dashboardSummary.critical }}
          .card-label Critical
        .dashboard-card.card-major(*ngIf='dashboardSummary.major > 0')
          .card-value {{ dashboardSummary.major }}
          .card-label Major
        .dashboard-card.card-minor(*ngIf='dashboardSummary.minor > 0')
          .card-value {{ dashboardSummary.minor }}
          .card-label Minor
        .dashboard-card.card-warning(*ngIf='dashboardSummary.warning > 0')
          .card-value {{ dashboardSummary.warning }}
          .card-label Warning

      //- Alarm table
      .dashboard-section
        .dashboard-section-header
          span.dashboard-section-title Active Alarms ({{ dashboardAlarms.length }})
          .dashboard-sort
            button.btn-ghost-sm(type='button', [class.active]='dashboardAlarmSort === "time"', (click)='dashboardAlarmSort = "time"') By Time
            button.btn-ghost-sm(type='button', [class.active]='dashboardAlarmSort === "severity"', (click)='dashboardAlarmSort = "severity"') By Severity
        .dashboard-alarm-table(*ngIf='dashboardAlarms.length > 0')
          .dashboard-alarm-row.alarm-header
            span Severity
            span Device
            span Category
            span Message
            span Time
            span Actions
          .dashboard-alarm-row(*ngFor='let a of dashboardAlarms', [class]='\"alarm-sev-\" + a.severity')
            span.alarm-sev-badge {{ a.severity }}
            span {{ dashboardNodeLabel(a.nodeId) }}
            span {{ a.category }}
            span.alarm-msg {{ a.message }}
            span {{ a.raisedAt | date:"short" }}
            span.alarm-actions
              button.btn-ghost-xs(type='button', *ngIf='!a.acknowledged', (click)='invSvc.acknowledgeAlarm(a.id); cdr.markForCheck()') Ack
              button.btn-ghost-xs(type='button', (click)='invSvc.clearAlarm(a.id); cdr.markForCheck()') Clear
        .dashboard-empty(*ngIf='dashboardAlarms.length === 0') No active alarms

      //- Device health grid
      .dashboard-section
        .dashboard-section-header
          span.dashboard-section-title Device Health ({{ dashboardDeviceHealth.length }})
        .dashboard-health-grid
          .dashboard-health-card(*ngFor='let d of dashboardDeviceHealth', [class]='\"health-status-\" + d.status')
            .health-card-header
              span.health-card-label {{ d.label }}
              span.health-status-dot([class]='\"dot-\" + d.status')
            .health-card-body
              .health-row(*ngIf='d.vendor')
                span.health-key Vendor
                span.health-val {{ d.vendor }}
              .health-row(*ngIf='d.osVersion')
                span.health-key OS
                span.health-val {{ d.osVersion }}
              .health-row(*ngIf='d.uptime')
                span.health-key Uptime
                span.health-val {{ d.uptime }}
              .health-row
                span.health-key CPU
                span.health-val([class.health-high]='d.cpu !== null && d.cpu > 80') {{ d.cpu !== null ? d.cpu + "%" : "—" }}
              .health-row
                span.health-key Memory
                span.health-val([class.health-high]='d.mem !== null && d.mem > 80') {{ d.mem !== null ? d.mem + "%" : "—" }}
            .health-card-alarm(*ngIf='d.alarmSeverity')
              span.alarm-sev-badge {{ d.alarmSeverity }}
        .dashboard-empty(*ngIf='dashboardDeviceHealth.length === 0') No mapped devices. Assign management IPs and credentials to devices to monitor them.

  //- ── Post-deploy progress banner ──────────────────────────────────────
  .clab-deploy-banner(*ngIf='clabPostDeployMsg')
    .deploy-banner-spinner
    span {{ clabPostDeployMsg }}

  //- ── Quick action buttons (bottom-left floating) ───────────────────────
  .canvas-quick-actions(*ngIf='hasConfigs')
    button.quick-action-btn.qa-pull(
      type='button',
      title='Pull running configs from devices & save',
      [disabled]='configSyncRunning',
      (click)='pullAndSaveConfigs()'
    )
      span.qa-icon {{ configSyncRunning ? '⏳' : '⬇' }}
      span.qa-label Pull
    button.quick-action-btn.qa-push(
      type='button',
      title='Push all configs to devices',
      [disabled]='configPushAllRunning',
      (click)='pushAllConfigs()'
    )
      span.qa-icon {{ configPushAllRunning ? '⏳' : '⬆' }}
      span.qa-label Push
    button.quick-action-btn.qa-save(
      type='button',
      title='Save topology file (Ctrl+S)',
      (click)='saveTopology()'
    )
      span.qa-icon 💾
      span.qa-label Save
    button.quick-action-btn.qa-export(
      type='button',
      title='Export all configs as files',
      (click)='exportAllConfigs()'
    )
      span.qa-icon 📋
      span.qa-label Export

  //- ── Operation progress banner ──────────────────────────────────────────
  .operation-progress(*ngIf='operationProgress')
    .op-spinner
    span.op-text {{ operationProgress }}

  //- ── Status bar ─────────────────────────────────────────────────────────
  .netops-statusbar
    span.status-dot([class.dot-pending]='!!pendingLink')
    span {{ statusMsg }}
    span.status-hint(*ngIf='pendingLink')  — click target node to connect, or Esc to cancel
    span.status-hint(*ngIf='linkModeActive && !pendingLink && !hasPendingPath')  — Link Mode: drag or click a node to start a link (Esc to exit)
    span.status-alarms(*ngIf='activeAlarmCount > 0', (click)='toggleAlarmPanel()')
      span.status-alarm-dot([class.critical]='criticalAlarmCount > 0')
      | {{ activeAlarmCount }} alarm{{ activeAlarmCount === 1 ? '' : 's' }}
    span.import-error(*ngIf='importError')  ⚠ {{ importError }}
    span.import-error(*ngIf='deviceMapError')  ⚠ {{ deviceMapError }}

  //- ── Troubleshoot dialog (top-level to avoid transform/overflow issues) ──
  .ts-overlay(
    *ngIf='tsDialogVisible',
    (click)='tsDialogVisible = false'
  )
    .ts-dialog((click)='$event.stopPropagation()')
      .ts-header
        span.ts-title 🔧 Troubleshooting: {{ tsNodeLabel }}
        button.ts-close(type='button', (click)='tsDialogVisible = false') ✕
      .ts-body
        .ts-section(*ngFor='let section of tsSections')
          .ts-section-header((click)='section.open = !section.open')
            span.ts-chevron {{ section.open ? '▾' : '▸' }}
            span {{ section.title }}
          .ts-section-content(*ngIf='section.open')
            .ts-cmd(*ngFor='let cmd of section.commands')
              code.ts-cmd-text {{ cmd.command }}
              span.ts-cmd-desc(*ngIf='cmd.description')  {{ cmd.description }}

  //- ── Welcome Dialog ───────────────────────────────────────────────────────
  .welcome-overlay(
    *ngIf='showWelcomeDialog',
    (click)='dismissWelcome()'
  )
    .welcome-dialog((click)='$event.stopPropagation()')
      .welcome-header
        .welcome-logo
          svg(width='48', height='48', viewBox='0 0 48 48')
            defs
              linearGradient#welcome-grad(x1='0%', y1='0%', x2='100%', y2='100%')
                stop(offset='0%', stop-color='#3b82f6')
                stop(offset='100%', stop-color='#8b5cf6')
            circle(cx='24', cy='24', r='22', fill='url(#welcome-grad)', opacity='0.9')
            path(d='M16,24 L24,16 L32,24 L24,32 Z', fill='#fff', opacity='0.9')
        h2.welcome-title Welcome to NetOps
        p.welcome-subtitle Build and visualize network topologies with ease
      .welcome-features
        .welcome-feature-card(*ngFor='let f of welcomeFeatures')
          .wf-icon {{ f.icon }}
          .wf-title {{ f.title }}
          .wf-desc {{ f.desc }}
      .welcome-footer
        label.welcome-checkbox
          input(type='checkbox', [(ngModel)]='welcomeDontShowAgain')
          span Don't show again
        .welcome-actions
          button.welcome-btn.welcome-btn-secondary(type='button', (click)='dismissWelcome()') Skip
          button.welcome-btn.welcome-btn-primary(type='button', (click)='startTourFromWelcome()') Start Tour

  //- ── Interactive Tour Overlay ─────────────────────────────────────────────
  .tour-overlay(*ngIf='showTour')
    .tour-backdrop-top([style.height.px]='tourHighlightRect.top')
    .tour-backdrop-left(
      [style.top.px]='tourHighlightRect.top',
      [style.width.px]='tourHighlightRect.left',
      [style.height.px]='tourHighlightRect.height'
    )
    .tour-backdrop-right(
      [style.top.px]='tourHighlightRect.top',
      [style.left.px]='tourHighlightRect.left + tourHighlightRect.width',
      [style.height.px]='tourHighlightRect.height'
    )
    .tour-backdrop-bottom(
      [style.top.px]='tourHighlightRect.top + tourHighlightRect.height'
    )
    .tour-highlight(
      [style.top.px]='tourHighlightRect.top',
      [style.left.px]='tourHighlightRect.left',
      [style.width.px]='tourHighlightRect.width',
      [style.height.px]='tourHighlightRect.height'
    )
    .tour-tooltip([ngStyle]='tourTooltipStyle')
      .tour-tooltip-header
        span.tour-step-badge {{ tourStep + 1 }} / {{ tourSteps.length }}
        button.tour-close(type='button', (click)='endTour()') ✕
      h3.tour-tooltip-title {{ tourSteps[tourStep].title }}
      p.tour-tooltip-desc {{ tourSteps[tourStep].description }}
      .tour-tooltip-actions
        button.tour-btn.tour-btn-secondary(
          type='button',
          [disabled]='tourStep === 0',
          (click)='prevTourStep()'
        ) Previous
        button.tour-btn.tour-btn-secondary(type='button', (click)='endTour()') Skip
        button.tour-btn.tour-btn-primary(type='button', (click)='nextTourStep()')
          | {{ tourStep === tourSteps.length - 1 ? 'Finish' : 'Next' }}

  //- ── Help Panel (slide-out from right) ────────────────────────────────────
  .help-panel-overlay(
    *ngIf='showHelpPanel',
    (click)='showHelpPanel = false'
  )
  .help-panel(
    [class.help-panel-open]='showHelpPanel'
  )
    .help-panel-header
      .help-panel-header-left
        span.help-panel-header-icon 📖
        h3.help-panel-title Help Center
      button.help-panel-close(type='button', (click)='showHelpPanel = false') ✕
    .help-panel-search
      .help-search-wrapper
        span.help-search-icon 🔍
        input.help-search-input(
          type='text',
          placeholder='Search help topics…',
          [(ngModel)]='helpSearchQuery',
          (click)='$event.stopPropagation()'
        )
        button.help-search-clear(
          *ngIf='helpSearchQuery',
          type='button',
          (click)='helpSearchQuery = ""'
        ) ✕
    //- ── Quick Actions Bar ──────────────────────────────────────────────────
    .help-quick-actions
      button.help-qa-btn(type='button', (click)='helpStartTour()')
        span.help-qa-icon ◎
        span Start Tour
      button.help-qa-btn(type='button', (click)='helpLoadTemplate("hub-and-spoke")')
        span.help-qa-icon ▤
        span Templates
      button.help-qa-btn(type='button', (click)='helpToggleGrid()', [class.help-qa-active]='showGrid')
        span.help-qa-icon ⊞
        span Grid {{ showGrid ? 'On' : 'Off' }}
      button.help-qa-btn(type='button', (click)='helpToggleMinimap()', [class.help-qa-active]='showMinimap')
        span.help-qa-icon ◫
        span Minimap {{ showMinimap ? 'On' : 'Off' }}
      button.help-qa-btn(type='button', (click)='helpOpenShortcuts()')
        span.help-qa-icon ⌨
        span Shortcuts
    .help-panel-body((scroll)='onHelpPanelScroll($event)')
      //- ── No Results ─────────────────────────────────────────────────────
      .help-no-results(*ngIf='filteredHelpSections.length === 0 && helpSearchQuery')
        .help-no-results-icon 🔍
        p.help-no-results-text No results for "{{ helpSearchQuery }}"
        p.help-no-results-hint Try searching for:
        .help-no-results-suggestions
          button.help-suggestion-chip(
            *ngFor='let s of helpNoResultsSuggestions',
            type='button',
            (click)='helpSearchQuery = s'
          ) {{ s }}
      //- ── Sections ───────────────────────────────────────────────────────
      .help-section(
        *ngFor='let section of filteredHelpSections',
        [class.help-section-active]='helpActiveSection === section.id',
        [attr.id]='"help-section-" + section.id'
      )
        .help-section-header((click)='helpActiveSection = helpActiveSection === section.id ? "" : section.id')
          span.help-section-icon {{ section.icon }}
          span.help-section-title([innerHTML]='highlightHelpMatch(section.title) | safeHtml')
          span.help-section-chevron {{ helpActiveSection === section.id ? '▾' : '▸' }}
        .help-section-content(*ngIf='helpActiveSection === section.id')
          div([innerHTML]='section.content | safeHtml')
          //- ── Subsections ────────────────────────────────────────────────
          .help-subsection(*ngFor='let sub of section.subsections')
            .help-subsection-header((click)='sub._open = !sub._open')
              span.help-subsection-title {{ sub.title }}
              span.help-subsection-chevron {{ sub._open ? '▾' : '▸' }}
            .help-subsection-content(*ngIf='sub._open')
              div([innerHTML]='sub.content | safeHtml')
      //- ── Back to Top ────────────────────────────────────────────────────
      button.help-back-to-top(
        *ngIf='helpScrolledDown',
        type='button',
        (click)='scrollHelpToTop()'
      ) ↑ Back to top
    .help-panel-footer
      .help-footer-top
        button.help-footer-btn.help-footer-primary(type='button', (click)='helpStartTour()')
          span ◎
          span Take a Tour
        button.help-footer-btn(type='button', (click)='helpOpenShortcuts()')
          span ⌨
          span Shortcuts
      .help-footer-bottom
        span.help-footer-version v1.0.0
        span.help-footer-sep ·
        a.help-footer-link(href='javascript:void(0)') Report a Bug

  //- ── Embedded Terminal Panel ────────────────────────────────────────────────
  terminal-panel(
    *ngIf='showTerminalPanel',
    #terminalPanel='',
    [visible]='showTerminalPanel',
    (visibleChange)='showTerminalPanel = $event'
  )

  //- ── Splash Screen ──────────────────────────────────────────────────────────
  .splash-overlay(*ngIf='showSplashScreen')
    .splash-content
      .splash-logo
        svg(width='72', height='72', viewBox='0 0 48 48')
          defs
            linearGradient#splash-grad(x1='0%', y1='0%', x2='100%', y2='100%')
              stop(offset='0%', stop-color='#3b82f6')
              stop(offset='100%', stop-color='#8b5cf6')
          circle(cx='24', cy='24', r='22', fill='url(#splash-grad)', opacity='0.9')
          path(d='M16,24 L24,16 L32,24 L24,32 Z', fill='#fff', opacity='0.9')
      .splash-title Tlink NetOps
      .splash-version v1.0.0
      .splash-spinner
        .splash-spinner-bar

  //- ── License Activation Dialog ──────────────────────────────────────────────
  .license-overlay(*ngIf='showLicenseDialog && !showSplashScreen', (click)='showLicenseDialog = false')
    .license-dialog((click)='$event.stopPropagation()')
      button.license-dialog-close(type='button', (click)='showLicenseDialog = false', title='Close') ✕
      .license-dialog-header
        .license-dialog-logo
          svg(width='40', height='40', viewBox='0 0 48 48')
            defs
              linearGradient#lic-grad(x1='0%', y1='0%', x2='100%', y2='100%')
                stop(offset='0%', stop-color='#3b82f6')
                stop(offset='100%', stop-color='#8b5cf6')
            circle(cx='24', cy='24', r='22', fill='url(#lic-grad)', opacity='0.9')
            path(d='M16,24 L24,16 L32,24 L24,32 Z', fill='#fff', opacity='0.9')
        h2.license-dialog-title(
          *ngIf='licenseSvc.licenseStatus === "expired"'
        ) Trial Expired
        h2.license-dialog-title(
          *ngIf='licenseSvc.licenseStatus !== "expired"'
        ) Activate Tlink NetOps
        p.license-dialog-subtitle Enter your license key to continue, or start a free trial.
      .license-dialog-body
        .license-input-group
          label.license-label License Key
          input.license-input(
            type='text',
            placeholder='TLINK-XXXX-XXXX-XXXX-XXXX',
            [(ngModel)]='licenseKeyInput',
            (keyup.enter)='onActivateLicense()'
          )
          .license-error(*ngIf='licenseActivationError') {{ licenseActivationError }}
        .license-actions
          button.license-btn.license-btn-primary(type='button', (click)='onActivateLicense()') Activate
          button.license-btn.license-btn-secondary(
            *ngIf='!licenseSvc.trialStarted',
            type='button',
            (click)='onStartTrial()'
          ) Start Free Trial (14 days)
        .license-buy-link
          a(href='https://tlink.io/pricing', target='_blank') Buy a license at tlink.io
      .license-dialog-footer
        span (c) 2026 Tlink Technologies

  //- ── Admin Panel (Ctrl+Shift+L) ──────────────────────────────────────────
  .admin-panel-overlay(*ngIf='showAdminPanel', (click)='toggleAdminPanel()')
    .admin-panel((click)='$event.stopPropagation()')
      .admin-panel-header
        h3.admin-panel-title License Admin
        button.admin-panel-close(type='button', (click)='toggleAdminPanel()') &times;
      .admin-panel-body
        .admin-row
          .admin-label License Key
          .admin-value.admin-mono {{ licenseSvc.maskedKey || 'None' }}
        .admin-row
          .admin-label Status
          .admin-value
            span.admin-status-badge(
              [class.status-active]='licenseSvc.licenseStatus === "active"',
              [class.status-trial]='licenseSvc.licenseStatus === "trial"',
              [class.status-expired]='licenseSvc.licenseStatus === "expired"',
              [class.status-invalid]='licenseSvc.licenseStatus === "invalid"'
            ) {{ licenseSvc.licenseStatus | uppercase }}
        .admin-row
          .admin-label Tier
          .admin-value {{ licenseSvc.tierDisplayName }}
        .admin-row
          .admin-label Expiry
          .admin-value {{ licenseSvc.formattedExpiry || 'N/A' }}
        .admin-row
          .admin-label Machine ID
          .admin-value.admin-mono {{ licenseSvc.getMachineId() }}
      .admin-panel-footer
        button.admin-btn-deactivate(
          type='button',
          *ngIf='licenseSvc.licenseStatus === "active"',
          (click)='onDeactivateLicense()'
        ) Deactivate License

  //- ── License Server Settings Dialog ──
  .admin-panel-overlay(*ngIf='showServerSettings', (click)='showServerSettings = false')
    .admin-panel((click)='$event.stopPropagation()', style='max-width: 480px')
      .admin-panel-header
        h3.admin-panel-title License Server Settings
        button.admin-panel-close(type='button', (click)='showServerSettings = false') &times;
      .admin-panel-body
        .admin-detail-row
          .admin-detail-label Server URL
          .admin-detail-value(style='flex: 1')
            input.server-url-input(
              type='text',
              [(ngModel)]='serverUrlInput',
              placeholder='http://localhost:4000',
              style='width: 100%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; font-family: monospace'
            )
        .admin-detail-row(style='margin-top: 8px')
          .admin-detail-label Status
          .admin-detail-value
            span.admin-badge(
              [class.admin-badge-active]='serverReachable === true',
              [class.admin-badge-expired]='serverReachable === false',
              [style.background]='serverReachable === null ? "#fefcbf" : ""',
              [style.color]='serverReachable === null ? "#744210" : ""'
            ) {{ serverReachable === true ? 'Connected' : serverReachable === false ? 'Unreachable' : 'Not checked' }}
        .admin-detail-row(style='margin-top: 8px')
          .admin-detail-label Current
          .admin-detail-value(style='font-family: monospace; font-size: 13px; color: #888') {{ licenseSvc.licenseServerUrl }}
        p(style='margin-top: 16px; font-size: 12px; color: #888') Enter the license server URL including protocol and port. Example: https://license.tlink.io or http://192.168.1.100:4000
      .admin-panel-footer(style='display: flex; gap: 8px')
        button(
          type='button',
          (click)='testServerConnection()',
          style='padding: 8px 16px; background: #667eea; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 13px'
        ) Test Connection
        button(
          type='button',
          (click)='saveServerUrl()',
          style='padding: 8px 16px; background: #38a169; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 13px'
        ) Save
