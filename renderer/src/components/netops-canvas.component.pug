            span.server-test-check([class.clab-ok]='clabServerTestResult.clab', [class.clab-fail]='!clabServerTestResult.clab')
              | Containerlab {{ clabServerTestResult.clab ? '✓' : '✗' }}
            span.server-test-check([class.clab-ok]='clabServerTestResult.kvm', [class.clab-fail]='!clabServerTestResult.kvm')
