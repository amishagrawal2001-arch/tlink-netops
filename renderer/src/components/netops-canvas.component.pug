        button.btn-tool(type='button', *ngIf='editingServer', (click)='editingServer = null')
          span Cancel
        button.btn-tool(type='button', *ngIf='editingServer', (click)='saveServer()')
          span Save
        button.btn-tool(type='button', *ngIf='!editingServer', (click)='closeClabServerSettings()')
          span Close

  //- ── Docker Image Manager overlay ────────────────────────────────
  .auto-ip-overlay(*ngIf='showImageManager', (click)='closeImageManager()')
    .auto-ip-dialog.image-mgr-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Docker Image Manager
      .image-mgr-server-row
        span.clab-server-label Compute Host
        select.clab-server-select(
          [ngModel]='clabActiveServerId',
          (ngModelChange)='switchImageManagerServer($event)'
        )
          option(*ngFor='let s of clabServers', [value]='s.id') {{ s.name }}{{ s.type === 'ssh' && s.host && s.host !== s.name ? ' (' + s.host + ')' : '' }}
      .auto-ip-subtitle(*ngIf='!imageManagerLoading') {{ allDockerImages.length }} image(s) on {{ activeClabServerName }}{{ imageManagerHostArch ? ' · ' + imageManagerHostArch : '' }}
      .auto-ip-subtitle(*ngIf='imageManagerLoading') Loading images on {{ activeClabServerName }}…

      //- Disk usage summary
      .image-mgr-disk-usage(*ngIf='dockerDiskUsage.length > 0 && !imageManagerLoading')
        span.image-mgr-disk-item(*ngFor='let d of dockerDiskUsage')
          strong {{ d.type }}:
          |  {{ d.size }} ({{ d.count }})
          span.image-mgr-disk-reclaim  · Reclaimable: {{ d.reclaimable }}

      //- Bulk delete bar
      .image-mgr-bulk-bar(*ngIf='imageManagerSelected.size > 0 && !imageManagerLoading')
        span {{ imageManagerSelected.size }} selected
        button.clab-prereq-btn.clab-btn-danger(type='button', (click)='deleteSelectedImages()') Delete Selected

      //- Image list
      .image-mgr-table(*ngIf='allDockerImages.length > 0 && !imageManagerLoading')
        .image-mgr-row.image-mgr-header
          span.image-mgr-checkbox-col
            input(type='checkbox', [checked]='allImagesSelected', (change)='toggleSelectAllImages()')
          span.image-mgr-sortable((click)='toggleImageSort("name")')
            | Name : Tag
            span.image-mgr-sort-arrow(*ngIf='imageSortField === "name"') {{ imageSortDir === 'asc' ? ' ▲' : ' ▼' }}
          span.image-mgr-sortable((click)='toggleImageSort("size")')
            | Size
            span.image-mgr-sort-arrow(*ngIf='imageSortField === "size"') {{ imageSortDir === 'asc' ? ' ▲' : ' ▼' }}
          span.image-mgr-sortable((click)='toggleImageSort("arch")')
            | Arch
            span.image-mgr-sort-arrow(*ngIf='imageSortField === "arch"') {{ imageSortDir === 'asc' ? ' ▲' : ' ▼' }}
          span.image-mgr-sortable((click)='toggleImageSort("created")')
            | Age
            span.image-mgr-sort-arrow(*ngIf='imageSortField === "created"') {{ imageSortDir === 'asc' ? ' ▲' : ' ▼' }}
          span Actions
        .image-mgr-row(*ngFor='let img of sortedDockerImages')
          span.image-mgr-checkbox-col
            input(type='checkbox', [checked]='imageManagerSelected.has(img.name)', (change)='toggleImageSelect(img.name)')
          span.image-mgr-name(title='{{ img.name }}') {{ img.name }}
          span {{ img.size }}
          span
            span.clab-arch-warn(*ngIf='img.archMismatch') ⚠ {{ img.arch }}
            span(*ngIf='!img.archMismatch') {{ img.arch }}
          span {{ img.created }}
          span.image-mgr-actions
            button.clab-prereq-btn(type='button', (click)='startTagImage(img.name)') Tag
            button.clab-prereq-btn.clab-btn-danger(type='button', (click)='deleteDockerImage(img.name)') Delete

        //- Inline tag row
        .image-mgr-tag-row(*ngIf='imageTagSource')
          span.image-mgr-tag-label Tag
            strong  {{ imageTagSource }}
            |  as:
          input.auto-ip-input.image-mgr-tag-input(type='text', [(ngModel)]='imageTagTarget', placeholder='e.g. crpd:latest', (keydown.enter)='applyTagImage()')
          button.clab-prereq-btn(type='button', (click)='applyTagImage()') Apply
          button.clab-prereq-btn(type='button', (click)='cancelTagImage()') Cancel

      .auto-ip-subtitle(*ngIf='allDockerImages.length === 0 && !imageManagerLoading') No Docker images found.

      //- Pull image from registry
      .image-mgr-pull-row
        input.auto-ip-input.image-mgr-pull-input(type='text', [(ngModel)]='imagePullName', placeholder='e.g. ios-xr/xrd-control-plane:latest', [disabled]='imagePulling', (keydown.enter)='pullDockerImage()')
        button.clab-prereq-btn(type='button', [disabled]='imagePulling || !imagePullName.trim()', (click)='pullDockerImage()')
          | {{ imagePulling ? 'Pulling…' : 'Pull Image' }}
      .image-mgr-hints(*ngIf='!imagePulling')
        span.image-mgr-hints-label Quick:
        button.image-mgr-hint-btn(*ngFor='let h of imageRepoHints', type='button', (click)='imagePullName = h.image', [title]='h.image')
          | {{ h.label }}
      .clab-image-loading(*ngIf='imagePulling')
        span.clab-prereq-icon ⟳
        span.clab-prereq-msg {{ dockerProgressMsg || ('Pulling ' + imagePullName + '…') }}
      .auto-ip-error(*ngIf='imagePullError') ⚠ {{ imagePullError }}

      //- Docker Hub Search
      .image-mgr-search-row
        input.auto-ip-input.image-mgr-pull-input(type='text', [(ngModel)]='dockerSearchTerm', placeholder='Search Docker Hub…', [disabled]='dockerSearching', (keydown.enter)='searchDockerHub()')
        button.clab-prereq-btn(type='button', [disabled]='dockerSearching || !dockerSearchTerm.trim()', (click)='searchDockerHub()')
          | {{ dockerSearching ? 'Searching…' : 'Search Hub' }}
      .image-mgr-search-results(*ngIf='dockerSearchResults.length > 0')
        .image-mgr-search-item(*ngFor='let r of dockerSearchResults', (click)='selectSearchResult(r.name)')
          span.image-mgr-search-name {{ r.name }}
            span.image-mgr-search-official(*ngIf='r.official')  ✓ Official
          span.image-mgr-search-stars ★ {{ r.stars }}
          span.image-mgr-search-desc {{ r.description }}

      //- Loading progress (reuse from import)
      .clab-image-loading(*ngIf='clabLoadingImage')
        span.clab-prereq-icon ⟳
        span.clab-prereq-msg {{ dockerProgressMsg || clabLoadingImageMsg }}

      .auto-ip-error(*ngIf='imageManagerError') ⚠ {{ imageManagerError }}

      .auto-ip-actions
        button.btn-tool(type='button', [disabled]='clabLoadingImage', (click)='importDockerImageFromManager()')
          span {{ clabLoadingImage ? 'Loading…' : 'Import Image File' }}
        button.btn-tool(type='button', (click)='openVrnetlabBuilder()')
          span Build vrnetlab Image
        button.btn-tool(type='button', [disabled]='imageManagerLoading', (click)='loadAllImages()')
          span {{ imageManagerLoading ? 'Refreshing…' : 'Refresh' }}
        button.btn-tool(type='button', (click)='closeImageManager()')
          span Close

  //- ── Lab Snapshot Dialog ──────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showSnapshotDialog', (click)='showSnapshotDialog = false')
    .auto-ip-dialog.snapshot-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Lab Snapshots
      .auto-ip-subtitle {{ clabContainers.length }} container(s) · {{ snapshotList.length }} existing snapshot(s)
      .snapshot-create-row
        input.auto-ip-input(type='text', [(ngModel)]='snapshotName', placeholder='Snapshot name', [disabled]='snapshotCreating')
        button.clab-prereq-btn(type='button', [disabled]='snapshotCreating || !clabContainers.length', (click)='createSnapshot()')
          | {{ snapshotCreating ? 'Creating…' : 'Create Snapshot' }}
      .snapshot-list(*ngIf='snapshotList.length > 0')
        .snapshot-item(*ngFor='let s of snapshotList')
          span.snapshot-image {{ s.image }}
          span.snapshot-meta {{ s.size }} · {{ s.created }}
      .auto-ip-subtitle(*ngIf='snapshotList.length === 0') No snapshots found.
      .auto-ip-actions
        button.btn-tool(type='button', (click)='showSnapshotDialog = false') Close

  //- ── File Browser Dialog ──────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showFileBrowser', (click)='showFileBrowser = false')
    .auto-ip-dialog.file-browser-dialog((click)='$event.stopPropagation()')
      .auto-ip-title File Browser
      .file-browser-breadcrumb
        button.file-browser-crumb(type='button', (click)='browseDir("/")') /
        span.file-browser-path {{ fileBrowserPath }}
        button.clab-prereq-btn(type='button', (click)='navigateUp()', [disabled]='fileBrowserPath === "/"') ↑ Up
      .file-browser-loading(*ngIf='fileBrowserLoading') Loading…
      .file-browser-list(*ngIf='!fileBrowserLoading && !fileBrowserViewingFile')
        .file-browser-item(*ngFor='let f of fileBrowserItems', (click)='f.isDir ? browseDir(fileBrowserPath === "/" ? "/" + f.name : fileBrowserPath + "/" + f.name) : viewFile(f.name)')
          span.file-browser-icon {{ f.isDir ? '📁' : '📄' }}
          span.file-browser-name {{ f.name }}
          span.file-browser-size(*ngIf='!f.isDir') {{ formatFileSize(f.size) }}
      .file-browser-viewer(*ngIf='fileBrowserViewingFile')
        .file-browser-viewer-header
          span Viewing: {{ fileBrowserViewingFile }}
          button.clab-prereq-btn(type='button', (click)='fileBrowserViewingFile = ""; fileBrowserFileContent = ""') Back
        pre.file-browser-content {{ fileBrowserFileContent }}
      .auto-ip-actions
        button.btn-tool(type='button', (click)='showFileBrowser = false') Close

  //- ── Topology Diff Dialog ──────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showTopoDiff', (click)='showTopoDiff = false')
    .auto-ip-dialog.topo-diff-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Topology Diff — Saved vs Current
      .topo-diff-output
        .topo-diff-line(*ngFor='let d of topoDiffLines', [ngClass]='{"diff-add": d.type === "add", "diff-remove": d.type === "remove", "diff-same": d.type === "same"}') {{ d.type === 'add' ? '+ ' : d.type === 'remove' ? '- ' : '  ' }}{{ d.text }}
      .auto-ip-actions
        button.btn-tool(type='button', (click)='showTopoDiff = false') Close

  //- ── Packet Capture Dialog ─────────────────────────────────────────
  .auto-ip-overlay(*ngIf='showCaptureDialog', (click)='closeCaptureDialog()')
    .auto-ip-dialog.capture-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Packet Capture
      .auto-ip-subtitle {{ captureActive ? 'Capturing…' : 'Capture complete' }} · {{ captureLines.length }} packet(s)
      .capture-output
        .capture-line(*ngFor='let line of captureLines') {{ line }}
      .auto-ip-actions
        button.clab-prereq-btn.clab-btn-danger(*ngIf='captureActive', type='button', (click)='stopCapture()') Stop Capture
        button.btn-tool(type='button', (click)='closeCaptureDialog()') Close

  //- ── Validation results panel ──────────────────────────────────────
  .auto-ip-overlay(*ngIf='showValidationPanel', (click)='showValidationPanel = false')
    .auto-ip-dialog.validation-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Topology Validation
