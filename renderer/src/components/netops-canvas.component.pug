  .auto-ip-overlay(*ngIf='showVrnetlabBuilder', (click)='closeVrnetlabBuilder()')
    .auto-ip-dialog.vrnetlab-dialog((click)='$event.stopPropagation()')
      .auto-ip-title Build vrnetlab Image
      .auto-ip-subtitle Convert a vendor VM disk image (qcow2/vmdk) into a Docker image for containerlab
      .form-row
        label.form-label Vendor
        select.form-input([(ngModel)]='vrnetlabVendor')
          option(value='') — Select vendor —
